{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvestmentRadarProperty",
  "type": "object",
  "required": ["askingPrice", "livingArea", "renovationBase", "arvBase"],
  "properties": {
    "sourceUrl": {"type": "string"},
    "location": {"type": "string"},
    "askingPrice": {"type": "number", "minimum": 0},
    "livingArea": {"type": "number", "minimum": 1},
    "purchaseTaxRate": {"type": "number", "default": 0.05},
    "notaryLandRegistryRate": {"type": "number", "default": 0.02},
    "brokerRate": {"type": "number", "default": 0.0357},
    "renovationLow": {"type": "number", "minimum": 0},
    "renovationBase": {"type": "number", "minimum": 0},
    "renovationHigh": {"type": "number", "minimum": 0},
    "holdingCosts": {"type": "number", "minimum": 0},
    "financingCosts": {"type": "number", "minimum": 0},
    "saleCostRate": {"type": "number", "default": 0.02},
    "riskReserve": {"type": "number", "minimum": 0},
    "arvConservative": {"type": "number", "minimum": 0},
    "arvBase": {"type": "number", "minimum": 0},
    "arvOptimistic": {"type": "number", "minimum": 0},
    "monthlyColdRent": {"type": "number", "minimum": 0},
    "monthlyNonRecoverableCosts": {"type": "number", "minimum": 0},
    "vacancyRate": {"type": "number", "default": 0.03},
    "maintenanceRate": {"type": "number", "default": 0.08},
    "holidayNightRate": {"type": "number", "minimum": 0},
    "holidayOccupancy": {"type": "number", "minimum": 0, "maximum": 1},
    "holidayVariableCostRate": {"type": "number", "default": 0.25},
    "holidayFixedAnnualCosts": {"type": "number", "minimum": 0},
    "kevinHours": {"type": "number", "minimum": 0},
    "kevinOpportunityRate": {"type": "number", "minimum": 0},
    "kevinMarketValueCreated": {"type": "number", "minimum": 0},
    "fundingBenefit": {"type": "number", "minimum": 0},
    "fundingRestrictionsCost": {"type": "number", "minimum": 0},
    "desiredFlipProfit": {"type": "number", "minimum": 0},
    "redFlags": {"type": "array", "items": {"type": "string"}}
  }
}
