---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-sans-condensed/500.css';
import '@fontsource/ibm-plex-sans-condensed/600.css';
import '@fontsource/ibm-plex-sans-condensed/700.css';
import '../styles/tokens.css';
import '../styles/icons.css';
import '../styles/base.css';
import '../styles/ios-stability.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import settings from '../data/settings.json';
import seo from '../data/seo.json';
import legal from '../data/legal.json';
import release from '../data/release.json';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
}

const PRIMARY_SITE = 'https://www.wunschausbau.de';
const LEGACY_SITE = 'https://wunschausbau.de';
const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isPreview = Astro.site?.hostname === 'hapo3005.github.io';
const releaseReady = legal.launchApproved === true
  && release.serviceCatalogApproved === true
  && release.serviceAreaApproved === true
  && release.projectMediaApproved === true
  && release.smtpDeliveryTestPassed === true;
const shouldNoindex = noindex || isPreview || !releaseReady;

const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
let normalizedPath = Astro.url.pathname;
if (basePath && normalizedPath.startsWith(basePath)) {
  normalizedPath = normalizedPath.slice(basePath.length) || '/';
}
if (!normalizedPath.startsWith('/')) normalizedPath = `/${normalizedPath}`;
if (!normalizedPath.endsWith('/') && !normalizedPath.split('/').at(-1)?.includes('.')) normalizedPath += '/';

const titleOverrides = seo.titleOverrides as Record<string, string>;
const descriptionOverrides = (seo.descriptionOverrides || {}) as Record<string, string>;
const breadcrumbLabels = seo.breadcrumbLabels as Record<string, string>;
const resolvedTitle = titleOverrides[normalizedPath] || title;
const resolvedDescription = descriptionOverrides[normalizedPath] || description;
const sameAs = [settings.instagram, settings.myHammer].filter(Boolean);
const ogImage = new URL(withBase('/og-image.jpg'), Astro.site).href;
const logo = new URL(withBase('/favicon.svg'), Astro.site).href;
const hasBusinessAddress = [legal.strasse, legal.plz, legal.ort, legal.land]
  .every((value) => String(value || '').trim());
const businessAddress = hasBusinessAddress
  ? {
      '@type': 'PostalAddress',
      streetAddress: legal.strasse,
      postalCode: legal.plz,
      addressLocality: legal.ort,
      addressCountry: 'DE'
    }
  : null;

const defaultBusiness: Record<string, unknown> = {
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${PRIMARY_SITE}/#business`,
  name: settings.firma,
  alternateName: settings.marke,
  description: `${settings.claim} aus Wittlich`,
  url: `${PRIMARY_SITE}/`,
  telephone: settings.telefonLink,
  email: settings.email,
  image: ogImage,
  logo,
  areaServed: settings.regionen,
  sameAs,
  ...(businessAddress ? { address: businessAddress } : {})
};

const suppliedSchema = schema ? { ...schema } : null;
if (suppliedSchema && '@context' in suppliedSchema) delete suppliedSchema['@context'];

let businessNode = defaultBusiness;
const pageNodes: Record<string, unknown>[] = [];
if (suppliedSchema) {
  if (suppliedSchema['@type'] === 'HomeAndConstructionBusiness') {
    businessNode = {
      ...defaultBusiness,
      ...suppliedSchema,
      '@id': `${PRIMARY_SITE}/#business`,
      url: `${PRIMARY_SITE}/`,
      sameAs,
      ...(businessAddress ? { address: businessAddress } : {})
    };
  } else {
    pageNodes.push(suppliedSchema);
  }
}

const websiteNode: Record<string, unknown> = {
  '@type': 'WebSite',
  '@id': `${PRIMARY_SITE}/#website`,
  url: `${PRIMARY_SITE}/`,
  name: settings.marke,
  alternateName: settings.firma,
  inLanguage: 'de-DE',
  publisher: { '@id': `${PRIMARY_SITE}/#business` }
};

const segments = normalizedPath.split('/').filter(Boolean);
const breadcrumbNode = segments.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonical.href}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Startseite',
          item: new URL(withBase('/'), Astro.site).href
        },
        ...segments.map((segment, index) => {
          const path = `/${segments.slice(0, index + 1).join('/')}/`;
          const isCurrent = index === segments.length - 1;
          const fallbackLabel = isCurrent ? resolvedTitle.split('|')[0].trim() : segment.replace(/-/g, ' ');
          return {
            '@type': 'ListItem',
            position: index + 2,
            name: breadcrumbLabels[segment] || fallbackLabel,
            item: new URL(withBase(path), Astro.site).href
          };
        })
      ]
    }
  : null;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [websiteNode, businessNode, ...pageNodes, ...(breadcrumbNode ? [breadcrumbNode] : [])]
};
const structuredDataJson = JSON.stringify(structuredData).replaceAll(LEGACY_SITE, PRIMARY_SITE);
---
<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self' mailto:"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    {shouldNoindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#fdfcf9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.marke} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${settings.marke} – ${settings.claim}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <script type="application/ld+json" set:html={structuredDataJson} />
    <script is:inline>
      (() => {
        const ua = navigator.userAgent || '';
        const platform = navigator.platform || '';
        const isIOS = /iPad|iPhone|iPod/i.test(ua)
          || (platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const isWebKit = /WebKit/i.test(ua);
        const isOtherIOSBrowser = /CriOS|FxiOS|EdgiOS|OPiOS/i.test(ua);
        if (isIOS && isWebKit && !isOtherIOSBrowser) {
          document.documentElement.classList.add('ios-safari');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <MobileCta />
    <script>
      // Internal links must always leave embedded preview/sidebar frames. In a normal
      // top-level browser context `_top` is identical to the current page, so this
      // does not change ordinary navigation behaviour.
      document.querySelectorAll('a[href]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement) || link.target === '_blank') return;
        const href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('tel:') || href.startsWith('mailto:') || href.startsWith('javascript:')) return;

        try {
          const targetUrl = new URL(href, window.location.href);
          if (targetUrl.origin === window.location.origin) link.target = '_top';
        } catch {}
      });

      // Scroll-reveal animations used to start from opacity: 0 only after an element
      // had already entered the viewport. That produced a visible hide/show flash.
      // Keep page content stable and visible; motion remains limited to deliberate
      // component interactions instead of being tied to scrolling.
      document.querySelectorAll('.reveal').forEach((target) => {
        target.classList.add('is-visible');
        target.setAttribute('data-reveal-complete', 'true');
        if (target instanceof HTMLElement) {
          target.style.removeProperty('opacity');
          target.style.removeProperty('transform');
          target.style.removeProperty('will-change');
        }
      });

      const projectForm = document.querySelector('form.anfrage');
      const emailInput = projectForm?.querySelector('input[name="email"]');
      const contactInputs = projectForm ? [...projectForm.querySelectorAll('input[name="kontaktweg"]')] : [];
      const syncEmailRequirement = () => {
        if (!(emailInput instanceof HTMLInputElement)) return;
        const selected = contactInputs.find((input) => input instanceof HTMLInputElement && input.checked);
        const emailRequired = selected instanceof HTMLInputElement && selected.value === 'E-Mail';
        emailInput.required = emailRequired;
        if (emailRequired) emailInput.setAttribute('aria-required', 'true');
        else emailInput.removeAttribute('aria-required');
      };
      contactInputs.forEach((input) => input.addEventListener('change', syncEmailRequirement));
      syncEmailRequirement();
    </script>
  </body>
</html>

<style is:global>
  /* A sticky header must not change its geometry after scrolling starts. The old
     5.5rem -> 4.9rem / 3.15rem -> 2.8rem transition shifted the whole page at 20px. */
  @media (min-width: 56.001rem) {
    .site-header.is-scrolled .header-shell {
      min-height: 5.5rem !important;
    }

    .site-header.is-scrolled .brand-mark {
      width: 3.15rem !important;
      height: 3.15rem !important;
    }
  }
</style>