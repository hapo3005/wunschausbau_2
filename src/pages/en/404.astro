---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';
---
<Base lang="en" title="Page not found | wunschausbau.de" description="The requested page does not exist." noindex>
  <section class="section status-page">
    <div class="wrap status-page__inner">
      <p class="eyebrow">Error 404</p>
      <h1>This page does not exist.</h1>
      <p class="lead">The address may be outdated or entered incorrectly. From here you can return directly to the most important sections.</p>
      <div class="status-actions" aria-label="Useful pages">
        <a class="btn" href={withBase('/en/')}>Back to home</a>
        <a class="btn btn--ghost" href={withBase('/en/services/')}>View services</a>
        <a class="btn btn--ghost" href={withBase('/en/contact/')}>Request a project</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .eyebrow { justify-content: center; }

  .status-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-4);
  }

  .status-actions .btn {
    min-width: 12.5rem;
    margin-top: 0;
  }

  @media (max-width: 40rem) {
    .status-actions {
      width: min(100%, 22rem);
    }

    .status-actions .btn {
      width: 100%;
    }
  }
</style>
