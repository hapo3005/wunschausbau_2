---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { withBase } from '../../../lib/paths';
import settings from '../../../data/settings.json';
import { englishServices, type EnglishService } from '../../../data/services.en';

export async function getStaticPaths() {
  const sources = await getCollection('leistungen');
  const sourceById = new Map(sources.map((entry) => [entry.id, entry]));
  return englishServices.map((service) => ({
    params: { slug: service.slug },
    props: { service, source: sourceById.get(service.sourceId) }
  }));
}

const { service, source } = Astro.props as { service: EnglishService; source: Awaited<ReturnType<typeof getCollection<'leistungen'>>>[number] };
if (!source) throw new Error(`Missing German source for English service ${service.slug}`);
const more = englishServices.filter((item) => item.slug !== service.slug);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  description: service.metaDescription,
  areaServed: settings.regionen,
  provider: {
    '@type': 'HomeAndConstructionBusiness',
    '@id': 'https://www.wunschausbau.de/#business',
    name: settings.firma
  }
};
---
<Base
  lang="en"
  title={`${service.title} | wunschausbau.de – Interior Fit-out Wittlich, Trier & Moselle`}
  description={service.metaDescription}
  schema={serviceSchema}
>
  <article>
    <section class="service-head">
      <div class="wrap service-head__grid">
        <div class="service-head__copy">
          <p class="eyebrow"><a href={withBase('/en/services/')} class="crumb">Services</a></p>
          <h1>{service.title}</h1>
          <p class="service-head__lead">{service.short}</p>
          <div class="service-head__actions">
            <a class="btn" href={`${withBase('/en/contact/')}?service=${encodeURIComponent(service.slug)}`}>Request a project</a>
            <a class="btn btn--ghost" href={withBase('/en/services/')}>All services</a>
          </div>
        </div>

        <div class="service-head__media">
          <Image
            src={source.data.bild}
            alt={service.imageAlt}
            widths={[640, 960, 1440]}
            sizes="(max-width: 56rem) 100vw, 55vw"
            quality={82}
            format="webp"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="service-content">
      <div class="wrap service-content__grid">
        <aside class="service-content__aside" aria-label="Service detail">
          <p class="eyebrow">In detail</p>
          <p class="service-content__statement">Carefully planned.<br />Precisely executed.<br />Right for the room.</p>
        </aside>
        <div class="prose">
          <p>{service.intro}</p>
          {service.sections.map((section) => (
            <>
              <h2>{section.title}</h2>
              {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
              {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            </>
          ))}
        </div>
      </div>
    </section>
  </article>

  <section class="more-services" aria-labelledby="more-title">
    <div class="wrap more-services__grid">
      <header>
        <p class="eyebrow">More services</p>
        <h2 id="more-title">The rest needs to fit just as well.</h2>
      </header>
      <ul class="weitere">
        {more.map((item) => (
          <li>
            <a href={withBase(`/en/services/${item.slug}/`)}>
              <span>{item.title}</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand lang="en" />
</Base>

<style>
  .service-head {
    padding-block: clamp(4rem, 7vw, 6.5rem);
    background: var(--paper);
  }

  .service-head__grid {
    display: grid;
    grid-template-columns: minmax(20rem, .78fr) minmax(0, 1.22fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .service-head__copy { max-width: 34rem; }
  .crumb { color: inherit; text-decoration: none; }

  .service-head h1 {
    max-width: 11ch;
    font-size: clamp(3.5rem, 6vw, 5.8rem);
    line-height: .92;
  }

  .service-head__lead {
    max-width: 34rem;
    margin-top: 1.6rem;
    color: var(--ink-soft);
    font-size: clamp(1.03rem, 1.4vw, 1.18rem);
    line-height: 1.7;
  }

  .service-head__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .service-head__actions .btn { margin-top: 0; }

  .service-head__media {
    position: relative;
    min-height: clamp(28rem, 43vw, 40rem);
    overflow: hidden;
    background: var(--sand);
  }

  .service-head__media::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(28,29,31,.08);
    content: '';
    pointer-events: none;
  }

  .service-head__media :global(img) {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  .service-content {
    padding-block: clamp(5rem, 8vw, 7.5rem);
    background: #f4efe7;
    border-block: 1px solid var(--line);
  }

  .service-content__grid {
    display: grid;
    grid-template-columns: minmax(16rem, .55fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .service-content__aside {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .service-content__statement {
    max-width: 13ch;
    margin-top: 1.5rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -.032em;
    line-height: .98;
  }

  .prose { max-width: 51rem; }

  .prose > p:first-child {
    max-width: 47ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    color: var(--ink);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.65;
  }

  .prose h2 {
    margin: clamp(2.8rem, 5vw, 4rem) 0 1.1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(28,29,31,.16);
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1;
  }

  .prose h2:first-of-type { margin-top: 0; }

  .prose p {
    margin-bottom: 1.15rem;
    color: var(--ink-soft);
    line-height: 1.75;
  }

  .prose ul {
    display: grid;
    gap: .7rem;
    margin: 0 0 1.5rem;
    padding: 0;
    color: var(--ink-soft);
    list-style: none;
  }

  .prose li {
    position: relative;
    padding-left: 1.5rem;
    line-height: 1.65;
  }

  .prose li::before {
    position: absolute;
    top: .72em;
    left: 0;
    width: .6rem;
    height: 1px;
    background: var(--brass);
    content: '';
  }

  .more-services {
    padding-block: clamp(5rem, 8vw, 7rem);
    background: var(--paper);
  }

  .more-services__grid {
    display: grid;
    grid-template-columns: minmax(18rem, .7fr) minmax(0, 1.3fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .more-services h2 {
    max-width: 12ch;
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    line-height: .98;
  }

  .weitere {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .weitere a {
    display: flex;
    min-height: 4.7rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: .9rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dur) var(--ease), padding-left var(--dur) var(--ease-move);
  }

  .weitere a > span:last-child {
    color: var(--brass-deep);
    font-family: var(--font-text);
    font-size: .95rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .weitere a:hover { padding-left: .35rem; color: var(--brass-deep); }
  }

  @media (max-width: 56rem) {
    .service-head__grid,
    .service-content__grid,
    .more-services__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .service-head__media { grid-row: 1; min-height: clamp(23rem, 68vw, 34rem); }
    .service-head__copy { grid-row: 2; max-width: 40rem; }
    .service-content__aside { position: static; }
    .service-content__statement { max-width: 16ch; }
  }

  @media (max-width: 36rem) {
    .service-head { padding-block: 0 4.25rem; }
    .service-head__grid { gap: 2rem; }
    .service-head__media {
      width: calc(100% + 2.25rem);
      min-height: 20rem;
      margin-left: -1.125rem;
    }
    .service-head h1 { font-size: clamp(2.8rem, 12vw, 4rem); }
    .service-head__actions { align-items: stretch; width: min(100%, 22rem); }
    .service-head__actions .btn { width: 100%; }
    .service-content,
    .more-services { padding-block: 4.25rem; }
    .service-content__statement { font-size: clamp(2.15rem, 10vw, 3rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .weitere a { transition: none; }
  }
</style>