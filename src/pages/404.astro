---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden | wunschausbau.de" description="Die angeforderte Seite existiert nicht.">
  <section class="section">
    <div class="wrap" style="text-align:center; max-width: 40rem;">
      <p class="eyebrow" style="justify-content:center;">Fehler 404</p>
      <h1>Diese Seite gibt es nicht.</h1>
      <p class="lead">Die Adresse ist veraltet oder wurde falsch eingegeben.</p>
      <a class="btn" href="/" style="margin-top: var(--space-4);">Zur Startseite</a>
    </div>
  </section>
</Base>
