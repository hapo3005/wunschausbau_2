---
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import logoUrl from '../assets/logo.svg?url';
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Seite nicht gefunden | wunschausbau.de" description="Die angeforderte Seite existiert nicht." noindex>
  <script is:inline define:vars={{ basePath }}>
    (() => {
      const current = window.location.pathname;
      const englishPrefix = `${basePath}/en/`;
      const english404 = `${basePath}/en/404/`;
      if (current.startsWith(englishPrefix) && current !== english404) {
        window.location.replace(english404);
      }
    })();
  </script>

  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__mark" aria-hidden="true">404</div>

    <div class="wrap not-found__inner">
      <div class="not-found__copy">
        <p class="eyebrow">Fehler 404</p>
        <h1 id="not-found-title">
          Hier ist etwas
          <strong>aus dem Lot geraten.</strong>
        </h1>
        <p class="lead">
          Die gesuchte Seite wurde verschoben, entfernt oder die Adresse stimmt nicht. Von hier finden Sie schnell zurück zu den wichtigsten Bereichen.
        </p>

        <div class="not-found__actions" aria-label="Weiterführende Seiten">
          <a class="not-found__button" href={withBase('/')}>Zur Startseite</a>
          <a class="not-found__button not-found__button--ghost" href={withBase('/leistungen/')}>Leistungen ansehen</a>
        </div>
      </div>

      <aside class="not-found__visual" aria-label="KS-Innenausbau">
        <div class="logo-stage" aria-hidden="true">
          <span class="logo-stage__glow"></span>
          <span class="logo-stage__orbit"></span>
          <div class="logo-stage__spinner">
            <img class="logo-stage__face logo-stage__face--front" src={logoUrl} width="449" height="452" alt="" />
            <img class="logo-stage__face logo-stage__face--back" src={logoUrl} width="449" height="452" alt="" />
          </div>
          <span class="logo-stage__shadow"></span>
        </div>

        <div class="not-found__identity">
          <span class="not-found__rule" aria-hidden="true"></span>
          <p>{settings.firma}</p>
          <strong>{settings.claim}</strong>
          <span>{settings.region}</span>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .not-found {
    position: relative;
    display: grid;
    min-height: clamp(40rem, 80svh, 52rem);
    align-items: center;
    overflow: hidden;
    color: #f7f4ee;
    background:
      radial-gradient(circle at 78% 48%, rgba(212, 173, 104, .09), transparent 25rem),
      #1b1c1e;
    isolation: isolate;
  }

  .not-found::before {
    position: absolute;
    inset: auto -14rem -24rem auto;
    width: 42rem;
    height: 42rem;
    border: 1px solid rgba(212, 173, 104, .12);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .not-found__mark {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: clamp(-1rem, 2vw, 2rem);
    color: transparent;
    font-family: var(--font-brand);
    font-size: clamp(13rem, 28vw, 30rem);
    font-weight: 700;
    letter-spacing: -.09em;
    line-height: .72;
    opacity: .065;
    transform: translateY(-48%);
    -webkit-text-stroke: 1px rgba(247, 244, 238, .65);
    user-select: none;
    pointer-events: none;
  }

  .not-found__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .72fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .not-found__copy { max-width: 47rem; }

  .not-found .eyebrow {
    width: fit-content;
    margin-bottom: clamp(1.35rem, 2.5vw, 2rem);
    color: #d4ad68;
  }

  .not-found .eyebrow::before { background: #d4ad68; }

  .not-found h1 {
    display: grid;
    max-width: 12ch;
    margin: 0;
    color: #fffdf9;
    font-size: clamp(3.25rem, 6.5vw, 6.3rem);
    font-weight: 520;
    line-height: .91;
    letter-spacing: -.05em;
  }

  .not-found h1 strong {
    display: block;
    color: #fffdf9;
    font-weight: 680;
  }

  .not-found .lead {
    max-width: 38rem;
    margin-top: clamp(1.5rem, 2.7vw, 2rem);
    color: rgba(247, 244, 238, .7);
    font-size: clamp(1rem, 1.35vw, 1.12rem);
    line-height: 1.7;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .not-found__button {
    display: inline-flex;
    min-height: 3.45rem;
    align-items: center;
    justify-content: center;
    padding: .82rem 1.5rem;
    border: 1px solid #f8f5ee;
    color: var(--ink);
    background: #f8f5ee;
    font-size: .92rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease), background-color var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .not-found__button--ghost {
    color: #f7f4ee;
    background: transparent;
    border-color: rgba(247, 244, 238, .42);
  }

  .not-found__visual {
    display: grid;
    justify-items: center;
    gap: clamp(1.6rem, 3vw, 2.5rem);
    min-width: 0;
  }

  .logo-stage {
    position: relative;
    display: grid;
    width: clamp(15rem, 25vw, 21rem);
    aspect-ratio: 1;
    place-items: center;
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .logo-stage__glow {
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 173, 104, .22), rgba(212, 173, 104, 0) 68%);
    filter: blur(14px);
    animation: ks-glow 4.8s ease-in-out infinite alternate;
  }

  .logo-stage__orbit {
    position: absolute;
    inset: 5%;
    border: 1px solid rgba(212, 173, 104, .24);
    border-radius: 50%;
    transform: rotateX(68deg) rotateZ(-11deg);
    animation: ks-orbit 16s linear infinite;
  }

  .logo-stage__orbit::after {
    position: absolute;
    top: 50%;
    left: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d4ad68;
    box-shadow: 0 0 1.2rem rgba(212, 173, 104, .9);
    content: '';
  }

  .logo-stage__spinner {
    position: relative;
    z-index: 2;
    width: 72%;
    aspect-ratio: 1;
    transform-style: preserve-3d;
    animation: ks-spin 8s linear infinite;
    will-change: transform;
  }

  .logo-stage__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    backface-visibility: hidden;
    filter: invert(82%) sepia(34%) saturate(550%) hue-rotate(357deg) brightness(94%) contrast(88%) drop-shadow(0 1.25rem 1.8rem rgba(0,0,0,.36));
  }

  .logo-stage__face--back {
    opacity: .78;
    transform: rotateY(180deg);
  }

  .logo-stage__shadow {
    position: absolute;
    right: 24%;
    bottom: 8%;
    left: 24%;
    height: 1rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, .42);
    filter: blur(8px);
    animation: ks-shadow 4s ease-in-out infinite alternate;
  }

  .not-found__identity {
    display: grid;
    width: min(100%, 20rem);
    gap: .5rem;
  }

  .not-found__rule {
    width: 3.5rem;
    height: 2px;
    margin-bottom: 1rem;
    background: #d4ad68;
  }

  .not-found__identity p {
    margin: 0;
    color: #d4ad68;
    font-size: .68rem;
    font-weight: 720;
    letter-spacing: .08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .not-found__identity strong {
    max-width: 18rem;
    color: #fffdf9;
    font-family: var(--font-brand);
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-weight: 560;
    line-height: 1.16;
    letter-spacing: -.02em;
  }

  .not-found__identity > span:last-child {
    color: rgba(247, 244, 238, .56);
    font-size: .78rem;
    line-height: 1.5;
  }

  @keyframes ks-spin {
    from { transform: translateY(-.25rem) rotateY(-18deg); }
    to { transform: translateY(-.25rem) rotateY(342deg); }
  }

  @keyframes ks-orbit {
    from { transform: rotateX(68deg) rotateZ(-11deg); }
    to { transform: rotateX(68deg) rotateZ(349deg); }
  }

  @keyframes ks-glow {
    from { opacity: .55; transform: scale(.92); }
    to { opacity: .95; transform: scale(1.08); }
  }

  @keyframes ks-shadow {
    from { opacity: .45; transform: scaleX(.82); }
    to { opacity: .7; transform: scaleX(1.08); }
  }

  @media (hover: hover) and (pointer: fine) {
    .not-found__button:hover {
      color: var(--ink);
      background: #fff;
      border-color: #fff;
      transform: translateY(-1px);
    }

    .not-found__button--ghost:hover {
      color: #1b1c1e;
      background: #d4ad68;
      border-color: #d4ad68;
    }

    .logo-stage:hover .logo-stage__spinner { animation-duration: 3.8s; }
  }

  @media (max-width: 56rem) {
    .not-found__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0;
    }

    .not-found__visual {
      position: absolute;
      top: 1.55rem;
      right: -.1rem;
      display: block;
      width: 10.25rem;
      padding: 0;
      border: 0;
      pointer-events: none;
    }

    .logo-stage { width: 10.25rem; }
    .not-found__identity { display: none; }

    .not-found__mark {
      top: auto;
      right: -1rem;
      bottom: 1rem;
      font-size: clamp(12rem, 40vw, 20rem);
      transform: none;
    }
  }

  @media (max-width: 40rem) {
    .not-found {
      min-height: 0;
      align-items: start;
    }
    .not-found__inner { padding-block: 2.55rem 3.5rem; }
    .not-found .eyebrow { margin-bottom: 1.1rem; }
    .not-found h1 { max-width: 9ch; font-size: clamp(2.9rem, 13.2vw, 4.05rem); line-height: .9; }
    .not-found .lead { margin-top: 1.2rem; font-size: .96rem; line-height: 1.6; }
    .not-found__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: .6rem;
      margin-top: 1.6rem;
    }
    .not-found__button {
      width: 100%;
      min-height: 3.05rem;
      padding: .64rem .75rem;
      font-size: .86rem;
    }
    .not-found__visual { top: 1.05rem; right: -.15rem; width: 8.5rem; }
    .logo-stage { width: 8.5rem; }
    .logo-stage__glow { inset: 9%; }
    .logo-stage__orbit { inset: 3%; }
    .not-found__mark { right: -2rem; bottom: .5rem; font-size: 11rem; opacity: .045; }
  }

  @media (max-width: 22rem) {
    .not-found__actions { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-stage__spinner,
    .logo-stage__orbit,
    .logo-stage__glow,
    .logo-stage__shadow { animation: none; }
    .logo-stage__spinner { transform: none; }
    .not-found__button { transition: none; }
  }
</style>
