---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths';
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Seite nicht gefunden | wunschausbau.de" description="Die angeforderte Seite existiert nicht." noindex>
  <script is:inline define:vars={{ basePath }}>
    (() => {
      const current = window.location.pathname;
      const englishPrefix = `${basePath}/en/`;
      const english404 = `${basePath}/en/404/`;
      if (current.startsWith(englishPrefix) && current !== english404) {
        window.location.replace(english404);
      }
    })();
  </script>

  <section class="section status-page">
    <div class="wrap status-page__inner">
      <p class="eyebrow">Fehler 404</p>
      <h1>Diese Seite gibt es nicht.</h1>
      <p class="lead">Die Adresse ist veraltet oder wurde falsch eingegeben. Von hier kommen Sie direkt zurück zu den wichtigsten Bereichen.</p>
      <div class="status-actions" aria-label="Weiterführende Seiten">
        <a class="btn" href={withBase('/')}>Zur Startseite</a>
        <a class="btn btn--ghost" href={withBase('/leistungen/')}>Leistungen ansehen</a>
        <a class="btn btn--ghost" href={withBase('/kontakt/')}>Projekt anfragen</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .eyebrow { justify-content: center; }

  .status-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 1rem;
    margin-top: var(--space-4);
  }

  .status-actions .btn {
    min-width: 12.5rem;
    margin-top: 0;
  }

  @media (max-width: 40rem) {
    .status-actions {
      width: min(100%, 22rem);
    }

    .status-actions .btn {
      width: 100%;
    }
  }
</style>
