---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import hero from '../assets/hero.png';
import interior from '../assets/service-interior.png';
import floors from '../assets/service-floors.png';
import doors from '../assets/service-doors-windows.png';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const process = [
  {
    title: 'Beratung & Aufmaß',
    meta: 'Vor Ort · Wünsche · Bestand · Material',
    text: 'Wir schauen uns die Situation vor Ort an, nehmen sauber Maß und klären, was technisch, gestalterisch und wirtschaftlich wirklich sinnvoll ist.'
  },
  {
    title: 'Planung & Abstimmung',
    meta: 'Details · Auswahl · Ablauf · Termin',
    text: 'Materialien, Anschlüsse, Übergänge und Ablauf werden vor Beginn abgestimmt. So entstehen Entscheidungen nicht erst mitten auf der Baustelle.'
  },
  {
    title: 'Ausführung & Übergabe',
    meta: 'Präzision · Sauberkeit · Kontrolle · Übergabe',
    text: 'Die Arbeiten werden ordentlich und nachvollziehbar umgesetzt. Zum Abschluss prüfen wir gemeinsam das Ergebnis und übergeben sauber.'
  }
];

const benefits = [
  {
    title: 'Ein Ansprechpartner',
    text: 'Von der ersten Idee bis zur Übergabe bleibt die Kommunikation klar und persönlich.'
  },
  {
    title: 'Details vor der Baustelle',
    text: 'Materialien, Übergänge und Anschlüsse werden vorher durchdacht statt später improvisiert.'
  },
  {
    title: 'Saubere Koordination',
    text: 'Einzelne Gewerke und Arbeitsschritte werden sinnvoll aufeinander abgestimmt.'
  },
  {
    title: 'Räume statt Einzelteile',
    text: 'Wir denken nicht nur in Türen, Böden oder Wänden, sondern im stimmigen Gesamtergebnis.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://wunschausbau.de/#business',
  name: settings.firma,
  alternateName: settings.marke,
  url: 'https://wunschausbau.de/',
  telephone: settings.telefonLink,
  email: settings.email,
  image: new URL(withBase('/og-image.jpg'), Astro.site).href,
  logo: new URL(withBase('/favicon.svg'), Astro.site).href,
  areaServed: settings.regionen,
  knowsAbout: leistungen.map((leistung) => leistung.data.title),
  sameAs: [settings.instagram]
};
---
<Base
  title="wunschausbau.de | Innenausbau & Renovierung in Wittlich, Trier und an der Mosel"
  description="Innenausbau und Renovierung in Wittlich, Trier und der Moselregion: Böden, Innentüren, Fenster, Trockenbau, Sonnenschutz und Holzterrassen – präzise umgesetzt."
  schema={schema}
>
  <section class="ks-hero" aria-labelledby="hero-title">
    <div class="ks-hero__media">
      <Image src={hero} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={84} format="webp" />
    </div>

    <div class="wrap ks-hero__inner">
      <div class="ks-hero__copy">
        <p class="eyebrow">{settings.firma}</p>
        <h1 id="hero-title">
          <span>Innenausbau</span>
          <strong>mit Anspruch.</strong>
          <small>Bis ins Detail.</small>
        </h1>
        <p class="ks-hero__lead">
          Von Böden und Türen über Trockenbau bis zur kompletten Renovierung.
          Für Wohnräume, die nicht nur fertig aussehen, sondern wirklich zusammenpassen.
        </p>
        <div class="ks-hero__actions">
          <a class="ks-button" href={withBase('/kontakt/')}>Projekt besprechen</a>
          <a class="ks-textlink" href={withBase('/referenzen/')}>Arbeiten ansehen <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="ks-hero__location">
        <span>Innenausbau & Renovierung</span>
        <strong>{settings.region}</strong>
      </div>
    </div>
  </section>

  <section class="proof-rail" aria-label="Vertrauen und Erfahrung">
    <div class="wrap proof-rail__grid">
      <div><strong>{settings.stats.projekte}</strong><span>realisierte Projekte</span></div>
      <div><strong>{settings.stats.bewertung}</strong><span>Google-Bewertung</span></div>
      <div><strong>{settings.region}</strong><span>regional verwurzelt</span></div>
      <div><strong>{settings.stats.rueckmeldung}</strong><span>Rückmeldung im Regelfall</span></div>
    </div>
  </section>

  <section class="selected-work" aria-labelledby="selected-work-title">
    <div class="wrap">
      <header class="section-intro-grid">
        <div>
          <p class="eyebrow">Ausgewählte Arbeiten</p>
          <h2 id="selected-work-title">Räume zeigen mehr als Versprechen.</h2>
        </div>
        <div class="section-intro-side">
          <p>Material, Licht, Linien und Übergänge müssen am Ende zusammenspielen. Deshalb zeigen wir lieber Ergebnisse als große Worte.</p>
          <a class="ks-textlink ks-textlink--dark" href={withBase('/referenzen/')}>Alle Referenzen <span aria-hidden="true">→</span></a>
        </div>
      </header>

      <div class="work-editorial">
        <a class="work-shot work-shot--main reveal" href={withBase('/referenzen/')}>
          <Image src={interior} alt="Wohnraum mit maßgefertigter Holzvertäfelung und Einbauregal" widths={[720, 1080, 1600]} sizes="(max-width: 56rem) 100vw, 66vw" quality={86} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Innenausbau</small><strong>Raumwirkung im Ganzen</strong></span>
        </a>

        <a class="work-shot work-shot--detail reveal" href={withBase('/referenzen/')} style="--reveal-delay: 55ms">
          <Image src={floors} alt="Hochwertig verlegter Eichenparkettboden" widths={[480, 720, 960]} sizes="(max-width: 56rem) 100vw, 34vw" quality={84} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Böden</small><strong>Material & Präzision</strong></span>
        </a>

        <a class="work-shot work-shot--detail reveal" href={withBase('/referenzen/')} style="--reveal-delay: 90ms">
          <Image src={doors} alt="Moderne Innentür und Fensterfront nach der Montage" widths={[480, 720, 960]} sizes="(max-width: 56rem) 100vw, 34vw" quality={84} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Türen & Fenster</small><strong>Saubere Übergänge</strong></span>
        </a>
      </div>
    </div>
  </section>

  <section class="customer-value" aria-labelledby="customer-value-title">
    <div class="wrap customer-value__inner">
      <header class="customer-value__head">
        <p class="eyebrow">Was Sie davon haben</p>
        <h2 id="customer-value-title">Weniger Reibung.<br />Mehr Sicherheit im Projekt.</h2>
        <p>Guter Innenausbau ist nicht nur das sichtbare Ergebnis. Entscheidend ist auch, wie zuverlässig der Weg dorthin funktioniert.</p>
      </header>

      <div class="benefit-grid">
        {benefits.map((benefit, index) => (
          <article class={`benefit benefit--${index + 1} reveal`} style={`--reveal-delay: ${index * 45}ms`}>
            <span class="benefit__icon" aria-hidden="true"></span>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="capabilities" aria-labelledby="capabilities-title">
    <div class="wrap">
      <header class="section-intro-grid section-intro-grid--compact">
        <div>
          <p class="eyebrow">Leistungen</p>
          <h2 id="capabilities-title">Alles, was ein Raum braucht.</h2>
        </div>
        <p class="section-intro-copy">Einzelne Leistungen dort, wo sie gebraucht werden. Oder als abgestimmte Renovierung aus einer Hand.</p>
      </header>

      <div class="capability-list">
        {leistungen.map((leistung, index) => (
          <a class={`capability capability--${index + 1}`} href={withBase(`/leistungen/${leistung.id}/`)}>
            <span class="capability__icon" aria-hidden="true"></span>
            <span class="capability__copy">
              <strong>{leistung.data.title}</strong>
              <small>{leistung.data.kurztext}</small>
            </span>
            <span class="capability__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="project-flow" aria-labelledby="project-flow-title">
    <div class="wrap project-flow__grid">
      <header class="project-flow__head">
        <p class="eyebrow">So entsteht Ihr Projekt</p>
        <h2 id="project-flow-title">Klar vom ersten Gespräch bis zur Übergabe.</h2>
        <p>Sie wissen, was als Nächstes passiert, welche Entscheidungen anstehen und wie aus einzelnen Arbeitsschritten ein stimmiges Ergebnis wird.</p>
        <a class="ks-textlink ks-textlink--dark" href={withBase('/kontakt/')}>Projekt starten <span aria-hidden="true">→</span></a>
      </header>

      <div class="flow-steps">
        {process.map((step, index) => (
          <article class={`flow-step flow-step--${index + 1} reveal`} style={`--reveal-delay: ${index * 55}ms`}>
            <span class="flow-step__icon" aria-hidden="true"></span>
            <div>
              <p class="flow-step__meta">{step.meta}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />
  <CtaBand title="Aus einer Idee kann ein Raum werden, der wirklich zu Ihnen passt." />
</Base>

<style>
  .ks-hero {
    position: relative;
    display: grid;
    min-height: clamp(40rem, 84svh, 52rem);
    align-items: center;
    overflow: hidden;
    background: #d8d1c7;
  }

  .ks-hero__media,
  .ks-hero__media::after,
  .ks-hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ks-hero__media :global(img) {
    object-fit: cover;
    object-position: 65% center;
    filter: saturate(1) contrast(1.01) brightness(1.055);
    transform: scale(1.015);
  }

  .ks-hero__media::after {
    background: linear-gradient(90deg,
      rgba(253,252,249,.95) 0%,
      rgba(253,252,249,.90) 24%,
      rgba(253,252,249,.68) 40%,
      rgba(253,252,249,.25) 55%,
      rgba(253,252,249,.04) 68%,
      rgba(253,252,249,0) 77%);
    content: '';
  }

  .ks-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 3rem;
    padding-block: clamp(4.5rem, 7vw, 6.5rem);
  }

  .ks-hero__copy { max-width: 50rem; }

  .ks-hero .eyebrow {
    margin-bottom: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--brass-deep);
  }

  .ks-hero h1 {
    display: grid;
    width: fit-content;
    margin: 0;
    font-family: var(--font-brand);
    font-size: clamp(4rem, 6.9vw, 6.9rem);
    font-weight: 500;
    letter-spacing: -.052em;
    line-height: .86;
  }

  .ks-hero h1 span,
  .ks-hero h1 strong { display: block; }

  .ks-hero h1 strong { font-weight: 650; }

  .ks-hero h1 small {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    color: var(--brass-deep);
    font-family: var(--font-text);
    font-size: clamp(.92rem, 1.25vw, 1.08rem);
    font-weight: 600;
    letter-spacing: .01em;
    line-height: 1.2;
  }

  .ks-hero h1 small::after {
    width: clamp(4rem, 9vw, 8rem);
    height: 1px;
    background: rgba(118,80,29,.48);
    content: '';
  }

  .ks-hero__lead {
    max-width: 34rem;
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
    color: #373a3e;
    font-size: clamp(1.02rem, 1.35vw, 1.14rem);
    line-height: 1.7;
  }

  .ks-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    margin-top: clamp(1.8rem, 3vw, 2.4rem);
  }

  .ks-button {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    padding: .8rem 1.55rem;
    color: var(--paper-inverse);
    background: var(--ink);
    border: 1px solid var(--ink);
    font-size: .93rem;
    font-weight: 650;
    text-decoration: none;
  }

  .ks-textlink {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .55rem;
    padding-bottom: .28rem;
    color: var(--ink);
    border-bottom: 1px solid rgba(28,29,31,.45);
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap var(--dur) var(--ease-move), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .ks-textlink--dark { color: var(--ink); }

  .ks-hero__location {
    display: grid;
    justify-items: end;
    gap: .35rem;
    padding-top: .8rem;
    border-top: 1px solid rgba(118,80,29,.38);
    color: rgba(28,29,31,.67);
    font-size: .68rem;
    letter-spacing: .08em;
    line-height: 1.5;
    text-align: right;
    text-transform: uppercase;
  }

  .ks-hero__location strong {
    color: var(--ink);
    font-weight: 650;
  }

  .proof-rail {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .proof-rail__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .proof-rail__grid > div {
    display: grid;
    gap: .38rem;
    padding: 1.35rem clamp(.8rem, 2vw, 1.5rem);
    border-right: 1px solid var(--line);
  }

  .proof-rail__grid > div:first-child { padding-left: 0; }
  .proof-rail__grid > div:last-child { border-right: 0; padding-right: 0; }

  .proof-rail strong {
    font-family: var(--font-brand);
    font-size: clamp(1.18rem, 1.7vw, 1.5rem);
    font-weight: 600;
    line-height: 1.05;
  }

  .proof-rail span {
    color: var(--ink-soft);
    font-size: .76rem;
  }

  .selected-work,
  .capabilities {
    padding-block: clamp(5rem, 8vw, 7.5rem);
    background: var(--paper);
  }

  .section-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .65fr);
    align-items: end;
    gap: clamp(2.5rem, 8vw, 8rem);
    margin-bottom: clamp(2.75rem, 5vw, 4.25rem);
  }

  .section-intro-grid h2,
  .customer-value h2,
  .project-flow h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.45rem, 4.4vw, 4rem);
    font-weight: 600;
    line-height: .99;
    letter-spacing: -.035em;
  }

  .section-intro-side,
  .section-intro-copy {
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .section-intro-side {
    display: grid;
    gap: 1.6rem;
  }

  .work-editorial {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(18rem, .75fr);
    grid-template-rows: repeat(2, minmax(15rem, 1fr));
    gap: clamp(.8rem, 1.5vw, 1.2rem);
    min-height: clamp(38rem, 56vw, 52rem);
  }

  .work-shot {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
    background: var(--sand);
    color: #fff;
    text-decoration: none;
  }

  .work-shot--main { grid-row: 1 / 3; }

  .work-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms var(--ease-move);
  }

  .work-shot--main :global(img) { object-position: center 52%; }
  .work-shot--detail:first-of-type :global(img) { object-position: center 50%; }

  .work-shot::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(18,18,18,.42));
    content: '';
  }

  .work-shot__caption {
    position: absolute;
    z-index: 2;
    right: 1.35rem;
    bottom: 1.25rem;
    left: 1.35rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    text-shadow: 0 1px 12px rgba(0,0,0,.18);
  }

  .work-shot__caption small {
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .work-shot__caption strong {
    font-size: .86rem;
    font-weight: 600;
    text-align: right;
  }

  .customer-value {
    padding-block: clamp(5rem, 8vw, 7.25rem);
    background: #f4efe7;
    border-block: 1px solid var(--line);
  }

  .customer-value__inner {
    display: grid;
    grid-template-columns: minmax(18rem, .72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .customer-value__head {
    align-self: start;
  }

  .customer-value__head > p:last-child {
    max-width: 31rem;
    margin-top: 1.35rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-self: start;
  }

  .benefit {
    min-height: 14rem;
    padding: 1.65rem clamp(1.3rem, 2.5vw, 2rem) 1.7rem 0;
    border-top: 1px solid rgba(28,29,31,.18);
  }

  .benefit:nth-child(even) {
    padding-left: clamp(1.3rem, 2.5vw, 2rem);
    border-left: 1px solid rgba(28,29,31,.12);
  }

  .benefit__icon,
  .capability__icon,
  .flow-step__icon {
    display: block;
    background: var(--brass-deep);
    -webkit-mask: var(--benefit-icon) center / contain no-repeat;
    mask: var(--benefit-icon) center / contain no-repeat;
  }

  .benefit__icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-bottom: 2.4rem;
  }

  .benefit--1 { --benefit-icon: var(--ks-icon-talk); }
  .benefit--2 { --benefit-icon: var(--ks-icon-plan); }
  .benefit--3 { --benefit-icon: var(--ks-icon-build); }
  .benefit--4 { --benefit-icon: var(--ks-icon-renovation); }

  .benefit h3 {
    margin: 0 0 .7rem;
    font-size: clamp(1.35rem, 1.8vw, 1.7rem);
    font-weight: 600;
    letter-spacing: -.025em;
  }

  .benefit p {
    max-width: 31ch;
    color: var(--ink-soft);
    font-size: .9rem;
    line-height: 1.65;
  }

  .section-intro-grid--compact { margin-bottom: clamp(2.25rem, 4vw, 3.5rem); }
  .section-intro-copy { align-self: end; max-width: 32rem; }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(3rem, 8vw, 8rem);
    border-top: 1px solid var(--ink);
  }

  .capability {
    --benefit-icon: var(--ks-icon-renovation);
    display: grid;
    grid-template-columns: 1.3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 7.3rem;
    padding-block: 1.3rem;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .capability--1 { --benefit-icon: var(--ks-icon-floor); }
  .capability--2 { --benefit-icon: var(--ks-icon-door); }
  .capability--3 { --benefit-icon: var(--ks-icon-window); }
  .capability--4 { --benefit-icon: var(--ks-icon-shade); }
  .capability--5 { --benefit-icon: var(--ks-icon-drywall); }
  .capability--6 { --benefit-icon: var(--ks-icon-terrace); }
  .capability--7 { --benefit-icon: var(--ks-icon-renovation); }

  .capability__icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  .capability__copy {
    display: grid;
    gap: .35rem;
  }

  .capability__copy strong {
    font-family: var(--font-brand);
    font-size: clamp(1.2rem, 1.5vw, 1.42rem);
    font-weight: 600;
    letter-spacing: -.022em;
  }

  .capability__copy small {
    max-width: 42ch;
    color: var(--ink-soft);
    font-size: .82rem;
    line-height: 1.55;
  }

  .capability__arrow {
    color: var(--ink-muted);
    font-size: .92rem;
    transition: transform var(--dur) var(--ease-move), color var(--dur) var(--ease);
  }

  .project-flow {
    padding-block: clamp(5rem, 8vw, 7.5rem);
    background: #f4efe7;
    border-block: 1px solid var(--line);
  }

  .project-flow__grid {
    display: grid;
    grid-template-columns: minmax(18rem, .68fr) minmax(0, 1.32fr);
    gap: clamp(3.5rem, 9vw, 9rem);
  }

  .project-flow__head {
    align-self: start;
  }

  .project-flow__head > p:not(.eyebrow) {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .project-flow__head .ks-textlink { margin-top: 1.6rem; }

  .flow-steps {
    border-top: 1px solid var(--ink);
  }

  .flow-step {
    --benefit-icon: var(--ks-icon-talk);
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 1.4rem;
    padding-block: clamp(1.8rem, 3vw, 2.5rem);
    border-bottom: 1px solid rgba(28,29,31,.16);
  }

  .flow-step--2 { --benefit-icon: var(--ks-icon-plan); }
  .flow-step--3 { --benefit-icon: var(--ks-icon-build); }

  .flow-step__icon {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: .25rem;
  }

  .flow-step__meta {
