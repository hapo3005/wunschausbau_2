---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import hero from '../assets/hero.png';
import interior from '../assets/service-interior.png';
import floors from '../assets/service-floors.png';
import doors from '../assets/service-doors-windows.png';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const process = [
  {
    title: 'Beratung & Aufmaß',
    meta: 'Vor Ort · Aufmaß · Wünsche',
    text: 'Wir kommen vorbei, schauen uns den Bestand an, messen aus und besprechen, was Sie sich vorstellen.'
  },
  {
    title: 'Planung & Abstimmung',
    meta: 'Material · Details · Termin',
    text: 'Danach klären wir Material, Details, Reihenfolge und Termin. Was sich vorher entscheiden lässt, wird auch vorher entschieden.'
  },
  {
    title: 'Ausführung & Übergabe',
    meta: 'Ausführung · Kontrolle · Übergabe',
    text: 'Wir führen die Arbeiten sauber aus und gehen das Ergebnis am Ende gemeinsam mit Ihnen durch.'
  }
];

const benefits = [
  {
    title: 'Direkter Ansprechpartner',
    text: 'Sie wissen, mit wem Sie sprechen und wer sich um Ihr Projekt kümmert.'
  },
  {
    title: 'Details vorher klären',
    text: 'Materialien, Maße und Anschlüsse besprechen wir, bevor die Arbeiten beginnen.'
  },
  {
    title: 'Ablauf im Blick',
    text: 'Die einzelnen Arbeiten werden so geplant, dass sie sinnvoll aufeinander folgen.'
  },
  {
    title: 'Alles soll zusammenpassen',
    text: 'Am Ende zählt nicht die einzelne Tür oder der einzelne Boden, sondern der ganze Raum.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://wunschausbau.de/#business',
  name: settings.firma,
  alternateName: settings.marke,
  url: 'https://wunschausbau.de/',
  telephone: settings.telefonLink,
  email: settings.email,
  image: new URL(withBase('/og-image.jpg'), Astro.site).href,
  logo: new URL(withBase('/favicon.svg'), Astro.site).href,
  areaServed: settings.regionen,
  knowsAbout: leistungen.map((leistung) => leistung.data.title)
};
---
<Base
  title="wunschausbau.de | Innenausbau & Renovierung in Wittlich, Trier und an der Mosel"
  description="Innenausbau und Renovierung in Wittlich, Trier und der Moselregion: Böden, Innentüren, Fenster, Trockenbau, Sonnenschutz und Holzterrassen – sauber geplant und ausgeführt."
  schema={schema}
>
  <section class="ks-hero" aria-labelledby="hero-title">
    <div class="ks-hero__media">
      <Image
        src={hero}
        alt="Heller, modern ausgebauter Wohn- und Küchenbereich mit warmen Holzoberflächen"
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
        format="webp"
      />
    </div>

    <div class="wrap ks-hero__inner">
      <div class="ks-hero__copy">
        <p class="eyebrow">{settings.firma}</p>
        <h1 id="hero-title">
          <span>Innenausbau</span>
          <strong>mit Anspruch.</strong>
        </h1>
        <p class="ks-hero__lead">
          Böden, Türen, Trockenbau oder eine komplette Renovierung: Wir kümmern uns darum, dass am Ende alles sauber zusammenpasst.
        </p>
        <div class="ks-hero__actions">
          <a class="ks-button" href={withBase('/kontakt/')}>Projekt besprechen</a>
          <a class="ks-textlink" href={withBase('/referenzen/')}>Arbeiten ansehen <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="proof-rail" aria-label="Vertrauen und Fachidentität">
    <div class="wrap proof-rail__grid">
      <div><strong>5,0 / 5</strong><span>MyHammer · 13 Bewertungen</span></div>
      <div><strong>Bauschreiner</strong><span>handwerkliche Fachidentität</span></div>
      <div><strong>{settings.region}</strong><span>regional im Einsatz</span></div>
      <div><strong>Direkt</strong><span>persönliche Abstimmung</span></div>
    </div>
  </section>

  <section class="selected-work" aria-labelledby="selected-work-title">
    <div class="wrap">
      <header class="section-intro-grid">
        <div>
          <p class="eyebrow">Leistungswelten</p>
          <h2 id="selected-work-title">So kann Innenausbau wirken.</h2>
        </div>
        <div class="section-intro-side">
          <p>Für die Vorschau zeigen wir die gewünschte Bildsprache rund um Räume, Materialien und Details. In der finalen Referenzgalerie erscheinen ausschließlich freigegebene Originalaufnahmen von KS-Innenausbau.</p>
          <a class="ks-textlink ks-textlink--dark" href={withBase('/referenzen/')}>Referenzen ansehen <span aria-hidden="true">→</span></a>
        </div>
      </header>

      <div class="work-editorial">
        <a class="work-shot work-shot--main reveal" href={withBase('/referenzen/')}>
          <Image src={interior} alt="Wohnraum mit maßgefertigter Holzvertäfelung und Einbauregal" widths={[720, 1080, 1600]} sizes="(max-width: 56rem) 100vw, 66vw" quality={84} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Innenausbau</small><strong>Wohnraum</strong></span>
        </a>

        <a class="work-shot work-shot--detail reveal" href={withBase('/referenzen/')} style="--reveal-delay: 55ms">
          <Image src={floors} alt="Hochwertig verlegter Eichenparkettboden" widths={[480, 720, 960]} sizes="(max-width: 56rem) 100vw, 34vw" quality={82} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Böden</small><strong>Eichenparkett</strong></span>
        </a>

        <a class="work-shot work-shot--detail reveal" href={withBase('/referenzen/')} style="--reveal-delay: 90ms">
          <Image src={doors} alt="Moderne Innentür und Fensterfront nach der Montage" widths={[480, 720, 960]} sizes="(max-width: 56rem) 100vw, 34vw" quality={82} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Türen & Fenster</small><strong>Montage</strong></span>
        </a>
      </div>
    </div>
  </section>

  <section class="customer-value" aria-labelledby="customer-value-title">
    <div class="wrap customer-value__inner">
      <header class="customer-value__head">
        <p class="eyebrow">Zusammenarbeit</p>
        <h2 id="customer-value-title">Damit auf der Baustelle alles läuft.</h2>
        <p>Viele Probleme entstehen, weil Details zu spät geklärt werden. Deshalb besprechen wir die wichtigen Punkte vor Beginn und halten den Ablauf übersichtlich.</p>
      </header>

      <div class="benefit-grid">
        {benefits.map((benefit, index) => (
          <article class={`benefit benefit--${index + 1} reveal`} style={`--reveal-delay: ${index * 45}ms`}>
            <span class="benefit__icon" aria-hidden="true"></span>
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="capabilities" aria-labelledby="capabilities-title">
    <div class="wrap">
      <header class="section-intro-grid section-intro-grid--compact">
        <div>
          <p class="eyebrow">Leistungen</p>
          <h2 id="capabilities-title">Unsere Leistungen im Überblick.</h2>
        </div>
        <p class="section-intro-copy">Ob einzelne Arbeiten oder eine komplette Renovierung: Wir besprechen, was gebraucht wird und was zusammen Sinn ergibt.</p>
      </header>

      <div class="capability-list">
        {leistungen.map((leistung, index) => (
          <a class={`capability capability--${index + 1}`} href={withBase(`/leistungen/${leistung.id}/`)}>
            <span class="capability__icon" aria-hidden="true"></span>
            <span class="capability__copy">
              <strong>{leistung.data.title}</strong>
              <small>{leistung.data.kurztext}</small>
            </span>
            <span class="capability__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="project-flow" aria-labelledby="project-flow-title">
    <div class="wrap project-flow__grid">
      <header class="project-flow__head">
        <p class="eyebrow">Ablauf</p>
        <h2 id="project-flow-title">So läuft ein Auftrag bei uns ab.</h2>
        <p>Erst anschauen und messen, dann die Details klären, danach umsetzen. Sie wissen dabei, was als Nächstes passiert.</p>
        <a class="ks-textlink" href={withBase('/kontakt/')}>Projekt besprechen <span aria-hidden="true">→</span></a>
      </header>

      <div class="flow-steps">
        {process.map((step, index) => (
          <article class={`flow-step flow-step--${index + 1} reveal`} style={`--reveal-delay: ${index * 55}ms`}>
            <span class="flow-step__icon" aria-hidden="true"></span>
            <div>
              <p class="flow-step__meta">{step.meta}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />
  <CtaBand title="Sie planen einen Umbau oder eine Renovierung?" />
</Base>

<style>
  .ks-hero {
    position: relative;
    display: grid;
    min-height: clamp(40rem, calc(100svh - 5.5rem), 53rem);
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: #24211e;
    isolation: isolate;
  }

  .ks-hero__media,
  .ks-hero__media::after,
  .ks-hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ks-hero__media { z-index: 0; overflow: hidden; }

  .ks-hero__media :global(img) {
    object-fit: cover;
    object-position: 66% 50%;
    filter: saturate(1) contrast(1.01) brightness(1.08);
    transform: scale(1.006);
  }

  .ks-hero__media::after {
    z-index: 1;
    background:
      linear-gradient(90deg,
        rgba(18,17,16,.36) 0%,
        rgba(18,17,16,.26) 20%,
        rgba(18,17,16,.15) 38%,
        rgba(18,17,16,.06) 54%,
        rgba(18,17,16,.01) 66%,
        rgba(18,17,16,0) 76%),
      linear-gradient(0deg, rgba(15,14,13,.10) 0%, rgba(15,14,13,0) 48%);
    content: '';
  }

  .ks-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(5rem, 8vw, 7rem);
  }

  .ks-hero__copy {
    width: min(100%, 41rem);
    color: #fff;
  }

  .ks-hero .eyebrow {
    margin-bottom: clamp(1.25rem, 2vw, 1.65rem);
    color: #e0bd7a;
    font-size: .69rem;
    letter-spacing: .13em;
  }

  .ks-hero .eyebrow::before { background: rgba(224,189,122,.82); }

  .ks-hero h1 {
    display: grid;
    width: max-content;
    max-width: 100%;
    margin: 0;
    color: #fff;
    font-family: var(--font-brand);
    font-size: clamp(3.8rem, 6.1vw, 6.15rem);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: .9;
    text-shadow: 0 1px 16px rgba(0,0,0,.11);
  }

  .ks-hero h1 span,
  .ks-hero h1 strong {
    display: block;
    white-space: nowrap;
  }

  .ks-hero h1 strong { font-weight: 650; }

  .ks-hero__lead {
    max-width: 32rem;
    margin-top: clamp(1.45rem, 2.3vw, 1.9rem);
    color: rgba(255,255,255,.94);
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    font-weight: 430;
    line-height: 1.7;
    text-shadow: 0 1px 14px rgba(0,0,0,.13);
  }

  .ks-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.2rem, 2vw, 1.7rem);
    margin-top: clamp(1.9rem, 3vw, 2.45rem);
  }

  .ks-button {
    display: inline-flex;
    min-height: 3.45rem;
    align-items: center;
    justify-content: center;
    padding: .82rem 1.5rem;
    color: var(--ink);
    background: #f8f5ee;
    border: 1px solid #f8f5ee;
    font-size: .92rem;
    font-weight: 620;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .ks-textlink {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .55rem;
    padding-bottom: .28rem;
    color: var(--ink);
    border-bottom: 1px solid rgba(28,29,31,.45);
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap var(--dur) var(--ease-move), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .ks-hero .ks-textlink {
    color: rgba(255,255,255,.96);
    border-bottom-color: rgba(255,255,255,.62);
  }

  .proof-rail {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .proof-rail__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .proof-rail__grid > div {
    display: grid;
    min-height: 5.2rem;
    align-content: center;
    gap: .34rem;
    padding: 1rem clamp(1rem, 2vw, 1.5rem);
    border-right: 1px solid var(--line);
  }

  .proof-rail__grid > div:first-child { padding-left: 0; }
  .proof-rail__grid > div:last-child { padding-right: 0; border-right: 0; }

  .proof-rail strong {
    font-family: var(--font-brand);
    font-size: clamp(1.08rem, 1.35vw, 1.28rem);
    font-weight: 600;
    line-height: 1.05;
  }

  .proof-rail span {
    color: var(--ink-muted);
    font-size: .7rem;
    line-height: 1.45;
  }

  .selected-work,
  .capabilities {
    padding-block: clamp(5rem, 8vw, 7.5rem);
    background: var(--paper);
  }

  .section-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .65fr);
    align-items: end;
    gap: clamp(2.5rem, 8vw, 8rem);
    margin-bottom: clamp(2.75rem, 5vw, 4.25rem);
  }

  .section-intro-grid h2,
  .customer-value h2,
  .project-flow h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.45rem, 4.4vw, 4rem);
    font-weight: 600;
    line-height: .99;
    letter-spacing: -.035em;
  }

  .section-intro-side,
  .section-intro-copy {
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .section-intro-side { display: grid; gap: 1.6rem; }

  .work-editorial {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(18rem, .75fr);
    grid-template-rows: repeat(2, minmax(15rem, 1fr));
    gap: clamp(.8rem, 1.5vw, 1.2rem);
    min-height: clamp(38rem, 56vw, 52rem);
  }

  .work-shot {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
    background: var(--sand);
    color: #fff;
    text-decoration: none;
  }

  .work-shot--main { grid-row: 1 / 3; }

  .work-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms var(--ease-move);
  }

  .work-shot--main :global(img) { object-position: center 52%; }
  .work-shot--detail:first-of-type :global(img) { object-position: center 50%; }

  .work-shot::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(18,18,18,.42));
    content: '';
  }

  .work-shot__caption {
    position: absolute;
    z-index: 2;
    right: 1.35rem;
    bottom: 1.25rem;
    left: 1.35rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    text-shadow: 0 1px 12px rgba(0,0,0,.18);
  }

  .work-shot__caption small {
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .work-shot__caption strong {
    font-size: .86rem;
    font-weight: 600;
    text-align: right;
  }

  .customer-value {
    padding-block: clamp(5rem, 8vw, 7.25rem);
    background: #f4efe7;
    border-block: 1px solid var(--line);
  }

  .customer-value__inner {
    display: grid;
    grid-template-columns: minmax(18rem, .72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .customer-value__head { align-self: start; }

  .customer-value__head > p:last-child {
    max-width: 31rem;
    margin-top: 1.35rem;
    color: var(--ink-soft);
    line-height: 1.7;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-self: start;
  }

  .benefit {
    min-height: 14rem;
    padding: 1.65rem clamp(1.3rem, 2.5vw, 2rem) 1.7rem 0;
    border-top: 1px solid rgba(28,29,31,.18);
  }

  .benefit:nth-child(even) {
    padding-left: clamp(1.3rem, 2.5vw, 2rem);
    border-left: 1px solid rgba(28,29,31,.12);
  }

  .benefit__icon,
  .capability__icon,
  .flow-step__icon {
    display: block;
    background: var(--brass-deep);
    -webkit-mask: var(--benefit-icon) center / contain no-repeat;
    mask: var(--benefit-icon) center / contain no-repeat;
  }

  .benefit__icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-bottom: 2.4rem;
  }

  .benefit--1 { --benefit-icon: var(--ks-icon-talk); }
  .benefit--2 { --benefit-icon: var(--ks-icon-plan); }
  .benefit--3 { --benefit-icon: var(--ks-icon-build); }
  .benefit--4 { --benefit-icon: var(--ks-icon-renovation); }

  .benefit h3 {
    margin: 0;
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -.018em;
  }

  .benefit p {
    max-width: 28ch;
    margin-top: .8rem;
    color: var(--ink-soft);
    font-size: .88rem;
    line-height: 1.65;
  }

  .section-intro-grid--compact { align-items: end; }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .capability {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.2rem;
    min-height: 7.75rem;
    padding: 1.3rem clamp(1.25rem, 2.5vw, 2rem) 1.3rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .capability:nth-child(even) {
    padding-left: clamp(1.25rem, 2.5vw, 2rem);
    border-left: 1px solid var(--line);
  }

  .capability__icon {
    width: 1.15rem;
    height: 1.15rem;
    --benefit-icon: var(--ks-icon-renovation);
  }

  .capability--1 .capability__icon { --benefit-icon: var(--ks-icon-floor); }
  .capability--2 .capability__icon { --benefit-icon: var(--ks-icon-door); }
  .capability--3 .capability__icon { --benefit-icon: var(--ks-icon-window); }
  .capability--4 .capability__icon { --benefit-icon: var(--ks-icon-shade); }
  .capability--5 .capability__icon { --benefit-icon: var(--ks-icon-drywall); }
  .capability--6 .capability__icon { --benefit-icon: var(--ks-icon-terrace); }
  .capability--7 .capability__icon { --benefit-icon: var(--ks-icon-renovation); }

  .capability__copy { display: grid; gap: .35rem; }

  .capability__copy strong {
    font-size: clamp(1.04rem, 1.35vw, 1.2rem);
    font-weight: 600;
    letter-spacing: -.012em;
  }

  .capability__copy small {
    max-width: 48ch;
    color: var(--ink-soft);
    font-size: .78rem;
    line-height: 1.55;
  }

  .capability__arrow {
    color: var(--brass-deep);
    font-size: .95rem;
    transition: transform 220ms var(--ease-move);
  }

  .project-flow {
    padding-block: clamp(5rem, 8vw, 7.5rem);
    background: #1c1d1f;
    color: #f7f4ee;
  }

  .project-flow__grid {
    display: grid;
    grid-template-columns: minmax(18rem, .7fr) minmax(0, 1.3fr);
    gap: clamp(3.5rem, 9vw, 9rem);
  }

  .project-flow .eyebrow { color: #d2ab65; }

  .project-flow__head > p:not(.eyebrow) {
    max-width: 31rem;
    margin-top: 1.5rem;
    color: rgba(247,244,238,.72);
    line-height: 1.7;
  }

  .project-flow .ks-textlink {
    margin-top: 1.8rem;
    color: #f7f4ee;
    border-bottom-color: rgba(247,244,238,.48);
  }

  .flow-steps { border-top: 1px solid rgba(247,244,238,.18); }

  .flow-step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-block: clamp(1.65rem, 2.7vw, 2.25rem);
    border-bottom: 1px solid rgba(247,244,238,.14);
  }

  .flow-step__icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: .15rem;
    background: #d2ab65;
  }

  .flow-step--1 .flow-step__icon { --benefit-icon: var(--ks-icon-talk); }
  .flow-step--2 .flow-step__icon { --benefit-icon: var(--ks-icon-plan); }
  .flow-step--3 .flow-step__icon { --benefit-icon: var(--ks-icon-build); }

  .flow-step__meta {
    margin-bottom: .5rem;
    color: rgba(247,244,238,.55);
    font-size: .64rem;
    font-weight: 600;
    letter-spacing: .08em;
