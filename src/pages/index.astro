---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import hero from '../assets/hero.png';
import interior from '../assets/service-interior.png';
import floors from '../assets/service-floors.png';
import doors from '../assets/service-doors-windows.png';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const process = [
  {
    title: 'Verstehen',
    label: 'Beratung & Aufmaß',
    meta: 'Vor Ort · Aufmaß · Wünsche',
    text: 'Wir schauen uns den Bestand an, messen sauber auf und klären, was der Raum am Ende leisten soll.'
  },
  {
    title: 'Planen',
    label: 'Planung & Abstimmung',
    meta: 'Material · Details · Termin',
    text: 'Material, Anschlüsse, Reihenfolge und Termin stehen fest, bevor die eigentliche Ausführung beginnt.'
  },
  {
    title: 'Umsetzen',
    label: 'Ausführung & Übergabe',
    meta: 'Ausführung · Kontrolle · Übergabe',
    text: 'Wir setzen präzise um, kontrollieren die Details und übergeben einen Raum, der als Ganzes funktioniert.'
  }
];

const principles = [
  {
    title: 'Direkt',
    text: 'Ein Ansprechpartner, der Ihr Projekt kennt und Entscheidungen mit Ihnen abstimmt.'
  },
  {
    title: 'Vorher geklärt',
    text: 'Maße, Material und Anschlüsse stehen fest, bevor die eigentliche Arbeit startet.'
  },
  {
    title: 'Im Takt',
    text: 'Die einzelnen Arbeiten greifen sinnvoll ineinander – ohne unnötige Schleifen.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://wunschausbau.de/#business',
  name: settings.firma,
  alternateName: settings.marke,
  url: 'https://wunschausbau.de/',
  telephone: settings.telefonLink,
  email: settings.email,
  image: new URL(withBase('/og-image.jpg'), Astro.site).href,
  logo: new URL(withBase('/favicon.svg'), Astro.site).href,
  areaServed: settings.regionen,
  knowsAbout: leistungen.map((leistung) => leistung.data.title)
};
---
<Base
  title="wunschausbau.de | Innenausbau & Renovierung in Wittlich, Trier und an der Mosel"
  description="Innenausbau und Renovierung in Wittlich, Trier und der Moselregion: Böden, Innentüren, Fenster, Trockenbau, Sonnenschutz und Holzterrassen – sauber geplant und ausgeführt."
  schema={schema}
>
  <section class="ks-hero" aria-labelledby="hero-title">
    <div class="ks-hero__media">
      <Image
        src={hero}
        alt="Heller, modern ausgebauter Wohn- und Küchenbereich mit warmen Holzoberflächen"
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
        format="webp"
      />
    </div>

    <div class="wrap ks-hero__inner">
      <div class="ks-hero__copy">
        <p class="eyebrow">{settings.firma}</p>
        <h1 id="hero-title">
          <span>Innenausbau</span>
          <strong>mit Anspruch.</strong>
        </h1>
        <p class="ks-hero__lead">
          Böden, Türen, Trockenbau oder komplette Renovierung: sauber geplant, präzise umgesetzt und so abgestimmt, dass am Ende alles zusammenpasst.
        </p>
        <div class="ks-hero__actions">
          <a class="ks-button" href={withBase('/kontakt/')}>Projekt besprechen</a>
          <a class="ks-textlink" href={withBase('/referenzen/')}>Arbeiten ansehen <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="proof-rail" aria-label="Vertrauen und Fachidentität">
    <div class="wrap proof-rail__line">
      <p class="proof-rail__lead">Handwerk aus Wittlich. Für Räume, die als Ganzes funktionieren.</p>
      <div class="proof-rail__facts">
        <span><strong>5,0 / 5</strong><small>MyHammer</small></span>
        <span><strong>Bauschreiner</strong><small>Fachidentität</small></span>
        <span><strong>{settings.region}</strong><small>regional im Einsatz</small></span>
        <span><strong>Direkt</strong><small>ein Ansprechpartner</small></span>
      </div>
    </div>
  </section>

  <section class="selected-work" aria-labelledby="selected-work-title">
    <div class="wrap">
      <header class="work-intro reveal">
        <div class="work-intro__title">
          <p class="eyebrow">Raum & Material</p>
          <h2 id="selected-work-title">Material wird Raum.</h2>
        </div>
        <div class="work-intro__side">
          <p>Die Motive definieren aktuell unsere Bildsprache. Zum Launch ersetzen wir sie durch freigegebene Originalprojekte von KS-Innenausbau.</p>
          <a class="ks-textlink ks-textlink--dark" href={withBase('/referenzen/')}>Referenzen ansehen <span aria-hidden="true">→</span></a>
        </div>
      </header>

      <div class="work-stage">
        <a class="work-shot work-shot--main reveal" href={withBase('/referenzen/')}>
          <Image src={interior} alt="Wohnraum mit maßgefertigter Holzvertäfelung und Einbauregal" widths={[720, 1080, 1600]} sizes="(max-width: 56rem) 100vw, 68vw" quality={84} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Innenausbau</small><strong>Wohnraum</strong></span>
        </a>

        <a class="work-shot work-shot--top reveal" href={withBase('/referenzen/')} style="--reveal-delay: 55ms">
          <Image src={floors} alt="Hochwertig verlegter Eichenparkettboden" widths={[480, 720, 960]} sizes="(max-width: 56rem) 50vw, 31vw" quality={82} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Böden</small><strong>Eichenparkett</strong></span>
        </a>

        <a class="work-shot work-shot--overlap reveal" href={withBase('/referenzen/')} style="--reveal-delay: 90ms">
          <Image src={doors} alt="Moderne Innentür und Fensterfront nach der Montage" widths={[480, 720, 960]} sizes="(max-width: 56rem) 50vw, 34vw" quality={82} format="webp" loading="lazy" />
          <span class="work-shot__caption"><small>Türen & Fenster</small><strong>Montage</strong></span>
        </a>
      </div>

      <div class="work-note reveal" style="--reveal-delay: 110ms">
        <span>Ein Raum ist kein Sammelsurium einzelner Leistungen.</span>
        <strong>Proportion, Material und Ausführung müssen miteinander sprechen.</strong>
      </div>
    </div>
  </section>

  <section class="customer-value" aria-labelledby="customer-value-title">
    <div class="wrap customer-value__inner">
      <header class="value-manifest reveal">
        <p class="eyebrow">Zusammenarbeit</p>
        <h2 id="customer-value-title">Bevor gebaut wird, muss alles klar sein.</h2>
        <p>Gute Ausführung beginnt nicht mit Werkzeug, sondern mit Entscheidungen. Deshalb klären wir die wichtigen Dinge, bevor auf der Baustelle Tempo entsteht.</p>
      </header>

      <div class="value-system">
        <div class="value-rail" aria-label="Was gute Zusammenarbeit ausmacht">
          {principles.map((principle, index) => (
            <article class={`principle principle--${index + 1} reveal`} style={`--reveal-delay: ${index * 50}ms`}>
              <span class="principle__icon" aria-hidden="true"></span>
              <div>
                <h3>{principle.title}</h3>
                <p>{principle.text}</p>
              </div>
            </article>
          ))}
        </div>

        <div class="value-conclusion reveal" style="--reveal-delay: 120ms">
          <span>Der Maßstab</span>
          <strong>Am Ende zählt nicht die einzelne Tür, der Boden oder die Wand.</strong>
          <p>Entscheidend ist, ob der ganze Raum selbstverständlich zusammenpasst.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="capabilities" aria-labelledby="capabilities-title">
    <div class="wrap capability-layout">
      <header class="capability-intro reveal">
        <p class="eyebrow">Leistungen</p>
        <h2 id="capabilities-title">Alles, was ein Raum braucht.</h2>
        <p>Einzelne Arbeiten oder komplette Renovierung: Wir denken nicht in isolierten Gewerken, sondern in einem stimmigen Ergebnis.</p>
        <a class="ks-textlink ks-textlink--dark" href={withBase('/leistungen/')}>Alle Leistungen ansehen <span aria-hidden="true">→</span></a>
      </header>

      <div class="service-index">
        {leistungen.map((leistung) => (
          <a class="service-row" href={withBase(`/leistungen/${leistung.id}/`)}>
            <span class="service-row__title">{leistung.data.title}</span>
            <span class="service-row__text">{leistung.data.kurztext}</span>
            <span class="service-row__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="project-flow" aria-labelledby="project-flow-title">
    <div class="wrap">
      <header class="flow-head reveal">
        <div>
          <p class="eyebrow">Ablauf</p>
          <h2 id="project-flow-title">Verstehen. Planen. Umsetzen.</h2>
        </div>
        <div class="flow-head__side">
          <p>Ein guter Ablauf fühlt sich nicht kompliziert an. Sie wissen, was passiert, was entschieden ist und was als Nächstes kommt.</p>
          <a class="ks-textlink" href={withBase('/kontakt/')}>Projekt besprechen <span aria-hidden="true">→</span></a>
        </div>
      </header>

      <div class="flow-path">
        {process.map((step, index) => (
          <article class={`flow-step flow-step--${index + 1} reveal`} style={`--reveal-delay: ${index * 65}ms`}>
            <span class="flow-step__marker" aria-hidden="true"></span>
            <p class="flow-step__meta">{step.meta}</p>
            <h3>{step.title}</h3>
            <strong>{step.label}</strong>
            <p class="flow-step__text">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />
  <CtaBand title="Sie planen einen Umbau oder eine Renovierung?" />
</Base>

<style>
  .ks-hero {
    position: relative;
    display: grid;
    min-height: clamp(40rem, calc(100svh - 5.5rem), 53rem);
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: #24211e;
    isolation: isolate;
  }

  .ks-hero__media,
  .ks-hero__media::after,
  .ks-hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ks-hero__media { z-index: 0; overflow: hidden; }

  .ks-hero__media :global(img) {
    object-fit: cover;
    object-position: 66% 50%;
    filter: saturate(1) contrast(1.01) brightness(1.08);
    transform: scale(1.006);
  }

  .ks-hero__media::after {
    z-index: 1;
    background:
      linear-gradient(90deg,
        rgba(18,17,16,.36) 0%,
        rgba(18,17,16,.26) 20%,
        rgba(18,17,16,.15) 38%,
        rgba(18,17,16,.06) 54%,
        rgba(18,17,16,.01) 66%,
        rgba(18,17,16,0) 76%),
      linear-gradient(0deg, rgba(15,14,13,.10) 0%, rgba(15,14,13,0) 48%);
    content: '';
  }

  .ks-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: clamp(5rem, 8vw, 7rem);
  }

  .ks-hero__copy { width: min(100%, 41rem); color: #fff; }

  .ks-hero .eyebrow {
    margin-bottom: clamp(1.25rem, 2vw, 1.65rem);
    color: #e0bd7a;
    font-size: .69rem;
    letter-spacing: .13em;
  }

  .ks-hero .eyebrow::before { background: rgba(224,189,122,.82); }

  .ks-hero h1 {
    display: grid;
    width: max-content;
    max-width: 100%;
    margin: 0;
    color: #fff;
    font-family: var(--font-brand);
    font-size: clamp(3.8rem, 6.1vw, 6.15rem);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: .9;
    text-shadow: 0 1px 16px rgba(0,0,0,.11);
  }

  .ks-hero h1 span,
  .ks-hero h1 strong { display: block; white-space: nowrap; }
  .ks-hero h1 strong { font-weight: 650; }

  .ks-hero__lead {
    max-width: 32rem;
    margin-top: clamp(1.45rem, 2.3vw, 1.9rem);
    color: rgba(255,255,255,.94);
    font-size: clamp(1rem, 1.15vw, 1.08rem);
    font-weight: 430;
    line-height: 1.7;
    text-shadow: 0 1px 14px rgba(0,0,0,.13);
  }

  .ks-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.2rem, 2vw, 1.7rem);
    margin-top: clamp(1.9rem, 3vw, 2.45rem);
  }

  .ks-button {
    display: inline-flex;
    min-height: 3.45rem;
    align-items: center;
    justify-content: center;
    padding: .82rem 1.5rem;
    color: var(--ink);
    background: #f8f5ee;
    border: 1px solid #f8f5ee;
    font-size: .92rem;
    font-weight: 620;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .ks-textlink {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .55rem;
    padding-bottom: .28rem;
    color: var(--ink);
    border-bottom: 1px solid rgba(28,29,31,.45);
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap var(--dur) var(--ease-move), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .ks-hero .ks-textlink { color: rgba(255,255,255,.96); border-bottom-color: rgba(255,255,255,.62); }

  .proof-rail {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .proof-rail__line {
    display: flex;
    min-width: 0;
    min-height: 5.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .proof-rail__lead {
    min-width: 0;
    max-width: 26rem;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-brand);
    font-size: .95rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .proof-rail__facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-width: 0;
    flex: 1;
  }

  .proof-rail__facts > span {
    display: grid;
    min-width: 0;
    gap: .22rem;
    padding-inline: clamp(1rem, 2vw, 1.7rem);
    border-left: 1px solid var(--line);
  }

  .proof-rail__facts > span:last-child { padding-right: 0; }

  .proof-rail__facts strong {
    min-width: 0;
    color: var(--ink);
    font-size: .82rem;
    font-weight: 650;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .proof-rail__facts small {
    min-width: 0;
    color: var(--ink-muted);
    font-size: .64rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .selected-work,
  .capabilities {
    padding-block: clamp(5.5rem, 8vw, 8rem);
    background: var(--paper);
  }

  .work-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, .62fr);
    align-items: end;
    gap: clamp(2.5rem, 8vw, 8rem);
    margin-bottom: clamp(3rem, 5vw, 4.7rem);
  }

  .work-intro > *,
  .work-note > *,
  .customer-value__inner > *,
  .value-conclusion > *,
  .capability-layout > *,
  .service-row > *,
  .flow-head > *,
  .flow-path > * { min-width: 0; }

  .work-intro h2,
  .value-manifest h2,
  .capability-intro h2,
  .flow-head h2 {
    max-width: 14ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-brand);
    font-size: clamp(2.7rem, 4.8vw, 4.35rem);
    font-weight: 600;
    line-height: .94;
    letter-spacing: -.04em;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .work-intro__side {
    display: grid;
    min-width: 0;
    gap: 1.5rem;
  }

  .work-intro__side p,
  .capability-intro > p:last-of-type {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.72;
    overflow-wrap: anywhere;
  }

  .work-stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: minmax(18rem, 30vw) minmax(14rem, 22vw);
    gap: clamp(.8rem, 1.35vw, 1.15rem);
  }

  .work-shot {
    position: relative;
    display: block;
    min-height: 0;
    overflow: hidden;
    background: var(--sand);
    color: #fff;
    text-decoration: none;
  }

  .work-shot--main { grid-column: 1 / 9; grid-row: 1 / 3; }
  .work-shot--top { grid-column: 9 / 13; grid-row: 1; }
  .work-shot--overlap {
    z-index: 2;
    grid-column: 8 / 13;
    grid-row: 2;
    margin: 1.4rem 0 0 1.4rem;
    border: .7rem solid var(--paper);
  }

  .work-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms var(--ease-move);
  }

  .work-shot--main :global(img) { object-position: center 52%; }
  .work-shot--top :global(img) { object-position: center 48%; }

  .work-shot::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 54%, rgba(18,18,18,.48));
    content: '';
  }

  .work-shot__caption {
    position: absolute;
    z-index: 2;
    right: 1.3rem;
    bottom: 1.2rem;
    left: 1.3rem;
    display: flex;
    min-width: 0;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    text-shadow: 0 1px 12px rgba(0,0,0,.18);
  }

  .work-shot__caption small {
    font-size: .65rem;
    font-weight: 650;
    letter-spacing: .11em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .work-shot__caption strong { min-width: 0; font-size: .88rem; font-weight: 600; text-align: right; overflow-wrap: anywhere; }

  .work-note {
    display: grid;
    grid-template-columns: minmax(0, .55fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: clamp(2rem, 3.5vw, 3rem);
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
  }

  .work-note span {
    max-width: 21rem;
    color: var(--ink-muted);
    font-size: .74rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .work-note strong {
    max-width: 34ch;
    color: var(--ink);
    font-family: var(--font-brand);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 550;
    line-height: 1.3;
    letter-spacing: -.018em;
    overflow-wrap: anywhere;
  }

  .customer-value {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5.5rem, 8vw, 8rem);
    color: #f5f1e9;
    background: #1b1c1e;
  }

  .customer-value::after {
    position: absolute;
    top: -18rem;
    right: -12rem;
    width: 38rem;
    height: 38rem;
    border: 1px solid rgba(209,168,95,.12);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .customer-value__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr);
    gap: clamp(3.5rem, 8vw, 8rem);
  }

  .value-manifest { min-width: 0; align-self: start; }
  .customer-value .eyebrow { color: #d4ad68; }
  .value-manifest h2 { color: #fffdf9; max-width: 11ch; }

  .value-manifest > p:last-child {
    max-width: 29rem;
    margin-top: 1.5rem;
    color: rgba(245,241,233,.68);
    line-height: 1.72;
    overflow-wrap: anywhere;
  }

  .value-system { display: grid; min-width: 0; }

  .value-rail { min-width: 0; border-top: 1px solid rgba(245,241,233,.18); }

  .principle {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    min-width: 0;
    gap: clamp(1.3rem, 3vw, 2.3rem);
    padding-block: clamp(1.65rem, 2.8vw, 2.25rem);
    border-bottom: 1px solid rgba(245,241,233,.14);
  }

  .principle > div { min-width: 0; }

  .principle__icon {
    display: block;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: .15rem;
    background: #d4ad68;
    -webkit-mask: var(--principle-icon) center / contain no-repeat;
    mask: var(--principle-icon) center / contain no-repeat;
  }

  .principle--1 { --principle-icon: var(--ks-icon-talk); }
  .principle--2 { --principle-icon: var(--ks-icon-plan); }
  .principle--3 { --principle-icon: var(--ks-icon-build); }

  .principle h3 {
    margin: 0;
    color: #fffdf9;
    font-family: var(--font-brand);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 600;
    letter-spacing: -.02em;
    overflow-wrap: anywhere;
  }

  .principle p {
    max-width: 46rem;
    margin-top: .55rem;
    color: rgba(245,241,233,.65);
    font-size: .86rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .value-conclusion {
    display: grid;
    grid-template-columns: minmax(0, .32fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    padding-top: clamp(2.4rem, 4vw, 3.5rem);
  }

  .value-conclusion > span {
    grid-row: 1 / 3;
    color: #d4ad68;
    font-size: .67rem;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .value-conclusion strong {
    max-width: 29ch;
    color: #fffdf9;
