---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import hero from '../assets/hero.png';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://wunschausbau.de/#business',
  name: settings.firma,
  alternateName: settings.marke,
  url: 'https://wunschausbau.de/',
  telephone: settings.telefonLink,
  email: settings.email,
  image: new URL(withBase('/og-image.jpg'), Astro.site).href,
  logo: new URL(withBase('/favicon.svg'), Astro.site).href,
  areaServed: settings.regionen,
  knowsAbout: leistungen.map((leistung) => leistung.data.title),
  sameAs: [settings.instagram]
};
---
<Base
  title="wunschausbau.de | Innenausbau & Renovierung in Wittlich, Trier und an der Mosel"
  description="Innenausbau und Renovierung in Wittlich, Trier und der Moselregion: Böden, Innentüren, Fenster, Trockenbau, Sonnenschutz und Holzterrassen – präzise umgesetzt."
  schema={schema}
>
  <section class="hero">
    <div class="hero-media">
      <Image src={hero} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={76} format="webp" />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-panel">
        <p class="eyebrow">{settings.firma}</p>
        <h1>Innenausbau mit Anspruch – bis ins Detail.</h1>
        <p class="lead">
          Von Böden und Türen über Trockenbau bis zur kompletten Renovierung.
          Wir schaffen Wohnräume, die Qualität sichtbar und spürbar machen.
        </p>
        <div class="hero-actions">
          <a class="btn" href={withBase('/kontakt/')}>Kostenlose Beratung</a>
          <a class="btn btn--ghost" href={withBase('/referenzen/')}>Arbeiten ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="Kennzahlen">
    <div class="wrap stats-grid">
      <div><strong>{settings.stats.projekte}</strong><span>realisierte Projekte</span></div>
      <div><strong>{settings.stats.bewertung}</strong><span>Google-Bewertung</span></div>
      <div><strong>{settings.region}</strong><span>regional verwurzelt</span></div>
      <div><strong>{settings.stats.rueckmeldung}</strong><span>Rückmeldung im Regelfall</span></div>
    </div>
  </section>

  <section class="quote section--sand">
    <p class="wrap">Qualität beginnt dort, wo man keine Kompromisse macht.</p>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Unsere Leistungen</p>
      <h2>Alles aus einer Hand.</h2>
      <div class="service-grid">
        {leistungen.map((leistung, index) => (
          <a class="service-card tile reveal" style={`--reveal-delay: ${(index % 3) * 55}ms`} href={withBase(`/leistungen/${leistung.id}/`)}>
            <div class="service-media">
              <Image src={leistung.data.bild} alt={leistung.data.bildAlt} widths={[480, 800]} sizes="(max-width: 56rem) 100vw, 33vw" quality={72} format="webp" />
            </div>
            <div class="service-body">
              <h3>{leistung.data.title}</h3>
              <p>{leistung.data.kurztext}</p>
              <span class="more">Mehr erfahren <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="ablauf-titel">
    <div class="wrap">
      <p class="eyebrow">So arbeiten wir</p>
      <h2 id="ablauf-titel">Ein klarer Ablauf. Ein gutes Gefühl.</h2>
      <p class="lead">Vom ersten Gespräch bis zur sauberen Übergabe behalten Sie jederzeit den Überblick.</p>
      <div class="process-wrap"><ProcessSteps /></div>
    </div>
  </section>

  <Testimonials />
  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(36rem, calc(100svh - var(--header-height)), 48rem);
    align-items: center;
    overflow: hidden;
    background: var(--ink);
  }
  .hero-media, .hero-media::after, .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-media :global(img) { object-fit: cover; object-position: center; }
  .hero-media::after {
    background: linear-gradient(90deg, rgba(23,24,27,.18), transparent 58%);
    content: "";
  }
  .hero-inner { position: relative; width: 100%; padding-block: clamp(3.5rem, 8vw, 6rem); }
  .hero-panel {
    max-width: 36rem;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    border-top: 3px solid var(--brass);
    background: rgba(255, 255, 255, .94);
    box-shadow: var(--shadow-float);
    backdrop-filter: blur(8px);
  }
  .hero-panel h1 { max-width: 13ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: var(--space-4); }

  .stats { border-bottom: 1px solid var(--line); background: var(--paper); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); padding-inline: var(--pad-inline); }
  .stats-grid div {
    display: grid;
    min-width: 0;
    gap: .25rem;
    padding: var(--space-3) var(--space-2);
    border-right: 1px solid var(--line);
    text-align: center;
  }
  .stats-grid div:first-child { border-left: 1px solid var(--line); }
  .stats-grid strong { font-family: var(--font-display); font-size: 1.45rem; line-height: 1.25; }
  .stats-grid span { color: var(--ink-soft); font-size: var(--text-sm); }

  .quote p {
    max-width: 44ch;
    padding-block: var(--space-6);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 2.1rem);
    line-height: 1.35;
    text-align: center;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .service-card {
    display: grid;
    min-width: 0;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease-move);
  }
  .service-media { overflow: hidden; }
  .service-card :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 280ms var(--ease-move);
  }
  .service-body {
    display: grid;
    padding: var(--space-3);
    align-content: start;
    gap: var(--space-1);
  }
  .service-body p { color: var(--ink-soft); font-size: var(--text-sm); }
  .more {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-top: var(--space-1);
    color: var(--brass-deep);
    font-size: var(--text-sm);
    font-weight: 650;
  }
  .process-wrap { margin-top: var(--space-6); }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover { border-color: var(--brass); color: var(--ink); transform: translateY(-2px); }
    .service-card:hover :global(img) { transform: scale(1.025); }
  }

  @media (max-width: 56rem) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .stats-grid div { border-bottom: 1px solid var(--line); }
    .stats-grid div:nth-child(odd) { border-left: 1px solid var(--line); }
    .service-grid { grid-template-columns: 1fr; }
    .service-card { grid-template-columns: minmax(9rem, 38%) minmax(0, 1fr); grid-template-rows: 1fr; }
    .service-card :global(img) { height: 100%; aspect-ratio: auto; }
    .hero-panel { max-width: 38rem; }
  }

  @media (max-width: 36rem) {
    .hero { min-height: calc(100svh - var(--header-height) - var(--mobile-cta-h)); align-items: end; }
    .hero-inner { padding-block: 2.5rem; }
    .hero-panel { padding: 1.5rem; }
    .hero-actions { display: grid; grid-template-columns: 1fr; }
    .hero-actions .btn { width: 100%; }
    .stats-grid span { font-size: .8rem; line-height: 1.4; }
    .service-card { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .service-card :global(img) { aspect-ratio: 3 / 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card, .service-card :global(img) { transition: none; }
  }
</style>
