---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import hero from '../assets/hero.png';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://wunschausbau.de/#business',
  name: settings.firma,
  alternateName: settings.marke,
  url: 'https://wunschausbau.de/',
  telephone: settings.telefonLink,
  email: settings.email,
  image: new URL(withBase('/og-image.jpg'), Astro.site).href,
  logo: new URL(withBase('/favicon.svg'), Astro.site).href,
  areaServed: settings.regionen,
  knowsAbout: leistungen.map((leistung) => leistung.data.title),
  sameAs: [settings.instagram]
};
---
<Base
  title="wunschausbau.de | Innenausbau & Renovierung in Wittlich, Trier und an der Mosel"
  description="Innenausbau und Renovierung in Wittlich, Trier und der Moselregion: Böden, Innentüren, Fenster, Trockenbau, Sonnenschutz und Holzterrassen – präzise umgesetzt."
  schema={schema}
>
  <section class="hero">
    <div class="hero-media">
      <Image src={hero} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" quality={80} format="webp" />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{settings.firma}</p>
        <h1 class="hero-title">
          <span class="hero-title-line">Innenausbau</span>
          <span class="hero-title-line hero-title-line--offset">mit Anspruch.</span>
          <span class="hero-title-detail">Bis ins Detail.</span>
        </h1>
        <p class="lead">
          Von Böden und Türen über Trockenbau bis zur kompletten Renovierung.
          Wir schaffen Wohnräume, die Qualität sichtbar und spürbar machen.
        </p>
        <div class="hero-actions">
          <a class="btn hero-primary" href={withBase('/kontakt/')}>Kostenlose Beratung</a>
          <a class="btn hero-secondary" href={withBase('/referenzen/')}>Arbeiten ansehen <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <p class="hero-note">Innenausbau · Renovierung<br />Wittlich & Moselregion</p>
    </div>
  </section>

  <section class="stats" aria-label="Kennzahlen">
    <div class="wrap">
      <div class="stats-grid">
        <div><strong>{settings.stats.projekte}</strong><span>realisierte Projekte</span></div>
        <div><strong>{settings.stats.bewertung}</strong><span>Google-Bewertung</span></div>
        <div><strong>{settings.region}</strong><span>regional verwurzelt</span></div>
        <div><strong>{settings.stats.rueckmeldung}</strong><span>Rückmeldung im Regelfall</span></div>
      </div>
    </div>
  </section>

  <section class="statement section--sand">
    <div class="wrap statement-grid">
      <p class="statement-kicker">Handwerk ist für uns kein Detail.</p>
      <p class="statement-copy">Qualität beginnt dort, wo man keine Kompromisse macht.</p>
    </div>
  </section>

  <section class="section services-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Unsere Leistungen</p>
          <h2>Alles aus einer Hand.</h2>
        </div>
        <p class="section-intro">
          Saubere Planung, präzise Ausführung und ein Ergebnis, das sich in den Raum einfügt – vom einzelnen Bauteil bis zur kompletten Renovierung.
        </p>
      </div>

      <div class="service-grid">
        {leistungen.map((leistung, index) => (
          <a
            class={`service-card service-card--${index + 1} reveal`}
            style={`--reveal-delay: ${(index % 3) * 55}ms`}
            href={withBase(`/leistungen/${leistung.id}/`)}
          >
            <div class="service-media">
              <Image src={leistung.data.bild} alt={leistung.data.bildAlt} widths={[480, 800, 1200]} sizes="(max-width: 56rem) 100vw, 60vw" quality={76} format="webp" />
            </div>
            <div class="service-body">
              <div>
                <h3>{leistung.data.title}</h3>
                <p>{leistung.data.kurztext}</p>
              </div>
              <span class="more">Mehr erfahren <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand process-section" aria-labelledby="ablauf-titel">
    <div class="wrap process-heading">
      <div>
        <p class="eyebrow">So arbeiten wir</p>
        <h2 id="ablauf-titel">Ein klarer Ablauf.<br />Ein gutes Gefühl.</h2>
      </div>
      <p class="lead">Vom ersten Gespräch bis zur sauberen Übergabe behalten Sie jederzeit den Überblick.</p>
    </div>
    <div class="wrap process-wrap"><ProcessSteps /></div>
  </section>

  <Testimonials />
  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: clamp(42rem, calc(100svh - var(--header-height)), 57rem);
    align-items: end;
    overflow: hidden;
    color: var(--paper-inverse);
    background: var(--ink);
  }

  .hero::after {
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(255,255,255,.08);
    content: "";
    pointer-events: none;
  }

  .hero-media,
  .hero-media::before,
  .hero-media::after,
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-media :global(img) {
    object-fit: cover;
    object-position: center;
    filter: saturate(.9) contrast(1.045);
    transform: scale(1.015);
  }

  .hero-media::before {
    z-index: 1;
    background: radial-gradient(circle at 72% 34%, rgba(255,255,255,.075), transparent 38%);
    content: "";
  }

  .hero-media::after {
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(13,14,16,.9) 0%, rgba(13,14,16,.64) 34%, rgba(13,14,16,.2) 64%, rgba(13,14,16,.04) 100%),
      linear-gradient(0deg, rgba(13,14,16,.76) 0%, rgba(13,14,16,.18) 44%, rgba(13,14,16,.05) 100%);
    content: "";
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-4);
    padding-block: clamp(5rem, 10vw, 8rem) clamp(6rem, 10vw, 8.5rem);
  }

  .hero-copy { max-width: 64rem; }
  .hero .eyebrow {
    margin-bottom: clamp(1.25rem, 2.4vw, 1.9rem);
    color: #e1bb72;
    font-size: .78rem;
    font-weight: 620;
    letter-spacing: .115em;
  }
  .hero .eyebrow::before { background: #e1bb72; }

  .hero h1 {
    display: grid;
    width: fit-content;
    max-width: none;
    font-family: var(--font-brand);
    font-size: clamp(4rem, 8.5vw, 7.75rem);
    font-weight: 560;
    font-variation-settings: "opsz" 88, "wdth" 91, "wght" 560;
    letter-spacing: -.057em;
    line-height: .82;
    text-wrap: nowrap;
  }

  .hero-title-line { display: block; }

  .hero-title-line--offset {
    margin-left: clamp(1rem, 4.4vw, 4.4rem);
  }

  .hero-title-detail {
    display: block;
    margin-top: clamp(1rem, 2vw, 1.45rem);
    margin-left: clamp(1.2rem, 8vw, 8rem);
    color: #e1bb72;
    font-size: .31em;
    font-weight: 470;
    font-variation-settings: "opsz" 48, "wdth" 96, "wght" 470;
    letter-spacing: -.015em;
    line-height: 1;
  }

  .hero .lead {
    max-width: 36rem;
    margin-top: clamp(1.6rem, 3vw, 2.25rem);
    color: rgba(255,255,255,.78);
    font-size: clamp(1.04rem, 1.55vw, 1.2rem);
    line-height: 1.68;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .hero-primary {
    color: var(--ink);
    background: var(--paper-inverse);
    border-color: var(--paper-inverse);
  }

  .hero-secondary {
    color: var(--paper-inverse);
    background: rgba(255,255,255,.025);
    border-color: rgba(255,255,255,.48);
    backdrop-filter: blur(8px);
  }

  .hero-note {
    max-width: 15rem;
    padding-top: .8rem;
    padding-bottom: .5rem;
    border-top: 1px solid rgba(225,187,114,.55);
    color: rgba(255,255,255,.58);
    font-size: .7rem;
    font-weight: 650;
    letter-spacing: .11em;
    line-height: 1.65;
    text-align: right;
    text-transform: uppercase;
  }

  .stats {
    position: relative;
    z-index: 4;
    margin-top: -2.45rem;
    background: transparent;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    background: rgba(255,255,255,.985);
    box-shadow: 0 1.25rem 3rem rgba(20,20,20,.07);
  }

  .stats-grid div {
    display: grid;
    min-width: 0;
    gap: .3rem;
    padding: 1.65rem var(--space-2);
    border-right: 1px solid var(--line);
    text-align: center;
  }

  .stats-grid div:last-child { border-right: 0; }
  .stats-grid strong {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.2;
  }
  .stats-grid span { color: var(--ink-soft); font-size: var(--text-sm); }

  .statement {
    margin-top: -2.45rem;
    padding-top: calc(var(--space-6) + 2.45rem);
  }

  .statement-grid {
    display: grid;
    grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr);
    align-items: end;
    gap: clamp(2rem, 9vw, 9rem);
    padding-block: clamp(5.5rem, 10vw, 8.5rem);
  }

  .statement-kicker {
    max-width: 18rem;
    padding-top: .9rem;
    border-top: 1px solid var(--brass);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: .065em;
    text-transform: uppercase;
  }

  .statement-copy {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.55rem, 5.2vw, 4.9rem);
    line-height: 1.025;
    letter-spacing: -.04em;
  }

  .services-section { padding-top: clamp(5.5rem, 9vw, 8.5rem); }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .65fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
  }

  .section-intro {
    padding-bottom: .25rem;
    color: var(--ink-soft);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.1rem, 2vw, 1.65rem);
    margin-top: clamp(3.25rem, 7vw, 5.75rem);
  }

  .service-card {
    display: grid;
    min-width: 0;
    grid-template-rows: auto 1fr;
    color: var(--ink);
    text-decoration: none;
  }

  .service-card--1 { grid-column: span 7; }
  .service-card--2 { grid-column: span 5; }
  .service-card--3,
  .service-card--4,
  .service-card--5 { grid-column: span 4; }
  .service-card--6 { grid-column: span 5; }
  .service-card--7 { grid-column: span 7; }

  .service-media {
    position: relative;
    overflow: hidden;
    background: var(--sand);
  }

  .service-card :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: saturate(.96);
    transition: transform 480ms var(--ease-move), filter 480ms var(--ease);
  }

  .service-card--2 :global(img),
  .service-card--6 :global(img) { aspect-ratio: 4 / 3; }

  .service-card--3 :global(img),
  .service-card--4 :global(img),
  .service-card--5 :global(img) { aspect-ratio: 1 / 1; }

  .service-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-3);
    padding: 1.35rem .1rem 2.2rem;
    border-bottom: 1px solid var(--line);
  }

  .service-body p {
    max-width: 42rem;
    margin-top: .55rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding-top: .25rem;
    color: var(--brass-deep);
    font-size: var(--text-sm);
    font-weight: 650;
    white-space: nowrap;
  }

  .process-section { padding-block: clamp(5.5rem, 9vw, 8.5rem); }

  .process-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, .62fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
  }

  .process-heading .lead { padding-bottom: .25rem; }
  .process-wrap { margin-top: clamp(3.5rem, 7vw, 5.75rem); }

  @media (hover: hover) and (pointer: fine) {
    .hero-primary:hover { color: #fff; background: var(--brass-deep); border-color: var(--brass-deep); }
    .hero-secondary:hover { color: var(--ink); background: var(--paper-inverse); border-color: var(--paper-inverse); }
    .service-card:hover { color: var(--ink); }
    .service-card:hover :global(img) { transform: scale(1.04); filter: saturate(1.03) contrast(1.025); }
    .service-card:hover .more { color: var(--ink); }
  }

  @media (max-width: 64rem) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-note { display: none; }
    .service-card--1,
    .service-card--2,
    .service-card--6,
    .service-card--7 { grid-column: span 6; }
    .service-card--3,
    .service-card--4,
    .service-card--5 { grid-column: span 4; }
  }

  @media (max-width: 56rem) {
    .hero::after { inset: .65rem; }
    .hero h1 { font-size: clamp(3.7rem, 11vw, 6rem); }
    .hero-title-line--offset { margin-left: clamp(.65rem, 3vw, 2rem); }
    .hero-title-detail { margin-left: clamp(.8rem, 7vw, 4rem); }
    .stats { margin-top: -1.5rem; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .stats-grid div { border-bottom: 1px solid var(--line); }
    .stats-grid div:nth-child(2n) { border-right: 0; }
    .stats-grid div:nth-last-child(-n + 2) { border-bottom: 0; }
    .statement { margin-top: -1.5rem; padding-top: calc(var(--space-5) + 1.5rem); }
    .statement-grid,
    .section-heading,
    .process-heading { grid-template-columns: 1fr; gap: var(--space-3); }
    .statement-grid { align-items: start; }
    .statement-copy { max-width: 20ch; }
    .section-intro { max-width: 44rem; }
    .service-card--1,
    .service-card--2,
    .service-card--3,
    .service-card--4,
    .service-card--5,
    .service-card--6,
    .service-card--7 { grid-column: span 6; }
    .service-card :global(img),
    .service-card--2 :global(img),
    .service-card--3 :global(img),
    .service-card--4 :global(img),
    .service-card--5 :global(img),
    .service-card--6 :global(img) { aspect-ratio: 4 / 3; }
    .service-body { grid-template-columns: 1fr; gap: .35rem; }
  }

  @media (max-width: 36rem) {
    .hero {
      min-height: calc(100svh - var(--header-height) - var(--mobile-cta-h));
      align-items: end;
    }

    .hero::after { display: none; }
    .hero-media :global(img) { object-position: 58% center; filter: saturate(.89) contrast(1.045); }
    .hero-media::before { display: none; }
    .hero-media::after {
      background: linear-gradient(0deg, rgba(13,14,16,.92) 0%, rgba(13,14,16,.6) 58%, rgba(13,14,16,.14) 100%);
    }
    .hero-inner { padding-block: 4rem 5rem; }
    .hero h1 {
      font-size: clamp(3.2rem, 14.5vw, 4.7rem);
      line-height: .84;
      letter-spacing: -.052em;
    }
    .hero-title-line--offset { margin-left: .4rem; }
    .hero-title-detail {
      margin-top: 1rem;
      margin-left: 1.1rem;
      font-size: .34em;
    }
    .hero .lead { max-width: 32rem; font-size: 1.02rem; line-height: 1.62; }
    .hero-actions { display: grid; grid-template-columns: 1fr; }
    .hero-actions .btn { width: 100%; }
    .stats-grid div { padding: 1.2rem .75rem; }
    .stats-grid span { font-size: .78rem; line-height: 1.35; }
    .statement-grid { padding-block: 4.75rem; }
    .statement-copy { font-size: clamp(2.3rem, 11vw, 3.2rem); }
    .service-grid { grid-template-columns: 1fr; gap: 2rem; }
    .service-card--1,
    .service-card--2,
    .service-card--3,
    .service-card--4,
    .service-card--5,
    .service-card--6,
    .service-card--7 { grid-column: 1; }
    .service-card :global(img),
    .service-card--2 :global(img),
    .service-card--3 :global(img),
    .service-card--4 :global(img),
    .service-card--5 :global(img),
    .service-card--6 :global(img) { aspect-ratio: 3 / 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card :global(img) { transition: none; }
  }
</style>
