---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { withBase } from '../lib/paths';
import interior from '../assets/service-interior.png';
import floors from '../assets/service-floors.png';
import doors from '../assets/service-doors-windows.png';
import terrace from '../assets/service-terrace.png';
import drywall from '../assets/service-drywall.png';
import sun from '../assets/service-sun-protection.png';

const referenzen = (await getCollection('referenzen'))
  .filter((projekt) => projekt.data.published === true)
  .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const hasRealCases = referenzen.length > 0;

const bilder = [
  { src: interior, alt: 'Wohnraum mit Holzvertäfelung und Einbauregal', label: 'Innenausbau' },
  { src: floors, alt: 'Eichenparkettboden in einem hellen Wohnraum', label: 'Böden' },
  { src: doors, alt: 'Moderne Innentür und Fensterfront', label: 'Innentüren' },
  { src: drywall, alt: 'Trockenbauwand mit Decke und Einbauspots', label: 'Trockenbau' },
  { src: sun, alt: 'Wohnzimmer mit Plissees als Sonnenschutz', label: 'Sonnenschutz' },
  { src: terrace, alt: 'Holzterrasse mit Blick in den Garten', label: 'Holzterrassen' }
];
---
<Base
  title="Referenzen Innenausbau Wittlich | KS-Innenausbau"
  description={hasRealCases
    ? 'Ausgewählte Projekte von KS-Innenausbau aus Wittlich und der Region: Ausgangslage, ausgeführte Arbeiten, Materialien, Details und fertiges Ergebnis.'
    : 'Bildliche Einblicke in die Leistungsbereiche von KS-Innenausbau: Böden, Innentüren, Trockenbau, Sonnenschutz und Holzterrassen.'}
>
  <section class="section visual-intro">
    <div class="wrap intro-grid">
      <div>
        <p class="eyebrow">{hasRealCases ? 'Ausgewählte Projekte' : 'Bildwelt & Referenzen'}</p>
        <h1>{hasRealCases ? 'Arbeit, die sich im Detail beweist.' : 'Räume, Materialien, Details.'}</h1>
      </div>
      <div class="intro-copy">
        {hasRealCases ? (
          <p class="lead">Echte Projekte zeigen am besten, wie aus Bestand, Material und handwerklichen Entscheidungen ein stimmiges Ergebnis wird.</p>
        ) : (
          <>
            <p class="lead">Die aktuelle Vorschau ordnet unsere Leistungsbereiche über Räume, Materialien und handwerkliche Details ein.</p>
            <p class="preview-note">Zum Launch zeigen wir hier ausschließlich freigegebene Originalaufnahmen realisierter KS-Projekte.</p>
          </>
        )}
      </div>
    </div>

    {hasRealCases ? (
      <div class="wrap case-index" aria-label="Freigegebene Referenzprojekte">
        {referenzen.map((projekt, index) => (
          <article class:list={['case-card', index === 0 && 'case-card--lead', 'reveal']} style={`--reveal-delay: ${(index % 3) * 55}ms`}>
            <a href={withBase(`/referenzen/${projekt.id}/`)} class="case-card__link">
              <div class="case-card__media">
                <Image
                  src={projekt.data.hero}
                  alt={projekt.data.heroAlt}
                  widths={[560, 800, 1200, 1600]}
                  sizes={index === 0 ? '(max-width: 56rem) 100vw, 66vw' : '(max-width: 56rem) 100vw, 34vw'}
                  quality={82}
                  format="webp"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="case-card__meta">
                <p>{projekt.data.ort}{projekt.data.jahr ? ` · ${projekt.data.jahr}` : ''}</p>
                <h2>{projekt.data.title}</h2>
                <span>{projekt.data.kurztext}</span>
                <strong>Projekt ansehen <span aria-hidden="true">→</span></strong>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="wrap">
        <ul class="galerie">
          {bilder.map((bild, index) => (
            <li class="reveal" style={`--reveal-delay: ${(index % 2) * 55}ms`}>
              <div class="gallery-media">
                <Image src={bild.src} alt={bild.alt} widths={[480, 800, 1200]} sizes="(max-width: 56rem) 100vw, 50vw" quality={78} format="webp" loading="lazy" />
              </div>
              <span class="label">{bild.label}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
  <CtaBand title={hasRealCases ? 'Sie planen ein ähnliches Projekt?' : 'Sie möchten sehen, was bei Ihrem Projekt möglich ist?'} />
</Base>

<style>
  .visual-intro { padding-top: clamp(5rem, 8vw, 7rem); }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, .78fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .intro-grid h1 { max-width: 12ch; }
  .intro-copy { display: grid; gap: 1.15rem; }
  .intro-copy .lead { margin-top: 0; }
  .preview-note {
    max-width: 52ch;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: .78rem;
    line-height: 1.65;
  }

  .case-index {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: clamp(1rem, 2vw, 1.6rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .case-card { min-width: 0; background: #f4efe7; border: 1px solid var(--line); }
  .case-card--lead { grid-row: span 2; }
  .case-card__link { display: grid; height: 100%; color: inherit; text-decoration: none; }
  .case-card__media { min-height: 20rem; overflow: hidden; background: var(--sand); }
  .case-card--lead .case-card__media { min-height: clamp(30rem, 54vw, 48rem); }
  .case-card__media :global(img) { display: block; width: 100%; height: 100%; min-height: inherit; object-fit: cover; transition: transform 300ms var(--ease-move); }
  .case-card__meta { display: grid; align-content: start; padding: clamp(1.4rem, 3vw, 2rem); }
  .case-card__meta p { margin: 0 0 .7rem; color: var(--brass-deep); font-size: .7rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .case-card__meta h2 { max-width: 16ch; margin: 0; font-size: clamp(1.8rem, 3vw, 3rem); line-height: .98; }
  .case-card__meta > span { max-width: 48ch; margin-top: 1rem; color: var(--ink-soft); line-height: 1.65; }
  .case-card__meta strong { display: inline-flex; gap: .55rem; margin-top: 1.35rem; color: var(--ink); font-size: .82rem; font-weight: 700; }

  .galerie {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: clamp(.8rem, 1.5vw, 1.2rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: 0;
    list-style: none;
  }
  .galerie li {
    position: relative;
    overflow: hidden;
    background: var(--sand);
  }
  .galerie li:nth-child(3n + 2),
  .galerie li:nth-child(3n + 3) { align-self: stretch; }
  .gallery-media { height: 100%; overflow: hidden; }
  .galerie :global(img) {
    width: 100%;
    height: 100%;
    min-height: clamp(18rem, 34vw, 32rem);
    object-fit: cover;
    transition: transform 300ms var(--ease-move);
  }
  .galerie li:nth-child(even) :global(img) { min-height: clamp(16rem, 27vw, 25rem); }
  .label {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: .55rem .8rem;
    color: #fff;
    background: rgba(23,24,27,.88);
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .06em;
    backdrop-filter: blur(8px);
  }

  @media (hover: hover) and (pointer: fine) {
    .galerie li:hover :global(img),
    .case-card__link:hover .case-card__media :global(img) { transform: scale(1.018); }
  }

  @media (max-width: 56rem) {
    .intro-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .galerie, .case-index { grid-template-columns: 1fr 1fr; }
    .case-card--lead { grid-row: auto; grid-column: 1 / -1; }
    .case-card--lead .case-card__media { min-height: clamp(24rem, 70vw, 38rem); }
  }

  @media (max-width: 40rem) {
    .galerie, .case-index { grid-template-columns: 1fr; }
    .case-card--lead { grid-column: auto; }
    .case-card__media, .case-card--lead .case-card__media { min-height: 17rem; }
    .galerie :global(img), .galerie li:nth-child(even) :global(img) { min-height: 16rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .galerie :global(img), .case-card__media :global(img) { transition: none; }
  }
</style>
