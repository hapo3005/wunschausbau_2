---
import Base from '../layouts/Base.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBand from '../components/CtaBand.astro';
import settings from '../data/settings.json';

const werte = [
  { title: 'Ehrliche Beratung', text: 'Wir sagen, was sinnvoll ist – und auch, was sich nicht lohnt.' },
  { title: 'Klare Abstimmung', text: 'Material, Maße, Anschlüsse und Termine werden vor der Ausführung geklärt.' },
  { title: 'Präzise Ausführung', text: 'Saubere Anschlüsse, stimmige Details und ein ordentliches Ergebnis stehen im Mittelpunkt.' },
  { title: 'Blick fürs Ganze', text: 'Boden, Türen, Trockenbau und Übergänge sollen am Ende selbstverständlich zusammenpassen.' }
];
---
<Base
  title="Über uns | wunschausbau.de – KS - Innenausbau Kevin Schmieding"
  description="Kevin Schmieding, Bauschreiner aus Wittlich: Innenausbau und Renovierung in Wittlich, Trier und der Moselregion – persönlich, transparent und handwerklich präzise."
>
  <section class="section intro">
    <div class="wrap intro-grid">
      <div>
        <p class="eyebrow">Über uns</p>
        <h1>Innenausbau, der wirklich passt.</h1>
      </div>
      <p class="lead">
        Hinter {settings.marke} steht Kevin Schmieding, Bauschreiner aus Wittlich. Entscheidend ist nicht nur,
        dass etwas eingebaut wird – sondern dass Materialien, Anschlüsse und Details am Ende sauber zusammenpassen.
      </p>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="werte-titel">
    <div class="wrap">
      <p class="eyebrow">Zusammenarbeit</p>
      <h2 id="werte-titel">Was auf jeder Baustelle zählt.</h2>
      <div class="werte">
        {werte.map((wert, index) => (
          <div class="wert reveal" style={`--reveal-delay: ${(index % 2) * 55}ms`}>
            <span class="wert-accent" aria-hidden="true"></span>
            <h3>{wert.title}</h3>
            <p>{wert.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ablauf2-titel">
    <div class="wrap">
      <p class="eyebrow">Arbeitsweise</p>
      <h2 id="ablauf2-titel">Ein klarer Ablauf.</h2>
      <div class="process-wrap"><ProcessSteps /></div>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="region-titel">
    <div class="wrap region">
      <div>
        <p class="eyebrow">Einsatzgebiet</p>
        <h2 id="region-titel">Regional verwurzelt.</h2>
        <p class="lead">
          Wir arbeiten in {settings.regionen.join(', ')} und Umgebung.
          Bei größeren Projekten übernehmen wir auch weitere Strecken – sprechen Sie uns an.
        </p>
      </div>
      <p class="region-mark" aria-hidden="true">{settings.region}</p>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, .85fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .intro-grid .lead { margin-top: 0; }
  .werte {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .wert {
    position: relative;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(255,255,255,.45);
  }
  .wert:nth-child(even) { border-right: 0; }
  .wert-accent {
    display: block;
    width: 2.75rem;
    height: 1px;
    margin-bottom: var(--space-3);
    background: var(--brass);
  }
  .wert h3 { margin-bottom: .65rem; }
  .wert p { color: var(--ink-soft); font-size: var(--text-sm); }
  .process-wrap { margin-top: var(--space-6); }
  .region {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-6);
  }
  .region-mark {
    max-width: 14ch;
    color: var(--brass-deep);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    line-height: 1.2;
    text-align: right;
  }

  @media (max-width: 56rem) {
    .intro-grid { grid-template-columns: 1fr; gap: var(--space-3); }
    .intro-grid .lead { margin-top: var(--space-1); }
  }

  @media (max-width: 36rem) {
    .werte { grid-template-columns: 1fr; }
    .wert { border-right: 0; }
    .region { grid-template-columns: 1fr; }
    .region-mark { text-align: left; }
  }
</style>