---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import logoUrl from '../assets/logo.svg?url';

const nav = [
  { href: withBase('/leistungen/'), label: 'Leistungen' },
  { href: withBase('/referenzen/'), label: 'Referenzen' },
  { href: withBase('/ueber-uns/'), label: 'Über uns' }
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-shell">
    <a class="brand" href={withBase('/')} aria-label={`${settings.marke} – Startseite`}>
      <img class="brand-mark" src={logoUrl} width="449" height="452" alt="" />
      <span class="brand-copy">
        <span class="brand-name">{settings.marke}</span>
        <span class="brand-claim">Innenausbau · Renovierung</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation" id="site-nav">
      <div class="nav-links">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>

      <div class="nav-actions">
        <a class="nav-phone" href={`tel:${settings.telefonLink}`} aria-label={`Anrufen: ${settings.telefon}`}>
          <span class="nav-phone-line" aria-hidden="true"></span>
          <span>{settings.telefon}</span>
        </a>

        <a class="nav-cta" href={withBase('/kontakt/')} aria-label="Projekt anfragen">
          <span class="nav-cta__label">Projekt anfragen</span>
          <span class="nav-cta__icon" aria-hidden="true">
            <svg viewBox="0 0 18 18">
              <path d="M5 13 13 5M7 5h6v6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
            </svg>
          </span>
        </a>
      </div>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    color: var(--ink);
    background: rgba(251, 249, 245, .985);
    border-bottom: 1px solid rgba(23, 24, 27, .10);
    transition: background-color 220ms ease, box-shadow 220ms ease;
  }

  .site-header.is-scrolled {
    background: rgba(251, 249, 245, .995);
    box-shadow: 0 .7rem 2.4rem rgba(23, 24, 27, .065);
    backdrop-filter: blur(18px) saturate(112%);
    -webkit-backdrop-filter: blur(18px) saturate(112%);
  }

  .header-shell {
    display: grid;
    width: min(calc(100% - clamp(2.5rem, 6vw, 6rem)), 92rem);
    min-height: 6rem;
    margin-inline: auto;
    grid-template-columns: minmax(17rem, 1fr) auto minmax(17rem, 1fr);
    align-items: center;
    gap: clamp(2rem, 3.5vw, 4rem);
    transition: min-height 220ms var(--ease-move);
  }

  .site-header.is-scrolled .header-shell {
    min-height: 5.15rem;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .95rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-mark {
    width: 3.55rem;
    height: 3.55rem;
    flex: 0 0 auto;
    object-fit: contain;
    opacity: .96;
    transition: width 220ms var(--ease-move), height 220ms var(--ease-move), opacity 170ms ease, transform 220ms var(--ease-move);
  }

  .site-header.is-scrolled .brand-mark {
    width: 3.05rem;
    height: 3.05rem;
  }

  .brand-copy {
    display: grid;
    gap: .3rem;
    min-width: 0;
  }

  .brand-name {
    color: #151619;
    font-family: var(--font-brand);
    font-size: 1.46rem;
    font-weight: 720;
    letter-spacing: -.04em;
    line-height: .96;
  }

  .brand-claim {
    color: #80591e;
    font-family: var(--font-text);
    font-size: .72rem;
    font-weight: 680;
    letter-spacing: .105em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .site-nav {
    display: contents;
  }

  .nav-links {
    grid-column: 2;
    display: flex;
    min-height: inherit;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 3.1vw, 3.35rem);
  }

  .nav-links > a {
    position: relative;
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    color: #25272b;
    font-family: var(--font-text);
    font-size: 1.04rem;
    font-weight: 630;
    letter-spacing: -.016em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 170ms ease;
  }

  .nav-links > a::after {
    position: absolute;
    bottom: .22rem;
    left: 50%;
    width: .34rem;
    height: .34rem;
    border-radius: 50%;
    background: #b9822f;
    content: '';
    opacity: 0;
    transform: translate(-50%, .3rem) scale(.6);
    transition: opacity 170ms ease, transform 220ms var(--ease-move);
  }

  .nav-links > a[aria-current="page"] {
    color: #111214;
  }

  .nav-links > a[aria-current="page"]::after {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  .nav-actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .nav-phone {
    display: none;
  }

  .nav-cta {
    display: inline-flex;
    min-height: 3.35rem;
    align-items: center;
    gap: 1rem;
    color: #17181b;
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 670;
    letter-spacing: -.016em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-cta__label {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav-cta__label::after {
    position: absolute;
    right: 0;
    bottom: -.36rem;
    left: 0;
    height: 1px;
    background: rgba(23,24,27,.28);
    content: '';
    transform-origin: left;
    transition: background-color 170ms ease, transform 220ms var(--ease-move);
  }

  .nav-cta__icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    flex: 0 0 auto;
    place-items: center;
    color: #f7f3eb;
    background: #1a1b1e;
    border: 1px solid #1a1b1e;
    transition: color 170ms ease, background-color 170ms ease, border-color 170ms ease, transform 220ms var(--ease-move);
  }

  .nav-cta__icon svg {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 220ms var(--ease-move);
  }

  .menu-btn { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark { opacity: 1; transform: scale(1.018); }
    .nav-links > a:hover { color: #111214; }
    .nav-links > a:hover::after { opacity: .65; transform: translate(-50%, 0) scale(.8); }
    .nav-links > a[aria-current="page"]:hover::after { opacity: 1; transform: translate(-50%, 0) scale(1); }
    .nav-cta:hover .nav-cta__label::after { background: #b9822f; transform: scaleX(.72); }
    .nav-cta:hover .nav-cta__icon {
      color: #17181b;
      background: #d7b36b;
      border-color: #d7b36b;
      transform: translateY(-1px);
    }
    .nav-cta:hover .nav-cta__icon svg { transform: translate(.1rem, -.1rem); }
  }

  @media (max-width: 76rem) {
    .header-shell {
      width: min(calc(100% - 2.75rem), 88rem);
      grid-template-columns: minmax(14rem, 1fr) auto minmax(13rem, 1fr);
      gap: 1.6rem;
    }

    .brand-mark { width: 3.2rem; height: 3.2rem; }
    .brand-name { font-size: 1.3rem; }
    .brand-claim { font-size: .65rem; }
    .nav-links { gap: 1.8rem; }
    .nav-links > a { font-size: .98rem; }
    .nav-cta { font-size: .95rem; gap: .8rem; }
    .nav-cta__icon { width: 2.8rem; height: 2.8rem; }
  }

  @media (max-width: 62rem) {
    .header-shell {
      grid-template-columns: minmax(13rem, 1fr) auto auto;
      gap: 1.2rem;
    }
    .nav-links { gap: 1.25rem; }
    .nav-links > a { font-size: .92rem; }
    .nav-cta__label { display: none; }
  }

  @media (max-width: 56rem) {
    .site-header { min-height: 4.85rem; }

    .header-shell,
    .site-header.is-scrolled .header-shell {
      display: flex;
      width: calc(100% - 2rem);
      min-height: 4.85rem;
      gap: 1rem;
    }

    .brand { gap: .72rem; }
    .brand-mark,
    .site-header.is-scrolled .brand-mark { width: 2.72rem; height: 2.72rem; }
    .brand-name { font-size: 1.12rem; }
    .brand-claim { font-size: .58rem; letter-spacing: .09em; }

    .site-nav {
      position: fixed;
      top: 4.85rem;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 3;
      display: grid;
      grid-template-rows: 1fr auto;
      gap: 2rem;
      padding: clamp(2.1rem, 7vw, 3rem) var(--pad-inline) calc(1.6rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      color: var(--ink);
      background: #fbf9f4;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-.35rem);
      transition: opacity 200ms ease, transform 240ms var(--ease-move), visibility 0s linear 240ms;
    }

    .site-nav.open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .nav-links {
      display: grid;
      min-height: 0;
      align-content: start;
      gap: 0;
    }

    .nav-links > a {
      min-height: 5rem;
      color: #17181b;
      border-bottom: 1px solid rgba(28,29,31,.13);
      font-family: var(--font-brand);
      font-size: clamp(1.7rem, 6vw, 2.1rem);
      font-weight: 650;
      letter-spacing: -.035em;
    }

    .nav-links > a:first-child { border-top: 1px solid rgba(28,29,31,.13); }
    .nav-links > a::after {
      right: auto;
      bottom: 50%;
      left: auto;
      width: .38rem;
      height: .38rem;
      margin-left: .9rem;
      opacity: 0;
      transform: translateY(50%) scale(.6);
    }
    .nav-links > a[aria-current="page"]::after { opacity: 1; transform: translateY(50%) scale(1); }

    .nav-actions {
      display: grid;
      gap: 1rem;
    }

    .nav-phone {
      display: inline-flex;
      min-height: 3.2rem;
      align-items: center;
      gap: .7rem;
      color: #17181b;
      font-size: 1rem;
      font-weight: 650;
      text-decoration: none;
    }

    .nav-phone-line {
      width: 2rem;
      height: 1px;
      background: #b9822f;
    }

    .nav-cta {
      display: flex;
      min-height: 4rem;
      justify-content: space-between;
      gap: 1rem;
      font-size: 1rem;
    }

    .nav-cta__label { display: inline-flex; }
    .nav-cta__icon { width: 3.15rem; height: 3.15rem; }

    .menu-btn {
      display: grid;
      width: 2.95rem;
      height: 2.95rem;
      margin-left: auto;
      padding: 0;
      place-content: center;
      gap: 7px;
      border: 0;
      color: #17181b;
      background: transparent;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .menu-btn span {
      width: 1.45rem;
      height: 1px;
      background: currentColor;
      transform-origin: center;
      transition: transform 210ms var(--ease-move);
    }

    .menu-btn[aria-expanded="true"] span:first-child { transform: translateY(4px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] span:last-child { transform: translateY(-4px) rotate(-45deg); }
  }

  @media (max-width: 30rem) {
    .brand-claim { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-shell,
    .brand-mark,
    .nav-links > a::after,
    .nav-cta__label::after,
    .nav-cta__icon,
    .nav-cta__icon svg,
    .site-nav,
    .menu-btn span { transition: none !important; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const button = header?.querySelector('.menu-btn');
  const navigation = header?.querySelector('#site-nav');
  const mobile = window.matchMedia('(max-width: 56rem)');

  const setMenu = (open) => {
    navigation?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    document.body.classList.toggle('nav-open', open && mobile.matches);
  };

  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 20);

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      button.focus();
    }
  });
  mobile.addEventListener('change', (event) => {
    if (!event.matches) setMenu(false);
  });
  window.addEventListener('scroll', setScrolled, { passive: true });
  setScrolled();
</script>

<style is:global>
  @media (max-width: 56rem) {
    body.nav-open { overflow: hidden; }
  }
</style>
