---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import logoUrl from '../assets/logo.svg?url';

const nav = [
  { href: withBase('/leistungen/'), label: 'Leistungen' },
  { href: withBase('/referenzen/'), label: 'Referenzen' },
  { href: withBase('/ueber-uns/'), label: 'Über uns' }
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-shell">
    <a class="brand" href={withBase('/')} aria-label={`${settings.marke} – Startseite`}>
      <img class="brand-mark" src={logoUrl} width="449" height="452" alt="" />
      <span class="brand-copy">
        <span class="brand-name">{settings.marke}</span>
        <span class="brand-claim">Innenausbau · Renovierung</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation" id="site-nav">
      <div class="nav-links">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>

      <div class="nav-actions">
        <a class="nav-phone" href={`tel:${settings.telefonLink}`} aria-label={`Anrufen: ${settings.telefon}`}>
          <span class="nav-phone-line" aria-hidden="true"></span>
          <span>{settings.telefon}</span>
        </a>

        <a class="nav-cta" href={withBase('/kontakt/')}>
          <span>Projekt anfragen</span>
          <span class="nav-cta__icon" aria-hidden="true">
            <svg viewBox="0 0 18 18"><path d="M4.75 9h8.5M9.75 5.5 13.25 9l-3.5 3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.45" /></svg>
          </span>
        </a>
      </div>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    color: var(--ink);
    background: rgba(253,252,249,.97);
    border-bottom: 1px solid rgba(28,29,31,.10);
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }

  .site-header.is-scrolled {
    background: rgba(253,252,249,.985);
    box-shadow: 0 .55rem 1.8rem rgba(28,29,31,.055);
    backdrop-filter: blur(16px) saturate(108%);
    -webkit-backdrop-filter: blur(16px) saturate(108%);
  }

  .header-shell {
    display: grid;
    width: min(calc(100% - clamp(2.5rem, 6vw, 6rem)), 92rem);
    min-height: 5.5rem;
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.8rem, 3vw, 3.5rem);
    transition: min-height 210ms var(--ease-move);
  }

  .site-header.is-scrolled .header-shell { min-height: 4.9rem; }

  .brand {
    display: inline-flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    align-items: center;
    gap: .85rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-mark {
    width: 3.15rem;
    height: 3.15rem;
    flex: 0 0 auto;
    object-fit: contain;
    opacity: .97;
    transition: width 210ms var(--ease-move), height 210ms var(--ease-move), transform 200ms var(--ease-move);
  }

  .site-header.is-scrolled .brand-mark { width: 2.8rem; height: 2.8rem; }

  .brand-copy { display: grid; gap: .26rem; min-width: 0; }

  .brand-name {
    color: #151619;
    font-family: var(--font-brand);
    font-size: 1.38rem;
    font-weight: 700;
    letter-spacing: -.035em;
    line-height: .96;
    overflow-wrap: anywhere;
  }

  .brand-claim {
    color: var(--brass-deep);
    font-family: var(--font-text);
    font-size: .66rem;
    font-weight: 650;
    letter-spacing: .095em;
    line-height: 1.2;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .site-nav { display: contents; }

  .nav-links {
    grid-column: 2;
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 clamp(1rem, 3vw, 3.15rem);
  }

  .nav-links > a {
    position: relative;
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    color: #303237;
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 570;
    letter-spacing: -.012em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 170ms ease;
  }

  .nav-links > a::after {
    position: absolute;
    bottom: .2rem;
    left: 50%;
    width: .3rem;
    height: .3rem;
    border-radius: 50%;
    background: var(--brass);
    content: '';
    opacity: 0;
    transform: translate(-50%, .2rem) scale(.65);
    transition: opacity 170ms ease, transform 200ms var(--ease-move);
  }

  .nav-links > a[aria-current="page"] { color: #111214; }
  .nav-links > a[aria-current="page"]::after { opacity: 1; transform: translate(-50%, 0) scale(1); }

  .nav-actions {
    grid-column: 3;
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
  }

  .nav-phone { display: none; }

  .nav-cta {
    display: inline-flex;
    max-width: 100%;
    min-width: 0;
    min-height: 3.2rem;
    align-items: center;
    gap: .95rem;
    padding: 0 0 0 1rem;
    overflow: hidden;
    color: var(--ink);
    background: transparent;
    border: 1px solid rgba(28,29,31,.25);
    font-family: var(--font-text);
    font-size: .94rem;
    font-weight: 620;
    letter-spacing: -.01em;
    line-height: 1.1;
    text-decoration: none;
    transition: color 170ms ease, background-color 170ms ease, border-color 170ms ease, transform 170ms ease;
  }

  .nav-cta > span:first-child { min-width: 0; overflow-wrap: anywhere; }

  .nav-cta__icon {
    display: grid;
    width: 3.2rem;
    align-self: stretch;
    flex: 0 0 auto;
    place-items: center;
    color: #fff;
    background: var(--brass-deep);
    transition: background-color 170ms ease;
  }

  .nav-cta__icon svg { width: 1rem; height: 1rem; transition: transform 200ms var(--ease-move); }
  .menu-btn { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark { transform: scale(1.015); }
    .nav-links > a:hover { color: #111214; }
    .nav-links > a:hover::after { opacity: .55; transform: translate(-50%, 0) scale(.85); }
    .nav-links > a[aria-current="page"]:hover::after { opacity: 1; transform: translate(-50%, 0) scale(1); }
    .nav-cta:hover {
      color: #17181b;
      background: #f4efe7;
      border-color: rgba(118,80,29,.55);
      transform: translateY(-1px);
    }
    .nav-cta:hover .nav-cta__icon { background: var(--brass); }
    .nav-cta:hover .nav-cta__icon svg { transform: translateX(.14rem); }
  }

  @media (max-width: 76rem) {
    .header-shell {
      width: min(calc(100% - 2.75rem), 88rem);
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 1.5rem;
    }
    .brand-mark { width: 3rem; height: 3rem; }
    .brand-name { font-size: 1.28rem; }
    .brand-claim { font-size: .62rem; }
    .nav-links { gap: 0 1.75rem; }
    .nav-links > a { font-size: .96rem; }
    .nav-cta { font-size: .9rem; }
  }

  @media (max-width: 62rem) {
    .header-shell { grid-template-columns: minmax(0, 1fr) auto minmax(0, auto); gap: 1.1rem; }
    .nav-links { gap: 0 1.2rem; }
    .nav-links > a { font-size: .9rem; }
    .nav-cta > span:first-child { display: none; }
    .nav-cta { min-width: 3.2rem; padding: 0; }
    .nav-cta__icon { width: 3.2rem; }
  }

  @media (max-width: 56rem) {
    .site-header { min-height: 4.75rem; }

    .header-shell,
    .site-header.is-scrolled .header-shell {
      display: flex;
      width: calc(100% - 2rem);
      min-height: 4.75rem;
      gap: 1rem;
    }

    .brand { gap: .7rem; }
    .brand-mark,
    .site-header.is-scrolled .brand-mark { width: 2.65rem; height: 2.65rem; }
    .brand-name { font-size: 1.12rem; }
    .brand-claim { font-size: .57rem; letter-spacing: .085em; }

    .site-nav {
      position: fixed;
      top: 4.75rem;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 3;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 2rem;
      padding: clamp(2.1rem, 7vw, 3rem) var(--pad-inline) calc(1.6rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      color: var(--ink);
      background: #fbf9f4;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-.3rem);
      transition: opacity 190ms ease, transform 220ms var(--ease-move), visibility 0s linear 220ms;
    }

    .site-nav.open { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }

    .nav-links {
      grid-column: 1;
      display: grid;
      width: 100%;
      min-height: 0;
      align-content: start;
      gap: 0;
    }

    .nav-links > a {
      min-height: 5rem;
      color: var(--ink);
      border-bottom: 1px solid rgba(28,29,31,.13);
      font-family: var(--font-brand);
      font-size: clamp(1.7rem, 6vw, 2.1rem);
      font-weight: 600;
      letter-spacing: -.025em;
    }

    .nav-links > a:first-child { border-top: 1px solid rgba(28,29,31,.13); }
    .nav-links > a::after { right: 0; bottom: 50%; left: auto; transform: translateY(50%) scale(.65); }
    .nav-links > a[aria-current="page"]::after { opacity: 1; transform: translateY(50%) scale(1); }

    .nav-actions {
      grid-column: 1;
      display: grid;
      width: 100%;
      align-self: end;
      gap: .85rem;
    }

    .nav-phone {
      display: inline-flex;
      width: 100%;
      min-height: 3.2rem;
      align-items: center;
      gap: .7rem;
      color: var(--ink);
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
    }

    .nav-phone-line { width: 2rem; height: 1px; background: var(--brass); }

    .nav-cta {
      display: flex;
      width: 100%;
      min-height: 4rem;
      justify-content: space-between;
      gap: 1rem;
      padding: 0 0 0 1rem;
      font-size: 1rem;
    }
    .nav-cta > span:first-child { display: inline; }
    .nav-cta__icon { width: 4rem; align-self: stretch; }

    .menu-btn {
      display: grid;
      width: 2.95rem;
      height: 2.95rem;
      margin-left: auto;
      padding: 0;
      place-content: center;
      gap: 7px;
      border: 0;
      color: var(--ink);
      background: transparent;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .menu-btn span {
      width: 1.45rem;
      height: 1px;
      background: currentColor;
      transform-origin: center;
      transition: transform 200ms var(--ease-move);
    }

    .menu-btn[aria-expanded="true"] span:first-child { transform: translateY(4px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] span:last-child { transform: translateY(-4px) rotate(-45deg); }
  }

  @media (max-width: 30rem) { .brand-claim { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .header-shell,
    .brand-mark,
    .nav-links > a::after,
    .nav-cta,
    .nav-cta__icon,
    .nav-cta__icon svg,
    .site-nav,
    .menu-btn span { transition: none; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const button = header?.querySelector('.menu-btn');
  const navigation = header?.querySelector('#site-nav');
  const mobile = window.matchMedia('(max-width: 56rem)');
  let lastFocused = null;

  const focusables = () => navigation ? [...navigation.querySelectorAll('a[href], button:not([disabled])')] : [];

  const setMenu = (open, returnFocus = false) => {
    if (open) lastFocused = document.activeElement;
    navigation?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    document.body.classList.toggle('nav-open', open && mobile.matches);

    if (open && mobile.matches) {
      requestAnimationFrame(() => focusables()[0]?.focus());
    } else if (returnFocus && lastFocused instanceof HTMLElement) {
      lastFocused.focus();
    }
  };

  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 20);

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (!mobile.matches || button?.getAttribute('aria-expanded') !== 'true') return;

    if (event.key === 'Escape') {
      event.preventDefault();
      setMenu(false, true);
      return;
    }

    if (event.key !== 'Tab') return;
    const items = focusables();
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  mobile.addEventListener('change', (event) => {
    if (!event.matches) setMenu(false);
  });
  window.addEventListener('scroll', setScrolled, { passive: true });
  setScrolled();
</script>

<style is:global>
  @media (max-width: 56rem) {
    body.nav-open { overflow: hidden; }
  }
</style>