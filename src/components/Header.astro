---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import logoUrl from '../assets/logo.svg?url';

const nav = [
  { href: withBase('/leistungen/'), label: 'Leistungen' },
  { href: withBase('/referenzen/'), label: 'Referenzen' },
  { href: withBase('/ueber-uns/'), label: 'Über uns' },
  { href: withBase('/kontakt/'), label: 'Kontakt' }
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-shell">
    <a class="brand" href={withBase('/')} aria-label={`${settings.marke} – Startseite`}>
      <img class="brand-mark" src={logoUrl} width="449" height="452" alt="" />
      <span class="brand-copy">
        <span class="brand-name">{settings.marke}</span>
        <span class="brand-claim">{settings.claim}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation" id="site-nav">
      <div class="nav-links">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>

      <div class="nav-actions">
        <a class="nav-phone" href={`tel:${settings.telefonLink}`} aria-label={`Anrufen: ${settings.telefon}`}>
          <span class="nav-phone-mark" aria-hidden="true"></span>
          <span>{settings.telefon}</span>
        </a>

        <a class="nav-cta" href={withBase('/kontakt/')}>
          <span>Projekt anfragen</span>
          <svg aria-hidden="true" viewBox="0 0 18 18">
            <path d="M5 13 13 5M7 5h6v6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </a>
      </div>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    color: #f7f3eb;
    background: #171716;
    border-bottom: 1px solid rgba(255,255,255,.09);
    transition: background-color 180ms ease, box-shadow 180ms ease;
  }

  .site-header.is-scrolled {
    background: rgba(23,23,22,.985);
    box-shadow: 0 .8rem 2.4rem rgba(0,0,0,.18);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .header-shell {
    display: grid;
    width: min(calc(100% - clamp(2rem, 5vw, 5rem)), 92rem);
    min-height: 5.75rem;
    margin-inline: auto;
    grid-template-columns: minmax(15rem, 1fr) auto minmax(15rem, 1fr);
    align-items: center;
    gap: clamp(1.6rem, 3vw, 3.6rem);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .9rem;
    color: #f7f3eb;
    text-decoration: none;
  }

  .brand-mark {
    width: 3.35rem;
    height: 3.35rem;
    flex: 0 0 auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: .93;
    transition: opacity 180ms ease, transform 220ms var(--ease-move);
  }

  .brand-copy {
    display: grid;
    gap: .28rem;
    min-width: 0;
  }

  .brand-name {
    color: #fff;
    font-family: var(--font-brand);
    font-size: 1.38rem;
    font-weight: 680;
    letter-spacing: -.035em;
    line-height: .98;
  }

  .brand-claim {
    color: #d9b66f;
    font-family: var(--font-text);
    font-size: .68rem;
    font-weight: 650;
    letter-spacing: .13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .site-nav {
    display: contents;
  }

  .nav-links {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.65rem, 2.4vw, 2.8rem);
    min-height: 5.75rem;
  }

  .nav-links > a {
    position: relative;
    display: inline-flex;
    min-height: 5.75rem;
    align-items: center;
    color: rgba(255,255,255,.84);
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 590;
    letter-spacing: -.012em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .nav-links > a::after {
    position: absolute;
    right: 50%;
    bottom: 0;
    left: 50%;
    height: 2px;
    background: #d0a65e;
    content: '';
    transition: right 190ms var(--ease-move), left 190ms var(--ease-move);
  }

  .nav-links > a[aria-current="page"] {
    color: #fff;
  }

  .nav-links > a[aria-current="page"]::after {
    right: 0;
    left: 0;
  }

  .nav-actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1rem, 1.7vw, 1.45rem);
  }

  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    color: rgba(255,255,255,.9);
    font-family: var(--font-text);
    font-size: .98rem;
    font-weight: 610;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.012em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .nav-phone-mark {
    width: 1.6rem;
    height: 1px;
    flex: 0 0 auto;
    background: #d0a65e;
    transition: width 180ms var(--ease-move);
  }

  .nav-cta {
    display: inline-flex;
    min-height: 3.45rem;
    align-items: center;
    justify-content: center;
    gap: .8rem;
    padding: .9rem 1.3rem .9rem 1.45rem;
    color: #171716;
    background: #f4f0e8;
    border: 1px solid #f4f0e8;
    font-family: var(--font-text);
    font-size: .96rem;
    font-weight: 660;
    letter-spacing: -.012em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 170ms ease, border-color 170ms ease, color 170ms ease, transform 170ms var(--ease-move);
  }

  .nav-cta svg {
    width: 1rem;
    height: 1rem;
    color: #8f641f;
    transition: transform 200ms var(--ease-move);
  }

  .menu-btn { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark { opacity: 1; transform: scale(1.025); }
    .nav-links > a:hover { color: #fff; }
    .nav-links > a:hover::after { right: 0; left: 0; }
    .nav-phone:hover { color: #fff; }
    .nav-phone:hover .nav-phone-mark { width: 2.1rem; }
    .nav-cta:hover {
      color: #171716;
      background: #d9b66f;
      border-color: #d9b66f;
      transform: translateY(-1px);
    }
    .nav-cta:hover svg { transform: translate(.12rem, -.12rem); }
  }

  @media (max-width: 78rem) {
    .header-shell {
      width: min(calc(100% - 2.5rem), 88rem);
      grid-template-columns: minmax(13rem, 1fr) auto minmax(12rem, 1fr);
      gap: 1.5rem;
    }

    .brand-mark { width: 3rem; height: 3rem; }
    .brand-name { font-size: 1.25rem; }
    .brand-claim { font-size: .62rem; }
    .nav-links { gap: 1.4rem; }
    .nav-links > a { font-size: .95rem; }
    .nav-phone-mark { display: none; }
    .nav-phone { font-size: .91rem; }
    .nav-cta { padding-inline: 1.05rem 1.15rem; font-size: .91rem; }
  }

  @media (max-width: 66rem) {
    .nav-phone { display: none; }
    .nav-links { gap: 1.15rem; }
  }

  @media (max-width: 56rem) {
    .site-header { min-height: 4.8rem; }

    .header-shell {
      display: flex;
      width: calc(100% - 2rem);
      min-height: 4.8rem;
      gap: 1rem;
    }

    .brand { gap: .7rem; }
    .brand-mark { width: 2.7rem; height: 2.7rem; }
    .brand-name { font-size: 1.1rem; }
    .brand-claim { font-size: .56rem; letter-spacing: .1em; }

    .site-nav {
      position: fixed;
      top: 4.8rem;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 3;
      display: grid;
      grid-template-rows: 1fr auto;
      gap: 2rem;
      padding: clamp(2rem, 7vw, 3rem) var(--pad-inline) calc(1.6rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      color: var(--ink);
      background: #f8f5ee;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-.45rem);
      transition: opacity 200ms ease, transform 240ms var(--ease-move), visibility 0s linear 240ms;
    }

    .site-nav.open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .nav-links {
      display: grid;
      min-height: 0;
      align-content: start;
      gap: 0;
    }

    .nav-links > a {
      min-height: 4.9rem;
      color: #17181b;
      border-bottom: 1px solid rgba(28,29,31,.13);
      font-family: var(--font-brand);
      font-size: clamp(1.6rem, 6vw, 2rem);
      font-weight: 620;
      letter-spacing: -.03em;
    }

    .nav-links > a:first-child { border-top: 1px solid rgba(28,29,31,.13); }
    .nav-links > a::after {
      right: auto;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      transition: width 190ms var(--ease-move);
    }
    .nav-links > a[aria-current="page"] { color: #17181b; }
    .nav-links > a[aria-current="page"]::after { width: 3.25rem; }

    .nav-actions {
      display: grid;
      gap: 1rem;
    }

    .nav-phone {
      display: inline-flex;
      min-height: 3.2rem;
      color: #17181b;
      font-size: 1rem;
    }

    .nav-phone-mark { display: block; }

    .nav-cta {
      min-height: 3.9rem;
      justify-content: space-between;
      color: #fff;
      background: #17181b;
      border-color: #17181b;
      font-size: 1rem;
    }

    .nav-cta svg { color: #d9b66f; }

    .menu-btn {
      display: grid;
      width: 2.95rem;
      height: 2.95rem;
      margin-left: auto;
      padding: 0;
      place-content: center;
      gap: 7px;
      border: 1px solid rgba(255,255,255,.18);
      color: #fff;
      background: transparent;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .menu-btn span {
      width: 1.35rem;
      height: 1px;
      background: currentColor;
      transform-origin: center;
      transition: transform 210ms var(--ease-move);
    }

    .menu-btn[aria-expanded="true"] span:first-child { transform: translateY(4px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] span:last-child { transform: translateY(-4px) rotate(-45deg); }
  }

  @media (max-width: 30rem) {
    .brand-claim { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .brand-mark,
    .nav-links > a::after,
    .nav-phone-mark,
    .nav-cta,
    .nav-cta svg,
    .site-nav,
    .menu-btn span { transition: none !important; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const button = header?.querySelector('.menu-btn');
  const navigation = header?.querySelector('#site-nav');
  const mobile = window.matchMedia('(max-width: 56rem)');

  const setMenu = (open) => {
    navigation?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    document.body.classList.toggle('nav-open', open && mobile.matches);
  };

  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      button.focus();
    }
  });
  mobile.addEventListener('change', (event) => {
    if (!event.matches) setMenu(false);
  });
  window.addEventListener('scroll', setScrolled, { passive: true });
  setScrolled();
</script>

<style is:global>
  @media (max-width: 56rem) {
    body.nav-open { overflow: hidden; }
  }
</style>