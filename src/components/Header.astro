---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import logoUrl from '../assets/logo.svg?url';

const nav = [
  { href: withBase('/leistungen/'), label: 'Leistungen' },
  { href: withBase('/referenzen/'), label: 'Referenzen' },
  { href: withBase('/ueber-uns/'), label: 'Über uns' },
  { href: withBase('/kontakt/'), label: 'Kontakt' }
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${settings.marke} – Startseite`}>
      <img class="brand-mark" src={logoUrl} width="449" height="452" alt="" />
      <span class="brand-copy">
        <span class="brand-name">{settings.marke}</span>
        <span class="brand-claim">{settings.claim}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation" id="site-nav">
      <div class="nav-links">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>

      <div class="nav-actions">
        <a class="nav-phone" href={`tel:${settings.telefonLink}`} aria-label={`Anrufen: ${settings.telefon}`}>
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M7.1 2.8 10 7.9 7.7 10a15.1 15.1 0 0 0 6.3 6.3l2.1-2.3 5.1 2.9-.7 3.3c-.2.8-.9 1.4-1.8 1.4A16.4 16.4 0 0 1 2.4 5.3c0-.9.6-1.6 1.4-1.8l3.3-.7Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
          </svg>
          <span>{settings.telefon}</span>
        </a>

        <a class="nav-cta" href={withBase('/kontakt/')}>
          <span>Projekt anfragen</span>
          <svg aria-hidden="true" viewBox="0 0 16 16">
            <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </a>
      </div>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: 5.5rem;
    background: rgba(253, 252, 249, .98);
    border-bottom: 1px solid rgba(28, 29, 31, .11);
    backdrop-filter: blur(16px) saturate(110%);
    -webkit-backdrop-filter: blur(16px) saturate(110%);
    transition: box-shadow 200ms ease, background-color 200ms ease;
  }

  .site-header.is-scrolled {
    background: rgba(253, 252, 249, .995);
    box-shadow: 0 .7rem 2.4rem rgba(28, 29, 31, .07);
  }

  .header-inner {
    position: relative;
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    gap: clamp(1.5rem, 2.8vw, 3rem);
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: .85rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-mark {
    width: 3.15rem;
    height: 3.15rem;
    flex: 0 0 auto;
    object-fit: contain;
    transition: transform 220ms var(--ease-move);
  }

  .brand-copy {
    display: grid;
    gap: .24rem;
    min-width: 0;
  }

  .brand-name {
    color: #17181b;
    font-family: var(--font-brand);
    font-size: 1.28rem;
    font-weight: 680;
    letter-spacing: -.03em;
    line-height: 1;
  }

  .brand-claim {
    color: var(--brass-deep);
    font-family: var(--font-text);
    font-size: .66rem;
    font-weight: 650;
    letter-spacing: .12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1.5rem, 2.5vw, 2.8rem);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1.35rem, 2vw, 2.15rem);
  }

  .nav-links > a {
    position: relative;
    display: inline-flex;
    min-height: 5.5rem;
    align-items: center;
    color: #26282c;
    font-family: var(--font-text);
    font-size: .98rem;
    font-weight: 610;
    letter-spacing: -.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 170ms ease;
  }

  .nav-links > a::after {
    position: absolute;
    right: 50%;
    bottom: -.5px;
    left: 50%;
    height: 2px;
    background: var(--brass);
    content: '';
    transition: right 200ms var(--ease-move), left 200ms var(--ease-move);
  }

  .nav-links > a[aria-current="page"] {
    color: #111214;
  }

  .nav-links > a[aria-current="page"]::after {
    right: 0;
    left: 0;
  }

  .nav-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 1.15rem;
    padding-left: clamp(1.15rem, 1.8vw, 1.6rem);
    border-left: 1px solid rgba(28, 29, 31, .13);
  }

  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: #26282c;
    font-family: var(--font-text);
    font-size: .95rem;
    font-weight: 620;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 170ms ease;
  }

  .nav-phone svg {
    width: 1.08rem;
    height: 1.08rem;
    color: var(--brass-deep);
    flex: 0 0 auto;
  }

  .nav-cta {
    display: inline-flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: center;
    gap: .7rem;
    padding: .82rem 1.25rem .82rem 1.35rem;
    color: #fff;
    background: #191a1d;
    border: 1px solid #191a1d;
    font-family: var(--font-text);
    font-size: .95rem;
    font-weight: 650;
    letter-spacing: -.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 170ms ease, border-color 170ms ease, transform 170ms var(--ease-move);
  }

  .nav-cta svg {
    width: .9rem;
    height: .9rem;
    color: #d9b66f;
    transition: transform 200ms var(--ease-move);
  }

  .menu-btn { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark { transform: scale(1.02); }
    .nav-links > a:hover { color: #111214; }
    .nav-links > a:hover::after { right: 0; left: 0; }
    .nav-phone:hover { color: var(--brass-deep); }
    .nav-cta:hover {
      background: var(--brass-deep);
      border-color: var(--brass-deep);
      transform: translateY(-1px);
    }
    .nav-cta:hover svg { transform: translate(.12rem, -.12rem); }
  }

  @media (max-width: 74rem) {
    .header-inner { gap: 1.5rem; }
    .brand-mark { width: 2.9rem; height: 2.9rem; }
    .brand-name { font-size: 1.18rem; }
    .brand-claim { font-size: .61rem; }
    .nav-links { gap: 1.2rem; }
    .nav-links > a { font-size: .92rem; }
    .nav-actions { gap: .85rem; padding-left: 1rem; }
    .nav-phone { font-size: .88rem; }
    .nav-cta { padding-inline: 1.05rem; font-size: .9rem; }
  }

  @media (max-width: 64rem) {
    .nav-phone span { display: none; }
    .nav-phone svg { width: 1.2rem; height: 1.2rem; }
    .nav-actions { padding-left: .9rem; }
  }

  @media (max-width: 56rem) {
    .site-header,
    .header-inner {
      min-height: 4.75rem;
    }

    .header-inner {
      gap: 1rem;
    }

    .brand { gap: .7rem; }
    .brand-mark { width: 2.65rem; height: 2.65rem; }
    .brand-name { font-size: 1.08rem; }
    .brand-claim { font-size: .56rem; letter-spacing: .1em; }

    .site-nav {
      position: fixed;
      top: 4.75rem;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 3;
      display: grid;
      grid-template-rows: 1fr auto;
      gap: 2rem;
      padding: clamp(2rem, 7vw, 3rem) var(--pad-inline) calc(1.5rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      background: #fdfcf9;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-.4rem);
      transition: opacity 200ms ease, transform 240ms var(--ease-move), visibility 0s linear 240ms;
    }

    .site-nav.open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .nav-links {
      display: grid;
      align-content: start;
      gap: 0;
    }

    .nav-links > a {
      min-height: 4.8rem;
      color: #17181b;
      border-bottom: 1px solid var(--line);
      font-family: var(--font-brand);
      font-size: clamp(1.55rem, 6vw, 2rem);
      font-weight: 620;
      letter-spacing: -.03em;
    }

    .nav-links > a:first-child { border-top: 1px solid var(--line); }

    .nav-links > a::after {
      right: auto;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      transition: width 200ms var(--ease-move);
    }

    .nav-links > a[aria-current="page"]::after { width: 3rem; }

    .nav-actions {
      display: grid;
      gap: 1rem;
      padding: 0;
      border: 0;
    }

    .nav-phone {
      min-height: 3.5rem;
      font-size: 1rem;
    }

    .nav-phone span { display: inline; }

    .nav-cta {
      min-height: 3.8rem;
      justify-content: space-between;
      padding-inline: 1.25rem;
      font-size: 1rem;
    }

    .menu-btn {
      display: grid;
      width: 2.9rem;
      height: 2.9rem;
      margin-left: auto;
      padding: 0;
      place-content: center;
      gap: 6px;
      border: 1px solid rgba(28,29,31,.14);
      color: var(--ink);
      background: transparent;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .menu-btn span {
      width: 1.35rem;
      height: 1px;
      background: currentColor;
      transform-origin: center;
      transition: transform 210ms var(--ease-move);
    }

    .menu-btn[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  }

  @media (max-width: 30rem) {
    .brand-claim { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .brand-mark,
    .nav-links > a::after,
    .nav-cta,
    .nav-cta svg,
    .site-nav,
    .menu-btn span { transition: none !important; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const button = header?.querySelector('.menu-btn');
  const navigation = header?.querySelector('#site-nav');
  const mobile = window.matchMedia('(max-width: 56rem)');

  const setMenu = (open) => {
    navigation?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    document.body.classList.toggle('nav-open', open && mobile.matches);
  };

  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      button.focus();
    }
  });
  mobile.addEventListener('change', (event) => {
    if (!event.matches) setMenu(false);
  });
  window.addEventListener('scroll', setScrolled, { passive: true });
  setScrolled();
</script>

<style is:global>
  @media (max-width: 56rem) {
    body.nav-open { overflow: hidden; }
  }
</style>