---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import logoUrl from '../assets/logo.svg?url';

const nav = [
  { href: withBase('/leistungen/'), label: 'Leistungen' },
  { href: withBase('/referenzen/'), label: 'Referenzen' },
  { href: withBase('/ueber-uns/'), label: 'Über uns' },
  { href: withBase('/kontakt/'), label: 'Kontakt' }
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${settings.marke} – Startseite`}>
      <img class="brand-mark" src={logoUrl} width="449" height="452" alt="" />
      <span class="brand-copy">
        <span class="brand-name">{settings.marke}</span>
        <span class="brand-claim">{settings.claim}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation" id="site-nav">
      <div class="nav-links">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            <span>{item.label}</span>
          </a>
        ))}
      </div>

      <div class="nav-actions">
        <a class="nav-phone" href={`tel:${settings.telefonLink}`} aria-label={`Anrufen: ${settings.telefon}`}>
          <span class="nav-phone-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M7.1 2.8 10 7.9 7.7 10a15.1 15.1 0 0 0 6.3 6.3l2.1-2.3 5.1 2.9-.7 3.3c-.2.8-.9 1.4-1.8 1.4A16.4 16.4 0 0 1 2.4 5.3c0-.9.6-1.6 1.4-1.8l3.3-.7Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
            </svg>
          </span>
          <span class="nav-phone-copy">
            <small>Direkt erreichbar</small>
            <strong>{settings.telefon}</strong>
          </span>
        </a>

        <a class="nav-cta" href={withBase('/kontakt/')}>
          <span>Projekt anfragen</span>
          <svg aria-hidden="true" viewBox="0 0 16 16">
            <path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"/>
          </svg>
        </a>
      </div>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menü öffnen">
      <span></span><span></span>
    </button>
  </div>
  <button class="nav-backdrop" type="button" tabindex="-1" aria-hidden="true" aria-label="Menü schließen"></button>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: 5rem;
    background: rgba(253, 252, 249, .965);
    border-bottom: 1px solid rgba(28, 29, 31, .09);
    box-shadow: 0 0 0 rgba(28, 29, 31, 0);
    backdrop-filter: blur(18px) saturate(115%);
    -webkit-backdrop-filter: blur(18px) saturate(115%);
    transition: box-shadow 220ms ease, background-color 220ms ease;
  }

  .site-header.is-scrolled {
    background: rgba(253, 252, 249, .985);
    box-shadow: 0 .8rem 2.6rem rgba(28, 29, 31, .055);
  }

  .header-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) auto minmax(14rem, 1fr);
    align-items: center;
    min-height: 5rem;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .72rem;
    color: var(--ink);
    line-height: 1;
    text-decoration: none;
  }

  .brand-mark {
    width: 2.62rem;
    height: 2.62rem;
    flex: 0 0 auto;
    object-fit: contain;
    transition: transform 240ms var(--ease-move);
  }

  .brand-copy {
    display: grid;
    gap: .22rem;
    min-width: 0;
  }

  .brand-name {
    color: var(--ink);
    font-family: var(--font-brand) !important;
    font-size: 1.12rem;
    font-weight: 600 !important;
    letter-spacing: -.025em !important;
    line-height: 1;
  }

  .brand-claim {
    color: var(--brass-deep);
    font-family: var(--font-text);
    font-size: .58rem;
    font-weight: 600;
    letter-spacing: .145em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .site-nav {
    display: contents;
  }

  .nav-links {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.4rem, 2.2vw, 2.35rem);
    height: 5rem;
  }

  .nav-links > a {
    position: relative;
    display: inline-flex;
    height: 100%;
    align-items: center;
    color: #42464c;
    font-family: var(--font-text);
    font-size: .82rem;
    font-weight: 550;
    letter-spacing: .005em;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .nav-links > a::after {
    position: absolute;
    right: 50%;
    bottom: -.5px;
    left: 50%;
    height: 2px;
    background: var(--brass);
    content: '';
    transition: right 220ms var(--ease-move), left 220ms var(--ease-move);
  }

  .nav-links > a[aria-current="page"] {
    color: var(--ink);
  }

  .nav-links > a[aria-current="page"]::after {
    right: 0;
    left: 0;
  }

  .nav-actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(.9rem, 1.6vw, 1.4rem);
  }

  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    padding-right: clamp(.9rem, 1.4vw, 1.25rem);
    color: var(--ink);
    border-right: 1px solid rgba(28,29,31,.13);
    text-decoration: none;
  }

  .nav-phone-icon {
    display: grid;
    width: 1.9rem;
    height: 1.9rem;
    place-items: center;
    color: var(--brass-deep);
    border: 1px solid rgba(125,85,24,.2);
    border-radius: 50%;
  }

  .nav-phone-icon svg {
    width: .88rem;
    height: .88rem;
  }

  .nav-phone-copy {
    display: grid;
    gap: .15rem;
    line-height: 1;
  }

  .nav-phone-copy small {
    color: var(--ink-muted);
    font-size: .56rem;
    font-weight: 550;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .nav-phone-copy strong {
    color: var(--ink);
    font-size: .76rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.005em;
  }

  .nav-cta {
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    justify-content: center;
    gap: .72rem;
    padding: .72rem 1rem .72rem 1.15rem;
    color: #fff;
    background: var(--ink);
    border: 1px solid var(--ink);
    font-family: var(--font-text);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .005em;
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease, transform 180ms var(--ease-move);
  }

  .nav-cta svg {
    width: .8rem;
    height: .8rem;
    color: #d6ae67;
    transition: transform 220ms var(--ease-move);
  }

  .menu-btn,
  .nav-backdrop {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark { transform: scale(1.025); }
    .nav-links > a:hover { color: var(--ink); }
    .nav-links > a:hover::after { right: 0; left: 0; }
    .nav-phone:hover .nav-phone-icon { border-color: rgba(125,85,24,.42); }
    .nav-cta:hover {
      background: var(--brass-deep);
      border-color: var(--brass-deep);
      transform: translateY(-1px);
    }
    .nav-cta:hover svg { transform: translate(.12rem, -.12rem); }
  }

  @media (max-width: 72rem) {
    .header-inner {
      grid-template-columns: minmax(12rem, 1fr) auto minmax(10rem, 1fr);
      gap: 1.4rem;
    }

    .nav-links { gap: 1.25rem; }
    .nav-phone-copy { display: none; }
    .nav-phone { padding-right: .85rem; }
  }

  @media (max-width: 60rem) {
    .nav-links { gap: .95rem; }
    .nav-links > a { font-size: .78rem; }
    .nav-phone { display: none; }
  }

  @media (max-width: 56rem) {
    .site-header,
    .header-inner {
      min-height: 4.5rem;
    }

    .header-inner {
      display: flex;
      gap: 1rem;
    }

    .brand { gap: .62rem; }
    .brand-mark { width: 2.42rem; height: 2.42rem; }
    .brand-name { font-size: 1.02rem; }
    .brand-claim { font-size: .53rem; }

    .site-nav {
      position: fixed;
      top: 4.5rem;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 3;
      display: grid;
      grid-template-rows: 1fr auto;
      padding: clamp(2rem, 7vw, 3.5rem) var(--pad-inline) calc(1.5rem + env(safe-area-inset-bottom));
      overflow-y: auto;
      background: #fdfcf9;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-.5rem);
      transition: opacity 220ms ease, transform 260ms var(--ease-move), visibility 0s linear 260ms;
    }

    .site-nav.open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .nav-links {
      display: grid;
      height: auto;
      grid-column: auto;
      align-content: start;
      gap: 0;
    }

    .nav-links > a {
      display: flex;
      min-height: 4.45rem;
      height: auto;
      align-items: center;
      justify-content: space-between;
      color: var(--ink);
      border-bottom: 1px solid var(--line);
      font-family: var(--font-brand);
      font-size: clamp(1.45rem, 6vw, 1.9rem);
      font-weight: 550;
      letter-spacing: -.025em;
    }

    .nav-links > a:first-child { border-top: 1px solid var(--line); }
    .nav-links > a::after {
      position: static;
      width: auto;
      height: auto;
      margin-left: 1rem;
      color: var(--brass-deep);
      background: transparent;
      content: '↗';
      font-family: var(--font-text);
      font-size: .85rem;
      opacity: .65;
    }

    .nav-actions {
      display: grid;
      grid-column: auto;
      gap: 1rem;
      margin-top: 2rem;
    }

    .nav-phone {
      display: flex;
      min-height: 3.75rem;
      padding: 0;
      border: 0;
    }

    .nav-phone-copy { display: grid; }
    .nav-phone-copy small { font-size: .58rem; }
    .nav-phone-copy strong { font-size: .88rem; }

    .nav-cta {
      min-height: 3.65rem;
      justify-content: space-between;
      padding-inline: 1.2rem;
      font-size: .88rem;
    }

    .menu-btn {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      margin-left: auto;
      padding: 0;
      place-content: center;
      gap: 6px;
      border: 0;
      color: var(--ink);
      background: transparent;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .menu-btn span {
      width: 1.35rem;
      height: 1px;
      background: currentColor;
      transform-origin: center;
      transition: transform 220ms var(--ease-move);
    }

    .menu-btn[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .menu-btn[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

    .nav-backdrop { display: none; }
  }

  @media (max-width: 26rem) {
    .brand-claim { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .brand-mark,
    .nav-links > a::after,
    .nav-cta,
    .nav-cta svg,
    .site-nav,
    .menu-btn span { transition: none !important; }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const button = header?.querySelector('.menu-btn');
  const navigation = header?.querySelector('#site-nav');
  const mobile = window.matchMedia('(max-width: 56rem)');

  const setMenu = (open) => {
    navigation?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    document.body.classList.toggle('nav-open', open && mobile.matches);
  };

  const setScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);

  button?.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      button.focus();
    }
  });
  mobile.addEventListener('change', (event) => {
    if (!event.matches) setMenu(false);
  });
  window.addEventListener('scroll', setScrolled, { passive: true });
  setScrolled();
</script>

<style is:global>
  @media (max-width: 56rem) {
    body.nav-open { overflow: hidden; }
  }
</style>
