---
import settings from '../data/settings.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-brand">{settings.marke}</p>
      <p class="footer-firm">{settings.firma}</p>
      <p class="footer-region">{settings.region}</p>
    </div>
    <nav aria-label="Kontakt">
      <h4>Kontakt</h4>
      <ul>
        <li><a href={`tel:${settings.telefonLink}`}>{settings.telefon}</a></li>
        <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
        <li><a href={settings.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
        <li><a href={settings.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
      </ul>
    </nav>
    <nav aria-label="Seiten">
      <h4>Seiten</h4>
      <ul>
        <li><a href="/leistungen/">Leistungen</a></li>
        <li><a href="/referenzen/">Referenzen</a></li>
        <li><a href="/ueber-uns/">Über uns</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
    </nav>
    <nav aria-label="Rechtliches">
      <h4>Rechtliches</h4>
      <ul>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
        <li><a href="/agb/">AGB</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap footer-meta">
    <span>© {year} {settings.firma}</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--paper-inverse); font-size: var(--text-sm); }
  .footer-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: var(--space-4);
    padding-block: var(--space-8) var(--space-4);
  }
  .footer-brand { font-family: var(--font-display); font-size: 1.35rem; }
  .footer-firm { margin-top: .25rem; }
  .footer-region { color: var(--brass); margin-top: .5rem; letter-spacing: .06em; }
  h4 { font-family: var(--font-text); text-transform: uppercase; letter-spacing: .1em; font-size: .75rem; color: rgba(246,244,239,.6); margin-bottom: var(--space-2); }
  ul { list-style: none; padding: 0; display: grid; gap: .5rem; }
  a { text-decoration: none; }
  a:hover { color: var(--brass); }
  .footer-meta { padding-block: var(--space-3); border-top: 1px solid rgba(246,244,239,.15); color: rgba(246,244,239,.6); }
  @media (max-width: 56rem) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 36rem) { .footer-grid { grid-template-columns: 1fr; } }
</style>
