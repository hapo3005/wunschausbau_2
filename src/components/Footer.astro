---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-intro">
      <p class="footer-brand">{settings.marke}</p>
      <p class="footer-firm">{settings.firma}</p>
      <p class="footer-region">{settings.region}</p>
    </div>

    <nav class="footer-contact" aria-label="Kontakt">
      <h4>Kontakt</h4>
      <ul>
        <li>
          <a href={`tel:${settings.telefonLink}`}>
            <span class="footer-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7.1 2.8 10 7.9 7.7 10a15.1 15.1 0 0 0 6.3 6.3l2.1-2.3 5.1 2.9-.7 3.3c-.2.8-.9 1.4-1.8 1.4A16.4 16.4 0 0 1 2.4 5.3c0-.9.6-1.6 1.4-1.8l3.3-.7Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.55"/></svg></span>
            <span>{settings.telefon}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${settings.email}`}>
            <span class="footer-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 5.5h17v13h-17zM4.5 6.5 12 13l7.5-6.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg></span>
            <span>{settings.email}</span>
          </a>
        </li>
        <li>
          <a href={settings.whatsapp} target="_blank" rel="noopener noreferrer">
            <span class="footer-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3.2a8.5 8.5 0 0 0-7.4 12.7L3.5 20.5l4.7-1.2A8.5 8.5 0 1 0 12 3.2Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M8.7 8.2c.2-.4.4-.4.7-.4h.4l.8 2c.1.3.1.5-.1.7l-.6.7c-.2.2-.1.4 0 .6.5.9 1.3 1.7 2.2 2.2.3.2.5.2.7 0l.7-.9c.2-.2.4-.3.7-.2l2 .9c.3.1.4.3.4.5 0 .5-.2 1.4-.7 1.8-.5.5-1.2.7-1.9.7-1.2 0-3.3-.7-5.2-2.6-1.6-1.6-2.5-3.5-2.5-4.8 0-.6.2-1.2.6-1.7.2-.2.4-.4.6-.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.15"/></svg></span>
            <span>WhatsApp</span>
          </a>
        </li>
      </ul>
    </nav>

    <nav aria-label="Seiten">
      <h4>Seiten</h4>
      <ul>
        <li><a href={withBase('/leistungen/')}>Leistungen</a></li>
        <li><a href={withBase('/referenzen/')}>Referenzen</a></li>
        <li><a href={withBase('/ueber-uns/')}>Über uns</a></li>
        <li><a href={withBase('/kontakt/')}>Kontakt</a></li>
      </ul>
    </nav>

    <nav aria-label="Rechtliches">
      <h4>Rechtliches</h4>
      <ul>
        <li><a href={withBase('/impressum/')}>Impressum</a></li>
        <li><a href={withBase('/datenschutz/')}>Datenschutz</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap footer-meta"><span>© {year} {settings.firma}</span></div>
</footer>

<style>
  .site-footer {
    color: #f4f0e9;
    background: #1a1b1e;
    font-size: .88rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(16rem, 1.45fr) minmax(15rem, 1fr) minmax(9rem, .62fr) minmax(9rem, .62fr);
    align-items: start;
    gap: clamp(2.8rem, 6vw, 6.5rem);
    padding-block: clamp(4.75rem, 7vw, 6.5rem) clamp(3.5rem, 5vw, 4.75rem);
  }

  .footer-intro { max-width: 24rem; padding-right: 1rem; }

  .footer-brand {
    margin: 0;
    color: #fff;
    font-family: var(--font-text);
    font-size: clamp(1.45rem, 2vw, 1.72rem);
    font-weight: 680;
    letter-spacing: -.035em;
    line-height: 1;
  }

  .footer-firm {
    margin-top: 1.05rem;
    color: rgba(244,240,233,.82);
    font-size: .84rem;
    line-height: 1.55;
  }

  .footer-region {
    margin-top: .95rem;
    color: #d0a75f;
    font-size: .9rem;
    font-weight: 560;
    letter-spacing: .035em;
    line-height: 1.5;
  }

  h4 {
    margin: .1rem 0 1.35rem;
    color: rgba(244,240,233,.52);
    font-family: var(--font-text);
    font-size: .66rem;
    font-weight: 620;
    letter-spacing: .14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: .38rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    position: relative;
    display: inline-flex;
    width: fit-content;
    min-height: 2.45rem;
    align-items: center;
    gap: .75rem;
    color: rgba(255,255,255,.93);
    font-size: .88rem;
    font-weight: 460;
    line-height: 1.35;
    text-decoration: none;
    transition: color 170ms ease;
  }

  nav:not(.footer-contact) a::after {
    position: absolute;
    right: 0;
    bottom: .28rem;
    left: 0;
    height: 1px;
    background: #d0a75f;
    content: '';
    opacity: 0;
    transform: scaleX(.55);
    transform-origin: left;
    transition: opacity 170ms ease, transform 220ms var(--ease-move);
  }

  .footer-contact ul { gap: .28rem; }
  .footer-contact a { min-height: 2.75rem; }

  .footer-icon {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 auto;
    place-items: center;
    color: #d0a75f;
  }

  .footer-icon svg { width: 1.45rem; height: 1.45rem; }

  .footer-meta {
    padding-block: 1.65rem 1.8rem;
    border-top: 1px solid rgba(244,240,233,.13);
    color: rgba(244,240,233,.56);
    font-size: .77rem;
    letter-spacing: .01em;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover { color: #fff; }
    nav:not(.footer-contact) a:hover::after { opacity: 1; transform: scaleX(1); }
    .footer-contact a:hover .footer-icon { color: #e2bd78; }
  }

  @media (max-width: 62rem) {
    .footer-grid {
      grid-template-columns: minmax(16rem, 1.25fr) 1fr 1fr;
      gap: 3rem 2.5rem;
    }
    .footer-intro { grid-column: 1 / -1; max-width: none; padding-right: 0; }
  }

  @media (max-width: 44rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.2rem 1.25rem;
      padding-block: 3.15rem 2.35rem;
    }

    .footer-intro,
    .footer-contact { grid-column: 1 / -1; }

    .footer-intro {
      display: grid;
      gap: .55rem;
      padding-bottom: .25rem;
    }

    .footer-brand { font-size: 1.42rem; }
    .footer-firm,
    .footer-region { margin-top: 0; }

    h4 { margin-bottom: .8rem; }
    ul { gap: .12rem; }
    a { min-height: 2.15rem; font-size: .86rem; }

    .footer-contact ul { gap: .08rem; }
    .footer-contact a { min-height: 2.45rem; }
    .footer-icon { width: 1.35rem; height: 1.35rem; }
    .footer-icon svg { width: 1.25rem; height: 1.25rem; }

    .footer-meta {
      padding-block: 1.25rem 1.35rem;
      font-size: .72rem;
    }
  }

  @media (max-width: 30rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem 1rem;
      padding-top: 2.8rem;
    }

    .footer-intro,
    .footer-contact { grid-column: 1 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    a,
    nav:not(.footer-contact) a::after { transition: none; }
  }
</style>
