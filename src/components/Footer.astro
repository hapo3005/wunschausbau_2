---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-intro">
      <p class="footer-brand">{settings.marke}</p>
      <p class="footer-firm">{settings.firma}</p>
      <p class="footer-region">{settings.region}</p>
    </div>
    <nav aria-label="Kontakt">
      <h4>Kontakt</h4>
      <ul>
        <li><a href={`tel:${settings.telefonLink}`}>{settings.telefon}</a></li>
        <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
        <li><a href={settings.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
      </ul>
    </nav>
    <nav aria-label="Seiten">
      <h4>Seiten</h4>
      <ul>
        <li><a href={withBase('/leistungen/')}>Leistungen</a></li>
        <li><a href={withBase('/referenzen/')}>Referenzen</a></li>
        <li><a href={withBase('/ueber-uns/')}>Über uns</a></li>
        <li><a href={withBase('/kontakt/')}>Kontakt</a></li>
      </ul>
    </nav>
    <nav aria-label="Rechtliches">
      <h4>Rechtliches</h4>
      <ul>
        <li><a href={withBase('/impressum/')}>Impressum</a></li>
        <li><a href={withBase('/datenschutz/')}>Datenschutz</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap footer-meta">
    <span>© {year} {settings.firma}</span>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--paper-inverse);
    background: var(--ink);
    font-size: var(--text-sm);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 2fr) repeat(3, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    padding-block: var(--space-10) var(--space-6);
  }

  .footer-intro { max-width: 20rem; }
  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -.02em;
  }
  .footer-firm { margin-top: .3rem; color: rgba(246, 244, 239, .78); }
  .footer-region {
    margin-top: .6rem;
    color: var(--brass);
    font-weight: 600;
    letter-spacing: .06em;
  }
  h4 {
    margin-bottom: var(--space-2);
    color: rgba(246, 244, 239, .56);
    font-family: var(--font-text);
    font-size: .72rem;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  ul { display: grid; gap: .2rem; padding: 0; list-style: none; }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--paper-inverse);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .footer-meta {
    padding-block: var(--space-3);
    border-top: 1px solid rgba(246, 244, 239, .15);
    color: rgba(246, 244, 239, .54);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover { color: var(--brass); }
  }

  @media (max-width: 56rem) {
    .footer-grid { grid-template-columns: 1.5fr 1fr 1fr; }
    .footer-intro { grid-column: 1 / -1; }
  }

  @media (max-width: 36rem) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; }
    .footer-grid nav:first-of-type { grid-column: 1 / -1; }
    a { min-height: 2.75rem; }
  }
</style>