---
import { withBase } from '../lib/paths';

interface Props { title?: string; text?: string; }
const {
  title = 'Sie möchten etwas umbauen oder renovieren?',
  text = 'Schicken Sie uns kurz, worum es geht. Wir schauen uns Ihre Anfrage persönlich an und besprechen mit Ihnen die nächsten sinnvollen Schritte.'
} = Astro.props;
---
<section class="section cta-section">
  <div class="wrap cta-band">
    <div class="cta-copy">
      <p class="eyebrow">Ihr Projekt</p>
      <h2>{title}</h2>
    </div>

    <div class="cta-side">
      <p>{text}</p>
      <a class="cta-link" href={withBase('/kontakt/')}>
        <span>Anfrage senden</span>
        <span class="cta-link__icon" aria-hidden="true">
          <svg viewBox="0 0 18 18">
            <path d="M4.75 9h8.5M9.75 5.5 13.25 9l-3.5 3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.45" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: clamp(4.8rem, 7.5vw, 7rem) !important;
    background: #f4f0e8 !important;
    border-top: 1px solid rgba(28,29,31,.09) !important;
    border-bottom: 0 !important;
  }

  .cta-band {
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(19rem, .62fr);
    align-items: center;
    gap: clamp(4rem, 10vw, 10rem);
  }

  .cta-copy {
    max-width: 48rem;
  }

  .cta-copy .eyebrow {
    margin-bottom: 1.2rem;
    color: var(--brass-deep);
  }

  .cta-band h2 {
    max-width: 13ch !important;
    margin: 0;
    color: #17181b;
    font-family: var(--font-text) !important;
    font-size: clamp(3rem, 5.25vw, 5rem) !important;
    font-weight: 650 !important;
    font-variation-settings: 'wght' 650 !important;
    letter-spacing: -.048em !important;
    line-height: .98 !important;
    text-wrap: balance;
  }

  .cta-side {
    display: grid;
    align-self: center;
    gap: clamp(2rem, 3.5vw, 2.8rem);
  }

  .cta-side p {
    max-width: 29rem;
    margin: 0;
    color: #5a5d62;
    font-size: clamp(.98rem, 1.2vw, 1.08rem);
    line-height: 1.75;
  }

  .cta-link {
    display: flex;
    width: min(100%, 29rem);
    min-height: 3.65rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .8rem .8rem .8rem 1.15rem;
    color: #2a2b2e;
    background: rgba(255,255,255,.22);
    border: 1px solid rgba(118,80,29,.42);
    box-shadow: 0 .45rem 1.2rem rgba(48,38,24,.035);
    font-size: .94rem;
    font-weight: 580;
    letter-spacing: -.01em;
    text-decoration: none;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .cta-link__icon {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 auto;
    place-items: center;
    color: #8a6024;
    border-left: 1px solid rgba(118,80,29,.22);
  }

  .cta-link__icon svg {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 220ms var(--ease-move);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-link:hover {
      color: #17181b;
      background: rgba(255,255,255,.48);
      border-color: rgba(118,80,29,.68);
      box-shadow: 0 .7rem 1.7rem rgba(48,38,24,.065);
      transform: translateY(-1px);
    }

    .cta-link:hover .cta-link__icon svg {
      transform: translateX(.16rem);
    }
  }

  @media (max-width: 56rem) {
    .cta-band {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }

    .cta-copy,
    .cta-side,
    .cta-side p {
      max-width: 42rem;
    }

    .cta-link {
      width: min(100%, 34rem);
    }
  }

  @media (max-width: 36rem) {
    .cta-section {
      padding-block: 4rem !important;
    }

    .cta-copy .eyebrow {
      margin-bottom: .9rem;
    }

    .cta-band h2 {
      max-width: 14ch !important;
      font-size: clamp(2.45rem, 11vw, 3.35rem) !important;
    }

    .cta-side {
      gap: 1.7rem;
    }

    .cta-link {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-link,
    .cta-link__icon svg {
      transition: none;
    }
  }
</style>
