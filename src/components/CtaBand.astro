---
import { withBase } from '../lib/paths';

interface Props { title?: string; text?: string; }
const {
  title = 'Lassen Sie uns über Ihr Projekt sprechen.',
  text = 'Kostenlose Erstberatung, ehrliche Einschätzung, Rückmeldung in der Regel innerhalb von 24 Stunden.'
} = Astro.props;
---
<section class="section cta-section">
  <div class="wrap cta-band">
    <div class="cta-copy">
      <p class="eyebrow">Ihr Projekt</p>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <a class="cta-link" href={withBase('/kontakt/')}>
      <span>Projekt unverbindlich anfragen</span>
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    overflow: hidden;
    background: var(--paper);
  }

  .cta-section::before {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(calc(100% - 2 * var(--pad-inline)), var(--content-max));
    height: 1px;
    background: var(--line);
    content: "";
    transform: translateX(-50%);
  }

  .cta-band {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, .75fr);
    align-items: end;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .cta-copy { max-width: 52rem; }
  .cta-band h2 {
    max-width: 18ch;
    font-size: clamp(2.6rem, 5.5vw, 5rem);
    letter-spacing: -.04em;
    line-height: 1.02;
  }

  .cta-band .lead { max-width: 42rem; }

  .cta-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 5.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    font-weight: 650;
    text-decoration: none;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .cta-arrow {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    font-size: 1.35rem;
    transition: transform var(--dur) var(--ease-move), background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-link:hover { color: var(--brass-deep); border-top-color: var(--brass-deep); }
    .cta-link:hover .cta-arrow {
      color: #fff;
      background: var(--brass-deep);
      border-color: var(--brass-deep);
      transform: translateX(.25rem);
    }
  }

  @media (max-width: 56rem) {
    .cta-band { grid-template-columns: 1fr; gap: var(--space-5); }
    .cta-link { max-width: 36rem; }
  }

  @media (max-width: 36rem) {
    .cta-band h2 { font-size: clamp(2.45rem, 11vw, 3.4rem); }
    .cta-link { min-height: 5rem; }
    .cta-arrow { width: 3rem; height: 3rem; }
  }
</style>
