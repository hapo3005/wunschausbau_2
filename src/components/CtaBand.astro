---
import { withBase } from '../lib/paths';

interface Props { title?: string; text?: string; }
const {
  title = 'Sie möchten etwas umbauen oder renovieren?',
  text = 'Schicken Sie uns kurz, worum es geht. Wir melden uns in der Regel innerhalb von 24 Stunden.'
} = Astro.props;
---
<section class="section cta-section">
  <div class="wrap cta-band">
    <div class="cta-copy">
      <p class="eyebrow">Ihr Projekt</p>
      <h2>{title}</h2>
    </div>

    <div class="cta-side">
      <p>{text}</p>
      <a class="cta-link" href={withBase('/kontakt/')}>
        <span>Anfrage senden</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--sand);
    border-top: 1px solid var(--line);
  }

  .cta-band {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, .75fr);
    align-items: end;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .cta-copy { max-width: 50rem; }

  .cta-band h2 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 520;
    letter-spacing: -.02em;
    line-height: 1.055;
  }

  .cta-side {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-self: end;
  }

  .cta-side p {
    max-width: 34rem;
    color: var(--ink-soft);
    line-height: 1.72;
  }

  .cta-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .8rem;
    padding-bottom: .45rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    font-size: .96rem;
    font-weight: 650;
    letter-spacing: -.01em;
    text-decoration: none;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease), gap var(--dur) var(--ease-move);
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-link:hover {
      gap: 1.05rem;
      color: var(--brass-deep);
      border-color: var(--brass-deep);
    }
  }

  @media (max-width: 56rem) {
    .cta-band { grid-template-columns: 1fr; gap: var(--space-5); }
    .cta-side { max-width: 38rem; }
  }

  @media (max-width: 36rem) {
    .cta-band h2 { font-size: clamp(2.3rem, 10vw, 3.25rem); }
  }
</style>
