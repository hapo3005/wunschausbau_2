---
import stimmen from '../data/kundenstimmen.json';
import settings from '../data/settings.json';

const [leitstimme, ...weitereStimmen] = stimmen;
---
<section class="section section--dark testimonials" aria-labelledby="stimmen-titel">
  <div class="wrap">
    <div class="stimmen-head">
      <div>
        <p class="eyebrow">Kundenstimmen</p>
        <h2 id="stimmen-titel">Gute Arbeit spricht sich herum.</h2>
      </div>
      <p class="rating"><strong>{settings.stats.bewertung}</strong><span>Google-Bewertung</span></p>
    </div>

    <div class="stimmen-layout">
      <figure class="leitstimme reveal">
        <blockquote>„{leitstimme.text}“</blockquote>
        <figcaption>{leitstimme.name} · {leitstimme.ort}</figcaption>
      </figure>

      <div class="weitere-stimmen">
        {weitereStimmen.map((stimme, index) => (
          <figure class="stimme reveal" style={`--reveal-delay: ${(index + 1) * 60}ms`}>
            <blockquote>„{stimme.text}“</blockquote>
            <figcaption>{stimme.name} · {stimme.ort}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--ink);
  }

  .stimmen-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
  }

  .stimmen-head h2 {
    max-width: 15ch;
    font-size: clamp(2.35rem, 4.5vw, 4rem);
  }

  .rating {
    display: flex;
    align-items: baseline;
    gap: .7rem;
    padding-bottom: .25rem;
    white-space: nowrap;
  }

  .rating strong {
    color: var(--paper-inverse);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.8vw, 2.25rem);
    font-weight: 560;
    line-height: 1;
  }

  .rating span {
    color: rgba(246, 244, 239, .55);
    font-size: .72rem;
    font-weight: 650;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .stimmen-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, .75fr);
    gap: clamp(3rem, 8vw, 8rem);
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid rgba(246, 244, 239, .2);
  }

  figure { margin: 0; }

  .leitstimme {
    display: grid;
    min-height: clamp(18rem, 28vw, 24rem);
    align-content: space-between;
    gap: var(--space-4);
    padding: clamp(2.5rem, 5vw, 4rem) 0 0;
  }

  .leitstimme blockquote {
    max-width: 25ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    letter-spacing: -.018em;
    line-height: 1.28;
  }

  .weitere-stimmen {
    display: grid;
    align-content: start;
  }

  .stimme {
    display: grid;
    min-height: 10.5rem;
    align-content: space-between;
    gap: var(--space-3);
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    border-bottom: 1px solid rgba(246, 244, 239, .16);
  }

  .stimme + .stimme { padding-top: clamp(2rem, 4vw, 3rem); }

  .stimme blockquote {
    margin: 0;
    color: rgba(246, 244, 239, .78);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.5vw, 1.38rem);
    line-height: 1.55;
  }

  figcaption {
    color: var(--brass);
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: .035em;
  }

  @media (max-width: 56rem) {
    .stimmen-head,
    .stimmen-layout { grid-template-columns: 1fr; }
    .rating { justify-self: start; }
    .stimmen-layout { gap: 0; }
    .leitstimme { min-height: 16rem; padding-bottom: 2.5rem; }
    .weitere-stimmen { border-top: 1px solid rgba(246, 244, 239, .16); }
  }

  @media (max-width: 36rem) {
    .stimmen-head h2 { font-size: clamp(2.2rem, 10vw, 3rem); }
    .leitstimme blockquote { font-size: clamp(1.65rem, 7.5vw, 2.2rem); }
    .rating { display: grid; gap: .2rem; }
  }
</style>
