---
const score = '5,0';
const reviewCount = '13';
---
<section class="testimonials" aria-labelledby="stimmen-titel">
  <div class="wrap testimonials-inner">
    <header class="proof-head">
      <div>
        <p class="eyebrow">Bewertungen</p>
        <h2 id="stimmen-titel">Vertrauen entsteht nicht durch Versprechen.</h2>
      </div>
      <p class="proof-intro">
        Entscheidend ist, wie ein Handwerker arbeitet, kommuniziert und eine Baustelle hinterlässt.
        Dafür gibt es bereits öffentliches Feedback, das nicht von uns formuliert wurde.
      </p>
    </header>

    <div class="proof-stage">
      <div class="score-card" aria-label={`${score} von 5 bei ${reviewCount} Bewertungen auf MyHammer`}>
        <span class="score-card__source">MyHammer</span>
        <div class="score-card__value"><strong>{score}</strong><span>/ 5</span></div>
        <div class="score-card__stars" aria-hidden="true">★★★★★</div>
        <p><strong>{reviewCount} Bewertungen</strong><span>öffentlich einsehbarer Stand · August 2026</span></p>
      </div>

      <figure class="review-card reveal">
        <span class="review-card__mark" aria-hidden="true">“</span>
        <blockquote>
          Sehr schnelle Rückmeldung und Terminvereinbarung. Zuverlässig und super Hilfe bei der Reparatur unserer Jalousien.
        </blockquote>
        <figcaption>
          <strong>Verifizierte Kundenbewertung</strong>
          <span>MyHammer · 15. Juli 2026</span>
        </figcaption>
      </figure>
    </div>

    <div class="proof-principles" aria-label="Unser Anspruch in der Zusammenarbeit">
      <p><strong>Persönlich</strong><span>Direkte Abstimmung statt anonymer Projektkette.</span></p>
      <p><strong>Nachvollziehbar</strong><span>Details und Ablauf werden vor Beginn geklärt.</span></p>
      <p><strong>Sauber</strong><span>Das Ergebnis zählt – genauso wie der Weg dorthin.</span></p>
    </div>
  </div>
</section>

<style>
  .testimonials {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 8vw, 7.5rem);
    color: #f7f4ee;
    background: #1c1d1f;
  }

  .testimonials::before {
    position: absolute;
    top: -16rem;
    right: -10rem;
    width: 34rem;
    height: 34rem;
    border: 1px solid rgba(210,171,101,.12);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .testimonials-inner {
    position: relative;
    display: grid;
    gap: clamp(2.75rem, 5vw, 4.5rem);
  }

  .proof-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .72fr);
    align-items: end;
    gap: clamp(2.5rem, 8vw, 8rem);
  }

  .testimonials .eyebrow { color: #d2ab65; }

  .proof-head h2 {
    max-width: 15ch;
    margin: 0;
    color: #fff;
    font-size: clamp(2.45rem, 4.4vw, 4rem);
    font-weight: 600;
    line-height: .99;
    letter-spacing: -.035em;
  }

  .proof-intro {
    max-width: 31rem;
    color: rgba(247,244,238,.67);
    line-height: 1.72;
  }

  .proof-stage {
    display: grid;
    grid-template-columns: minmax(17rem, .62fr) minmax(0, 1.38fr);
    min-height: clamp(24rem, 34vw, 32rem);
    border-top: 1px solid rgba(247,244,238,.18);
    border-bottom: 1px solid rgba(247,244,238,.18);
  }

  .score-card {
    display: grid;
    align-content: center;
    padding: clamp(2rem, 4vw, 3.4rem) clamp(2rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3.4rem) 0;
    border-right: 1px solid rgba(247,244,238,.14);
  }

  .score-card__source {
    color: #d2ab65;
    font-size: .68rem;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .score-card__value {
    display: flex;
    align-items: baseline;
    gap: .45rem;
    margin-top: 1.2rem;
  }

  .score-card__value strong {
    font-family: var(--font-brand);
    font-size: clamp(4.4rem, 8vw, 7.4rem);
    font-weight: 600;
    line-height: .82;
    letter-spacing: -.055em;
  }

  .score-card__value span { color: rgba(247,244,238,.48); font-size: .9rem; }

  .score-card__stars {
    margin-top: 1.35rem;
    color: #d2ab65;
    font-size: .8rem;
    letter-spacing: .24em;
  }

  .score-card p {
    display: grid;
    gap: .25rem;
    margin-top: 1.25rem;
    font-size: .82rem;
  }

  .score-card p strong { font-weight: 600; }
  .score-card p span { color: rgba(247,244,238,.46); font-size: .7rem; }

  .review-card {
    position: relative;
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 3vw, 2.2rem);
    min-width: 0;
    margin: 0;
    padding: clamp(2.5rem, 6vw, 5.5rem);
  }

  .review-card__mark {
    position: absolute;
    top: clamp(1.7rem, 4vw, 3rem);
    right: clamp(2rem, 5vw, 4rem);
    color: rgba(210,171,101,.22);
    font-family: var(--font-brand);
    font-size: clamp(6rem, 11vw, 10rem);
    line-height: .7;
  }

  blockquote {
    position: relative;
    z-index: 1;
    max-width: 28ch;
    margin: 0;
    color: #fff;
    font-family: var(--font-brand);
    font-size: clamp(1.7rem, 3.1vw, 2.9rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -.025em;
  }

  figcaption {
    display: grid;
    gap: .25rem;
    color: rgba(247,244,238,.48);
    font-size: .72rem;
  }

  figcaption strong { color: #d2ab65; font-weight: 600; }

  .proof-principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .proof-principles p {
    display: grid;
    gap: .45rem;
    max-width: 24rem;
  }

  .proof-principles strong { color: #fff; font-size: .95rem; font-weight: 600; }
  .proof-principles span { color: rgba(247,244,238,.55); font-size: .78rem; line-height: 1.6; }

  @media (max-width: 56rem) {
    .proof-head,
    .proof-stage {
      grid-template-columns: 1fr;
    }

    .proof-head { align-items: start; gap: 1.5rem; }

    .proof-stage { min-height: 0; }

    .score-card {
      padding: 2.4rem 0;
      border-right: 0;
      border-bottom: 1px solid rgba(247,244,238,.14);
    }

    .review-card { padding: clamp(2.4rem, 7vw, 4.5rem) 0; }
  }

  @media (max-width: 40rem) {
    .proof-principles { grid-template-columns: 1fr; gap: 1.5rem; }
    .review-card__mark { right: 0; }
    blockquote { font-size: clamp(1.55rem, 7vw, 2rem); }
  }
</style>
