---
import stimmen from '../data/kundenstimmen.json';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
---
<section class="testimonials" aria-labelledby="stimmen-titel">
  <div class="wrap testimonials-inner">
    <header class="testimonials-head">
      <div class="testimonials-title">
        <p class="eyebrow">Kundenstimmen</p>
        <h2 id="stimmen-titel">Erfahrung, die Vertrauen schafft.</h2>
      </div>

      <div class="trust-score" aria-label={`Google-Bewertung ${settings.stats.bewertung}`}>
        <strong>{settings.stats.bewertung}</strong>
        <span class="trust-star" aria-hidden="true">★</span>
        <span class="trust-label">Google-Bewertung</span>
      </div>
    </header>

    <div class="testimonials-grid">
      {stimmen.map((stimme, index) => (
        <figure class="testimonial reveal" style={`--reveal-delay: ${index * 55}ms`}>
          <div class="stars" aria-label="5 von 5 Sternen">★★★★★</div>
          <blockquote>„{stimme.text}“</blockquote>
          <figcaption>
            <strong>{stimme.name}</strong>
            <span>{stimme.ort}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <footer class="testimonials-foot">
      <p>Saubere Arbeit. Verlässliche Kommunikation. Ergebnisse, die weiterempfohlen werden.</p>
      <a href={withBase('/referenzen/')} class="reference-link">
        Referenzen ansehen <span aria-hidden="true">→</span>
      </a>
    </footer>
  </div>
</section>

<style>
  .testimonials {
    padding-block: clamp(4.25rem, 6.5vw, 6rem);
    color: var(--ink);
    background: #f5f1e9;
    border-block: 1px solid var(--line);
  }

  .testimonials-inner {
    display: grid;
    gap: clamp(2.6rem, 5vw, 4.25rem);
  }

  .testimonials-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .testimonials-title h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.35rem, 4vw, 3.65rem);
    line-height: .99;
  }

  .trust-score {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    align-items: baseline;
    column-gap: .45rem;
    min-width: 13rem;
    padding: 0 0 .35rem;
  }

  .trust-score strong {
    font-family: var(--font-brand);
    font-size: clamp(2rem, 3vw, 2.7rem);
    font-weight: 600;
    line-height: .9;
    letter-spacing: -.025em;
  }

  .trust-star {
    color: var(--brass-deep);
    font-size: 1.15rem;
  }

  .trust-label {
    grid-column: 1 / -1;
    margin-top: .55rem;
    color: var(--ink-muted);
    font-size: .69rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(28,29,31,.22);
    border-bottom: 1px solid rgba(28,29,31,.14);
  }

  .testimonial {
    display: grid;
    min-width: 0;
    min-height: 18.5rem;
    align-content: space-between;
    gap: 1.5rem;
    margin: 0;
    padding: clamp(1.8rem, 3vw, 2.6rem) clamp(1.5rem, 3vw, 2.5rem) clamp(1.75rem, 3vw, 2.35rem);
  }

  .testimonial:first-child { padding-left: 0; }
  .testimonial:last-child { padding-right: 0; }

  .testimonial + .testimonial {
    border-left: 1px solid rgba(28,29,31,.12);
  }

  .stars {
    width: fit-content;
    color: var(--brass-deep);
    font-size: .72rem;
    letter-spacing: .14em;
  }

  blockquote {
    max-width: 29ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-text);
    font-size: clamp(1.12rem, 1.55vw, 1.38rem);
    font-weight: 430;
    line-height: 1.55;
    letter-spacing: -.012em;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .4rem .65rem;
    color: var(--ink-soft);
    font-size: .82rem;
  }

  figcaption strong {
    color: var(--ink);
    font-weight: 600;
  }

  figcaption span::before {
    margin-right: .65rem;
    color: var(--brass);
    content: '·';
  }

  .testimonials-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
  }

  .testimonials-foot p {
    max-width: 44rem;
    color: var(--ink-soft);
    font-size: .92rem;
    line-height: 1.65;
  }

  .reference-link {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding-bottom: .3rem;
    border-bottom: 1px solid rgba(28,29,31,.62);
    color: var(--ink);
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap var(--dur) var(--ease-move), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .reference-link:hover {
      gap: .8rem;
      color: var(--brass-deep);
      border-color: var(--brass-deep);
    }
  }

  @media (max-width: 56rem) {
    .testimonials-head {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.6rem;
    }

    .trust-score { min-width: 0; }

    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .testimonial,
    .testimonial:first-child,
    .testimonial:last-child {
      min-height: 0;
      padding: 1.8rem 0;
    }

    .testimonial + .testimonial {
      border-top: 1px solid rgba(28,29,31,.12);
      border-left: 0;
    }

    blockquote { max-width: 40rem; }

    .testimonials-foot {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .reference-link { width: fit-content; }
  }

  @media (max-width: 36rem) {
    .testimonials {
      padding-block: 3.75rem;
    }

    .testimonials-title h2 {
      font-size: clamp(2.2rem, 10vw, 3rem);
    }

    blockquote {
      font-size: 1.05rem;
      line-height: 1.6;
    }
  }
</style>
