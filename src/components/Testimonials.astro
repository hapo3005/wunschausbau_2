---
const score = '5,0';
const reviewCount = '13';
const myHammerUrl = 'https://www.my-hammer.de/auftragnehmer/ks-innenausbau-3';
---
<section class="testimonials" aria-labelledby="stimmen-titel">
  <div class="wrap testimonials-inner">
    <header class="proof-head reveal">
      <div class="proof-head__title">
        <p class="eyebrow">Bewertungen</p>
        <h2 id="stimmen-titel">Vertrauen zeigt sich im Ergebnis.</h2>
      </div>

      <div class="proof-head__copy">
        <p>
          Wie Zusammenarbeit wirklich funktioniert, zeigen nicht unsere Worte,
          sondern die Erfahrungen unserer Kunden.
        </p>
        <a class="proof-source" href={myHammerUrl} target="_blank" rel="noopener noreferrer">
          Alle Bewertungen bei MyHammer <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="proof-panel reveal" style="--reveal-delay: 55ms">
      <aside class="proof-score" aria-label={`${score} von 5 bei ${reviewCount} Bewertungen auf MyHammer`}>
        <div class="proof-score__top">
          <span class="proof-score__source">MyHammer</span>
          <span class="proof-score__date">Stand · August 2026</span>
        </div>

        <div class="proof-score__rating">
          <strong>{score}</strong>
          <span>/ 5</span>
        </div>

        <div class="proof-score__footer">
          <span class="proof-score__stars" aria-hidden="true">★★★★★</span>
          <strong>{reviewCount} Bewertungen</strong>
        </div>
      </aside>

      <figure class="proof-quote">
        <blockquote>
          „Sehr schnelle Rückmeldung und Terminvereinbarung. Zuverlässig und super Hilfe bei der Reparatur unserer Jalousien.“
        </blockquote>
        <figcaption>
          <strong>Öffentliche Bewertung auf MyHammer</strong>
          <span>15. Juli 2026</span>
        </figcaption>
      </figure>
    </div>

    <div class="proof-principles reveal" style="--reveal-delay: 90ms" aria-label="Unser Anspruch in der Zusammenarbeit">
      <p><strong>Persönlich</strong><span>Direkte Abstimmung statt anonymer Projektkette.</span></p>
      <p><strong>Nachvollziehbar</strong><span>Details und Ablauf werden vor Beginn geklärt.</span></p>
      <p><strong>Sauber</strong><span>Das Ergebnis zählt – genauso wie der Weg dorthin.</span></p>
    </div>
  </div>
</section>

<style>
  .testimonials {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 6.8vw, 6.5rem);
    color: var(--ink);
    background: #f3eee5;
    border-block: 1px solid var(--line);
  }

  .testimonials::before {
    position: absolute;
    top: -12rem;
    right: -8rem;
    width: 27rem;
    height: 27rem;
    border: 1px solid rgba(185,133,56,.11);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .testimonials-inner {
    position: relative;
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.25rem);
  }

  .proof-head {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, .75fr);
    align-items: end;
    gap: clamp(2.25rem, 7vw, 7rem);
  }

  .proof-head__title { max-width: 42rem; }
  .testimonials .eyebrow { color: var(--brass-deep); }

  .proof-head h2 {
    max-width: 12ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.5rem, 3.9vw, 3.55rem);
    font-weight: 600;
    line-height: .98;
    letter-spacing: -.038em;
    text-wrap: balance;
  }

  .proof-head__copy {
    display: grid;
    justify-items: start;
    gap: 1.15rem;
    padding-bottom: .12rem;
  }

  .proof-head__copy p {
    max-width: 29rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(.96rem, 1.15vw, 1.05rem);
    line-height: 1.68;
  }

  .proof-source {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .52rem;
    padding-bottom: .28rem;
    color: var(--ink);
    border-bottom: 1px solid rgba(28,29,31,.32);
    font-size: .82rem;
    font-weight: 650;
    text-decoration: none;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease), gap var(--dur) var(--ease-move);
  }

  .proof-panel {
    display: grid;
    grid-template-columns: minmax(15rem, .72fr) minmax(0, 1.28fr);
    min-height: clamp(19rem, 25vw, 23rem);
    overflow: hidden;
    background: rgba(255,255,255,.25);
    border: 1px solid rgba(28,29,31,.13);
  }

  .proof-score {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-width: 0;
    padding: clamp(1.55rem, 3vw, 2.35rem);
    border-right: 1px solid rgba(28,29,31,.13);
    background: rgba(255,255,255,.16);
  }

  .proof-score__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .proof-score__source {
    color: var(--brass-deep);
    font-size: .66rem;
    font-weight: 680;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .proof-score__date {
    color: var(--ink-muted);
    font-size: .66rem;
    line-height: 1.35;
  }

  .proof-score__rating {
    display: flex;
    align-self: center;
    align-items: baseline;
    gap: .42rem;
    padding-block: 1rem;
  }

  .proof-score__rating strong {
    color: var(--ink);
    font-family: var(--font-brand);
    font-size: clamp(3.75rem, 6.4vw, 5.75rem);
    font-weight: 600;
    line-height: .82;
    letter-spacing: -.055em;
  }

  .proof-score__rating span {
    color: var(--ink-muted);
    font-size: .88rem;
  }

  .proof-score__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(28,29,31,.12);
  }

  .proof-score__stars {
    color: var(--brass);
    font-size: .72rem;
    letter-spacing: .16em;
    white-space: nowrap;
  }

  .proof-score__footer strong {
    color: var(--ink);
    font-size: .78rem;
    font-weight: 620;
    white-space: nowrap;
  }

  .proof-quote {
    position: relative;
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 2.5vw, 2rem);
    min-width: 0;
    margin: 0;
    padding: clamp(2.25rem, 4.5vw, 4.25rem);
  }

  .proof-quote::before {
    position: absolute;
    top: clamp(1.35rem, 2.5vw, 2rem);
    right: clamp(1.5rem, 3vw, 2.75rem);
    color: rgba(185,133,56,.14);
    content: '“';
    font-family: var(--font-brand);
    font-size: clamp(4.2rem, 7vw, 6.5rem);
    line-height: .72;
    pointer-events: none;
  }

  .proof-quote blockquote {
    position: relative;
    z-index: 1;
    max-width: 29ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-brand);
    font-size: clamp(1.5rem, 2.35vw, 2.2rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -.024em;
  }

  .proof-quote figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem .8rem;
    color: var(--ink-muted);
    font-size: .72rem;
    line-height: 1.45;
  }

  .proof-quote figcaption strong {
    color: var(--brass-deep);
    font-weight: 620;
  }

  .proof-principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 3rem);
  }

  .proof-principles p {
    display: grid;
    gap: .38rem;
    margin: 0;
    padding-top: .95rem;
    border-top: 1px solid rgba(28,29,31,.14);
  }

  .proof-principles strong {
    color: var(--ink);
    font-size: .9rem;
    font-weight: 620;
  }

  .proof-principles span {
    max-width: 23rem;
    color: var(--ink-soft);
    font-size: .76rem;
    line-height: 1.55;
  }

  @media (hover: hover) and (pointer: fine) {
    .proof-source:hover {
      gap: .72rem;
      color: var(--brass-deep);
      border-color: var(--brass-deep);
    }
  }

  @media (max-width: 56rem) {
    .testimonials { padding-block: 4rem; }
    .testimonials-inner { gap: 2rem; }

    .proof-head {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.15rem;
    }

    .proof-head h2 { max-width: 13ch; }
    .proof-panel { grid-template-columns: minmax(13rem, .78fr) minmax(0, 1.22fr); }
    .proof-score__top { display: grid; gap: .25rem; }
    .proof-score__footer { display: grid; justify-content: start; gap: .5rem; }
  }

  @media (max-width: 40rem) {
    .testimonials { padding-block: 3.35rem; }
    .testimonials-inner { gap: 1.65rem; }

    .proof-head h2 {
      max-width: 12ch;
      font-size: clamp(2.08rem, 9vw, 2.6rem);
      line-height: .98;
    }

    .proof-head__copy p { font-size: .94rem; line-height: 1.6; }
    .proof-source { font-size: .78rem; }

    .proof-panel { grid-template-columns: 1fr; min-height: 0; }

    .proof-score {
      min-height: 12.5rem;
      padding: 1.35rem 1.25rem;
      border-right: 0;
      border-bottom: 1px solid rgba(28,29,31,.13);
    }

    .proof-score__top { display: flex; gap: .75rem; }
    .proof-score__rating { padding-block: .9rem; }
    .proof-score__rating strong { font-size: clamp(3.4rem, 15vw, 4.15rem); }

    .proof-score__footer {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      padding-top: .75rem;
    }

    .proof-quote {
      gap: 1.1rem;
      padding: 1.55rem 1.25rem 1.7rem;
    }

    .proof-quote::before { top: .9rem; right: 1rem; font-size: 4.2rem; }

    .proof-quote blockquote {
      max-width: 100%;
      padding-right: .5rem;
      font-size: clamp(1.28rem, 6vw, 1.62rem);
      line-height: 1.18;
    }

    .proof-quote figcaption { display: grid; gap: .2rem; }

    .proof-principles {
      grid-template-columns: 1fr;
      gap: .85rem;
    }

    .proof-principles p { gap: .25rem; padding-top: .75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-source { transition: none; }
  }
</style>
