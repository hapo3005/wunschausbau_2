---
const score = '5,0';
const reviewCount = '13';
const myHammerUrl = 'https://www.my-hammer.de/auftragnehmer/ks-innenausbau-3';
---
<section class="testimonials" aria-labelledby="stimmen-titel">
  <div class="wrap testimonials-inner">
    <header class="proof-head">
      <div>
        <p class="eyebrow">Bewertungen</p>
        <h2 id="stimmen-titel">Vertrauen entsteht nicht durch Versprechen.</h2>
      </div>
      <div class="proof-intro-wrap">
        <p class="proof-intro">
          Entscheidend ist, wie ein Handwerker arbeitet, kommuniziert und eine Baustelle hinterlässt.
          Dafür gibt es bereits öffentliches Feedback, das nicht von uns formuliert wurde.
        </p>
        <a class="proof-source" href={myHammerUrl} target="_blank" rel="noopener noreferrer">
          Bewertungen bei MyHammer ansehen <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="proof-stage">
      <div class="score-card" aria-label={`${score} von 5 bei ${reviewCount} Bewertungen auf MyHammer`}>
        <span class="score-card__source">MyHammer</span>
        <div class="score-card__value"><strong>{score}</strong><span>/ 5</span></div>
        <div class="score-card__stars" aria-hidden="true">★★★★★</div>
        <p><strong>{reviewCount} Bewertungen</strong><span>öffentlich einsehbarer Stand · August 2026</span></p>
      </div>

      <figure class="review-card reveal">
        <span class="review-card__mark" aria-hidden="true">“</span>
        <blockquote>
          Sehr schnelle Rückmeldung und Terminvereinbarung. Zuverlässig und super Hilfe bei der Reparatur unserer Jalousien.
        </blockquote>
        <figcaption>
          <strong>Öffentliche Bewertung auf MyHammer</strong>
          <span>15. Juli 2026</span>
        </figcaption>
      </figure>
    </div>

    <div class="proof-principles" aria-label="Unser Anspruch in der Zusammenarbeit">
      <p><strong>Persönlich</strong><span>Direkte Abstimmung statt anonymer Projektkette.</span></p>
      <p><strong>Nachvollziehbar</strong><span>Details und Ablauf werden vor Beginn geklärt.</span></p>
      <p><strong>Sauber</strong><span>Das Ergebnis zählt – genauso wie der Weg dorthin.</span></p>
    </div>
  </div>
</section>

<style>
  .testimonials {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 8vw, 7.5rem);
    color: var(--ink);
    background: #f3eee5;
    border-block: 1px solid var(--line);
  }

  .testimonials::before {
    position: absolute;
    top: -16rem;
    right: -10rem;
    width: 34rem;
    height: 34rem;
    border: 1px solid rgba(185,133,56,.13);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .testimonials-inner {
    position: relative;
    display: grid;
    gap: clamp(2.75rem, 5vw, 4.5rem);
  }

  .proof-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .72fr);
    align-items: end;
    gap: clamp(2.5rem, 8vw, 8rem);
  }

  .testimonials .eyebrow { color: var(--brass-deep); }

  .proof-head h2 {
    max-width: 15ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.45rem, 4.4vw, 4rem);
    font-weight: 600;
    line-height: .99;
    letter-spacing: -.035em;
  }

  .proof-intro-wrap {
    display: grid;
    gap: 1.25rem;
  }

  .proof-intro {
    max-width: 31rem;
    color: var(--ink-soft);
    line-height: 1.72;
  }

  .proof-source {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .55rem;
    padding-bottom: .3rem;
    color: var(--ink);
    border-bottom: 1px solid rgba(28,29,31,.34);
    font-size: .82rem;
    font-weight: 650;
    text-decoration: none;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease), gap var(--dur) var(--ease-move);
  }

  .proof-stage {
    display: grid;
    grid-template-columns: minmax(17rem, .62fr) minmax(0, 1.38fr);
    min-height: clamp(24rem, 34vw, 32rem);
    border-top: 1px solid rgba(28,29,31,.18);
    border-bottom: 1px solid rgba(28,29,31,.18);
  }

  .score-card {
    display: grid;
    align-content: center;
    padding: clamp(2rem, 4vw, 3.4rem) clamp(2rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3.4rem) 0;
    border-right: 1px solid rgba(28,29,31,.14);
  }

  .score-card__source {
    color: var(--brass-deep);
    font-size: .68rem;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .score-card__value {
    display: flex;
    align-items: baseline;
    gap: .45rem;
    margin-top: 1.2rem;
  }

  .score-card__value strong {
    color: var(--ink);
    font-family: var(--font-brand);
    font-size: clamp(4.4rem, 8vw, 7.4rem);
    font-weight: 600;
    line-height: .82;
    letter-spacing: -.055em;
  }

  .score-card__value span { color: var(--ink-muted); font-size: .9rem; }

  .score-card__stars {
    margin-top: 1.35rem;
    color: var(--brass);
    font-size: .8rem;
    letter-spacing: .24em;
  }

  .score-card p {
    display: grid;
    gap: .25rem;
    margin-top: 1.25rem;
    font-size: .82rem;
  }

  .score-card p strong { color: var(--ink); font-weight: 600; }
  .score-card p span { color: var(--ink-muted); font-size: .7rem; }

  .review-card {
    position: relative;
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 3vw, 2.2rem);
    min-width: 0;
    margin: 0;
    padding: clamp(2.5rem, 6vw, 5.5rem);
  }

  .review-card__mark {
    position: absolute;
    top: clamp(1.7rem, 4vw, 3rem);
    right: clamp(2rem, 5vw, 4rem);
    color: rgba(185,133,56,.18);
    font-family: var(--font-brand);
    font-size: clamp(6rem, 11vw, 10rem);
    line-height: .7;
  }

  blockquote {
    position: relative;
    z-index: 1;
    max-width: 28ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-brand);
    font-size: clamp(1.7rem, 3.1vw, 2.9rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -.025em;
  }

  figcaption {
    display: grid;
    gap: .25rem;
    color: var(--ink-muted);
    font-size: .72rem;
  }

  figcaption strong { color: var(--brass-deep); font-weight: 600; }

  .proof-principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .proof-principles p {
    display: grid;
    gap: .45rem;
    max-width: 24rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(28,29,31,.14);
  }

  .proof-principles strong { color: var(--ink); font-size: .95rem; font-weight: 600; }
  .proof-principles span { color: var(--ink-soft); font-size: .78rem; line-height: 1.6; }

  @media (hover: hover) and (pointer: fine) {
    .proof-source:hover {
      gap: .75rem;
      color: var(--brass-deep);
      border-color: var(--brass-deep);
    }
  }

  @media (max-width: 56rem) {
    .testimonials { padding-block: 4rem; }
    .testimonials-inner { gap: 2.35rem; }

    .proof-head,
    .proof-stage { grid-template-columns: 1fr; }

    .proof-head { align-items: start; gap: 1.35rem; }
    .proof-stage { min-height: 0; }

    .score-card {
      padding: 2rem 0;
      border-right: 0;
      border-bottom: 1px solid rgba(28,29,31,.14);
    }

    .review-card { padding: 2.35rem 0; }
  }

  @media (max-width: 40rem) {
    .testimonials { padding-block: 3.4rem; }
    .testimonials-inner { gap: 1.9rem; }
    .proof-head { gap: 1.1rem; }
    .proof-head h2 {
      max-width: 12ch;
      font-size: clamp(2.15rem, 9.5vw, 2.75rem);
      line-height: .98;
    }
    .proof-intro { font-size: .96rem; line-height: 1.62; }
    .proof-source { font-size: .8rem; }

    .score-card { padding: 1.65rem 0 1.8rem; }
    .score-card__value { margin-top: .8rem; }
    .score-card__value strong { font-size: clamp(3.6rem, 16vw, 4.4rem); }
    .score-card__stars { margin-top: .9rem; }
    .score-card p { margin-top: .9rem; }

    .review-card {
      gap: 1.25rem;
      padding: 1.9rem 0 2rem;
    }
    .review-card__mark { top: 1.2rem; right: 0; font-size: 5.5rem; }
    blockquote { max-width: 30ch; font-size: clamp(1.42rem, 6.5vw, 1.82rem); line-height: 1.16; }

    .proof-principles { grid-template-columns: 1fr; gap: 1rem; }
    .proof-principles p { gap: .3rem; padding-top: .85rem; }
  }
</style>
