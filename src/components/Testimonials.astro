---
import stimmen from '../data/kundenstimmen.json';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';

const [leitstimme, ...weitereStimmen] = stimmen;
const bewertung = settings.stats.bewertung.replace('★', '').trim();
---
<section class="testimonials" aria-labelledby="stimmen-titel">
  <div class="wrap testimonials-inner">
    <header class="testimonials-head">
      <div class="testimonials-title">
        <p class="eyebrow">Kundenstimmen</p>
        <h2 id="stimmen-titel">So wird unsere Arbeit erlebt.</h2>
      </div>

      <div class="trust-score" aria-label={`Google-Bewertung ${bewertung} von 5`}>
        <div class="trust-score__value">
          <strong>{bewertung}</strong>
          <span aria-hidden="true">★</span>
        </div>
        <p>Google-Bewertung</p>
      </div>
    </header>

    <div class="testimonial-stage">
      <figure class="testimonial testimonial--lead reveal">
        <blockquote>„{leitstimme.text}“</blockquote>
        <figcaption>
          <strong>{leitstimme.name}</strong>
          <span>{leitstimme.ort}</span>
        </figcaption>
      </figure>

      <div class="testimonial-side">
        {weitereStimmen.map((stimme, index) => (
          <figure class="testimonial testimonial--compact reveal" style={`--reveal-delay: ${(index + 1) * 55}ms`}>
            <blockquote>„{stimme.text}“</blockquote>
            <figcaption>
              <strong>{stimme.name}</strong>
              <span>{stimme.ort}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <footer class="testimonials-foot">
      <p>Saubere Ausführung, verlässliche Kommunikation und Ergebnisse, die weiterempfohlen werden.</p>
      <a href={withBase('/referenzen/')} class="reference-link">
        Referenzen ansehen <span aria-hidden="true">→</span>
      </a>
    </footer>
  </div>
</section>

<style>
  .testimonials {
    padding-block: clamp(4.25rem, 6.5vw, 6rem);
    color: var(--ink);
    background: #f5f1e9;
    border-block: 1px solid var(--line);
  }

  .testimonials-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .testimonials-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .testimonials-title h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.25rem, 3.7vw, 3.45rem);
    line-height: 1;
    letter-spacing: -.025em;
  }

  .trust-score {
    display: grid;
    justify-items: end;
    gap: .45rem;
    padding-bottom: .2rem;
  }

  .trust-score__value {
    display: flex;
    align-items: baseline;
    gap: .5rem;
  }

  .trust-score strong {
    font-family: var(--font-brand);
    font-size: clamp(2rem, 3vw, 2.65rem);
    font-weight: 600;
    line-height: .9;
    letter-spacing: -.025em;
  }

  .trust-score__value span {
    color: var(--brass-deep);
    font-size: 1rem;
  }

  .trust-score p {
    color: var(--ink-muted);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .testimonial-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(20rem, .88fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: clamp(2.5rem, 4.5vw, 4rem);
    border-top: 1px solid rgba(28,29,31,.2);
    border-bottom: 1px solid rgba(28,29,31,.14);
  }

  .testimonial {
    margin: 0;
  }

  .testimonial--lead {
    position: relative;
    display: grid;
    min-height: 19rem;
    align-content: space-between;
    gap: 2.25rem;
    padding-left: clamp(1.25rem, 2.3vw, 2rem);
  }

  .testimonial--lead::before {
    position: absolute;
    top: .2rem;
    bottom: .2rem;
    left: 0;
    width: 2px;
    background: var(--brass);
    content: '';
  }

  .testimonial--lead blockquote {
    max-width: 24ch;
    margin: 0;
    font-family: var(--font-text);
    font-size: clamp(1.55rem, 2.4vw, 2.15rem);
    font-weight: 430;
    line-height: 1.42;
    letter-spacing: -.018em;
  }

  .testimonial-side {
    display: grid;
    align-content: stretch;
  }

  .testimonial--compact {
    display: grid;
    align-content: space-between;
    gap: 1.5rem;
    padding: .2rem 0 clamp(2rem, 3vw, 2.75rem);
  }

  .testimonial--compact + .testimonial--compact {
    padding-top: clamp(2rem, 3vw, 2.75rem);
    padding-bottom: .2rem;
    border-top: 1px solid rgba(28,29,31,.12);
  }

  .testimonial--compact blockquote {
    max-width: 36ch;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-text);
    font-size: clamp(1.04rem, 1.3vw, 1.18rem);
    font-weight: 430;
    line-height: 1.62;
    letter-spacing: -.008em;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .4rem .65rem;
    color: var(--ink-soft);
    font-size: .8rem;
  }

  figcaption strong {
    color: var(--ink);
    font-weight: 600;
  }

  figcaption span::before {
    margin-right: .65rem;
    color: var(--brass);
    content: '·';
  }

  .testimonials-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
  }

  .testimonials-foot p {
    max-width: 42rem;
    color: var(--ink-soft);
    font-size: .9rem;
    line-height: 1.65;
  }

  .reference-link {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    padding-bottom: .3rem;
    border-bottom: 1px solid rgba(28,29,31,.62);
    color: var(--ink);
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap var(--dur) var(--ease-move), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .reference-link:hover {
      gap: .8rem;
      color: var(--brass-deep);
      border-color: var(--brass-deep);
    }
  }

  @media (max-width: 56rem) {
    .testimonials-head,
    .testimonial-stage {
      grid-template-columns: 1fr;
    }

    .testimonials-head {
      align-items: start;
      gap: 1.5rem;
    }

    .trust-score {
      justify-items: start;
    }

    .testimonial-stage {
      gap: 2.25rem;
    }

    .testimonial--lead {
      min-height: 0;
      padding-bottom: 2rem;
    }

    .testimonial-side {
      border-top: 1px solid rgba(28,29,31,.12);
    }

    .testimonial--compact {
      padding-top: 2rem;
    }

    .testimonial--lead blockquote,
    .testimonial--compact blockquote {
      max-width: 42rem;
    }

    .testimonials-foot {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .reference-link { width: fit-content; }
  }

  @media (max-width: 36rem) {
    .testimonials {
      padding-block: 3.75rem;
    }

    .testimonials-title h2 {
      max-width: 13ch;
      font-size: clamp(2.15rem, 9.6vw, 2.9rem);
    }

    .testimonial--lead blockquote {
      font-size: clamp(1.35rem, 6.5vw, 1.75rem);
    }
  }
</style>
