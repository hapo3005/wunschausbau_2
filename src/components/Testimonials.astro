---
const score = '5,0';
const reviewCount = '13';
const myHammerUrl = 'https://www.my-hammer.de/auftragnehmer/ks-innenausbau-3';
---
<section class="testimonials" aria-labelledby="stimmen-titel">
  <div class="wrap testimonials-inner">
    <header class="proof-head reveal">
      <div class="proof-head__label">
        <p class="eyebrow">Bewertungen</p>
        <p class="proof-head__meta">MyHammer · {reviewCount} öffentliche Bewertungen</p>
      </div>

      <div class="proof-head__statement">
        <h2 id="stimmen-titel">Vertrauen zeigt sich nicht im Versprechen.</h2>
        <p>Es zeigt sich danach.</p>
      </div>
    </header>

    <div class="proof-composition reveal" style="--reveal-delay: 55ms">
      <aside class="proof-score" aria-label={`${score} von 5 bei ${reviewCount} Bewertungen auf MyHammer`}>
        <span class="proof-score__source">MyHammer</span>
        <div class="proof-score__number">
          <strong>{score}</strong>
          <span>/ 5</span>
        </div>
        <div class="proof-score__stars" aria-hidden="true">★★★★★</div>
        <p><strong>{reviewCount} Bewertungen</strong><span>Stand · August 2026</span></p>
      </aside>

      <figure class="proof-quote">
        <span class="proof-quote__index" aria-hidden="true">Kundenstimme</span>
        <blockquote>
          „Sehr schnelle Rückmeldung und Terminvereinbarung. Zuverlässig und super Hilfe bei der Reparatur unserer Jalousien.“
        </blockquote>
        <figcaption>
          <span><strong>Öffentliche Bewertung auf MyHammer</strong> · 15. Juli 2026</span>
          <a href={myHammerUrl} target="_blank" rel="noopener noreferrer">
            Alle Bewertungen <span aria-hidden="true">↗</span>
          </a>
        </figcaption>
      </figure>
    </div>

    <div class="proof-foot reveal" style="--reveal-delay: 90ms">
      <p class="proof-foot__lead">Was dabei zählt</p>
      <div class="proof-principles" aria-label="Unser Anspruch in der Zusammenarbeit">
        <p><strong>Persönlich</strong><span>Direkte Abstimmung.</span></p>
        <p><strong>Nachvollziehbar</strong><span>Details vor Beginn geklärt.</span></p>
        <p><strong>Sauber</strong><span>Ausführung und Übergabe mit Anspruch.</span></p>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonials {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 7vw, 7.25rem);
    color: var(--ink);
    background: #f3eee5;
    border-block: 1px solid var(--line);
  }

  .testimonials-inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 4.8vw, 4.5rem);
  }

  .proof-head {
    display: grid;
    grid-template-columns: minmax(14rem, .55fr) minmax(0, 1.45fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .proof-head__label {
    display: grid;
    gap: .85rem;
    padding-bottom: .45rem;
  }

  .testimonials .eyebrow {
    margin: 0;
    color: var(--brass-deep);
  }

  .proof-head__meta {
    margin: 0;
    color: var(--ink-muted);
    font-size: .72rem;
    line-height: 1.45;
  }

  .proof-head__statement {
    display: grid;
    grid-template-columns:minmax(0,1fr) auto;
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid rgba(28,29,31,.18);
    padding-bottom: clamp(1.2rem, 2vw, 1.7rem);
  }

  .proof-head h2 {
    max-width: 16ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.25rem, 3.6vw, 3.4rem);
    font-weight: 600;
    line-height: .98;
    letter-spacing: -.038em;
    text-wrap: balance;
  }

  .proof-head__statement > p {
    margin: 0 0 .15rem;
    color: var(--brass-deep);
    font-family: var(--font-brand);
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    font-weight: 600;
    white-space: nowrap;
  }

  .proof-composition {
    position: relative;
    display: grid;
    grid-template-columns:minmax(18rem,.72fr) minmax(0,1.28fr);
    align-items: stretch;
    min-height: clamp(25rem, 34vw, 32rem);
  }

  .proof-composition::before {
    position:absolute;
    top:0;
    bottom:0;
    left:calc(36% - 1px);
    width:1px;
    background:rgba(28,29,31,.12);
    content:"";
    pointer-events:none;
  }

  .proof-score {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-rows:auto 1fr auto;
    align-items:start;
    min-width:0;
    padding:clamp(1.2rem,2vw,1.7rem) clamp(2rem,4vw,4.25rem) clamp(1.7rem,2.7vw,2.5rem) 0;
  }

  .proof-score__source {
    color:var(--brass-deep);
    font-size:.66rem;
    font-weight:680;
    letter-spacing:.14em;
    text-transform:uppercase;
  }

  .proof-score__number {
    display:flex;
    align-self:center;
    align-items:baseline;
    gap:.55rem;
    margin-left:-.32rem;
    padding-block:1rem;
  }

  .proof-score__number strong {
    color:var(--ink);
    font-family:var(--font-brand);
    font-size:clamp(6.2rem,11vw,10.5rem);
    font-weight:500;
    line-height:.72;
    letter-spacing:-.075em;
  }

  .proof-score__number span {
    color:var(--ink-muted);
    font-size:.9rem;
  }

  .proof-score__stars {
    position:absolute;
    right:clamp(2rem,4vw,4.25rem);
    bottom:2.35rem;
    color:var(--brass);
    font-size:.72rem;
    letter-spacing:.18em;
  }

  .proof-score > p {
    display:grid;
    gap:.25rem;
    align-self:end;
    margin:0;
    padding-top:1.1rem;
    border-top:1px solid rgba(28,29,31,.14);
  }

  .proof-score > p strong {
    color:var(--ink);
    font-size:.82rem;
    font-weight:620;
  }

  .proof-score > p span {
    color:var(--ink-muted);
    font-size:.68rem;
  }

  .proof-quote {
    position:relative;
    z-index:2;
    display:grid;
    grid-template-rows:auto 1fr auto;
    align-items:start;
    min-width:0;
    margin:clamp(2.1rem,4vw,3.7rem) 0 0 clamp(-2rem,-2vw,-1rem);
    padding:clamp(2.2rem,4.2vw,4rem) clamp(2rem,4.5vw,4.5rem) clamp(2rem,3.5vw,3.25rem);
    color:#f6f1e8;
    background:#1b1c1e;
    box-shadow:0 1.6rem 4.2rem rgba(18,18,18,.12);
  }

  .proof-quote::before {
    position:absolute;
    top:0;
    left:0;
    width:.3rem;
    height:5.5rem;
    background:var(--brass);
    content:"";
  }

  .proof-quote__index {
    color:#d7b06b;
    font-size:.65rem;
    font-weight:650;
    letter-spacing:.13em;
    text-transform:uppercase;
  }

  .proof-quote blockquote {
    align-self:center;
    max-width:27ch;
    margin:clamp(1.8rem,3vw,2.6rem) 0;
    color:#fffdf9;
    font-family:var(--font-brand);
    font-size:clamp(1.75rem,2.75vw,2.55rem);
    font-weight:500;
    line-height:1.12;
    letter-spacing:-.028em;
  }

  .proof-quote figcaption {
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:1.5rem;
    padding-top:1.25rem;
    border-top:1px solid rgba(255,255,255,.14);
    color:rgba(246,241,232,.62);
    font-size:.7rem;
    line-height:1.45;
  }

  .proof-quote figcaption strong {
    color:#d7b06b;
    font-weight:620;
  }

  .proof-quote a {
    display:inline-flex;
    flex:0 0 auto;
    align-items:center;
    gap:.45rem;
    padding-bottom:.18rem;
    color:#fffdf9;
    border-bottom:1px solid rgba(255,255,255,.34);
    font-size:.72rem;
    font-weight:620;
    text-decoration:none;
    transition:gap var(--dur) var(--ease-move),border-color var(--dur) var(--ease),color var(--dur) var(--ease);
  }

  .proof-foot {
    display:grid;
    grid-template-columns:minmax(14rem,.55fr) minmax(0,1.45fr);
    align-items:start;
    gap:clamp(2rem,6vw,6rem);
  }

  .proof-foot__lead {
    margin:0;
    color:var(--brass-deep);
    font-size:.69rem;
    font-weight:650;
    letter-spacing:.12em;
    text-transform:uppercase;
  }

  .proof-principles {
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:clamp(1rem,3vw,3rem);
  }

  .proof-principles p {
    display:grid;
    gap:.35rem;
    margin:0;
    padding-top:.9rem;
    border-top:1px solid rgba(28,29,31,.14);
  }

  .proof-principles strong {
    color:var(--ink);
    font-size:.88rem;
    font-weight:620;
  }

  .proof-principles span {
    color:var(--ink-soft);
    font-size:.74rem;
    line-height:1.5;
  }

  @media (hover:hover) and (pointer:fine) {
    .proof-quote a:hover {
      gap:.65rem;
      color:#d7b06b;
      border-color:#d7b06b;
    }
  }

  @media (max-width:56rem) {
    .testimonials { padding-block:4.25rem; }
    .testimonials-inner { gap:2.4rem; }

    .proof-head,
    .proof-foot {
      grid-template-columns:1fr;
      gap:1.3rem;
    }

    .proof-head__statement {
      grid-template-columns:1fr;
      gap:.8rem;
    }

    .proof-head__statement > p { white-space:normal; }

    .proof-composition {
      grid-template-columns:minmax(13rem,.66fr) minmax(0,1.34fr);
      min-height:24rem;
    }

    .proof-composition::before { left:33%; }

    .proof-score {
      padding-right:2rem;
    }

    .proof-score__number strong { font-size:clamp(5rem,12vw,7.2rem); }
    .proof-score__stars { right:2rem; }

    .proof-quote {
      margin-left:-1rem;
      padding-inline:clamp(1.75rem,4vw,3rem);
    }

    .proof-quote blockquote { font-size:clamp(1.55rem,3.7vw,2rem); }
  }

  @media (max-width:40rem) {
    .testimonials { padding-block:3.4rem; }
    .testimonials-inner { gap:1.85rem; }

    .proof-head__label { gap:.55rem; }

    .proof-head h2 {
      max-width:12ch;
      font-size:clamp(2.05rem,9vw,2.6rem);
      line-height:.98;
    }

    .proof-head__statement > p { font-size:1rem; }

    .proof-composition {
      display:grid;
      grid-template-columns:1fr;
      min-height:0;
    }

    .proof-composition::before { display:none; }

    .proof-score {
      min-height:11.8rem;
      padding:1.1rem 0 1.5rem;
    }

    .proof-score__number {
      margin-left:-.15rem;
      padding-block:.8rem;
    }

    .proof-score__number strong { font-size:clamp(4.7rem,22vw,6rem); }

    .proof-score__stars {
      right:0;
      bottom:1.62rem;
    }

    .proof-score > p { max-width:11rem; }

    .proof-quote {
      margin:0;
      padding:1.65rem 1.35rem 1.5rem;
      box-shadow:none;
    }

    .proof-quote::before { width:.22rem; height:4rem; }

    .proof-quote blockquote {
      max-width:100%;
      margin:1.35rem 0 1.5rem;
      font-size:clamp(1.35rem,6.5vw,1.72rem);
      line-height:1.14;
    }

    .proof-quote figcaption {
      display:grid;
      gap:.9rem;
      align-items:start;
    }

    .proof-quote a { width:fit-content; }

    .proof-principles {
      grid-template-columns:1fr;
      gap:.75rem;
    }

    .proof-principles p {
      grid-template-columns:7.5rem 1fr;
      align-items:baseline;
      gap:.65rem;
      padding-top:.7rem;
    }
  }

  @media (prefers-reduced-motion:reduce) {
    .proof-quote a { transition:none; }
  }
</style>
