---
import { Image } from 'astro:assets';
import stimmen from '../data/kundenstimmen.json';
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import proofImage from '../assets/service-interior.png';

const [leitstimme, ...weitereStimmen] = stimmen;
const bewertung = settings.stats.bewertung.replace('★', '').trim();
---
<section class="testimonials" aria-labelledby="stimmen-titel">
  <div class="wrap testimonials-inner">
    <header class="proof-head">
      <div>
        <p class="eyebrow">Kundenstimmen</p>
        <h2 id="stimmen-titel">Räume, die überzeugen. Arbeit, die weiterempfohlen wird.</h2>
      </div>

      <div class="proof-score" aria-label={`Google-Bewertung ${bewertung} von 5`}>
        <strong>{bewertung}</strong>
        <span aria-hidden="true">★</span>
        <small>Google-Bewertung</small>
      </div>
    </header>

    <div class="proof-visual">
      <div class="proof-image">
        <Image
          src={proofImage}
          alt="Hochwertig ausgeführter Wohnraum mit maßgefertigter Holzvertäfelung und Einbauregal"
          widths={[720, 1080, 1600]}
          sizes="(max-width: 56rem) 100vw, 72vw"
          quality={84}
          format="webp"
        />
        <div class="proof-caption">
          <span>Innenausbau & Renovierung</span>
          <strong>Wittlich · Trier · Mosel</strong>
        </div>
      </div>

      <figure class="featured-review reveal">
        <p class="review-label">Aus Kundensicht</p>
        <blockquote>„{leitstimme.text}“</blockquote>
        <figcaption>
          <strong>{leitstimme.name}</strong>
          <span>{leitstimme.ort}</span>
        </figcaption>
        <a href={withBase('/referenzen/')} class="reference-link">
          Arbeiten ansehen <span aria-hidden="true">→</span>
        </a>
      </figure>
    </div>

    <div class="review-strip" aria-label="Weitere Kundenstimmen">
      {weitereStimmen.map((stimme, index) => (
        <figure class="supporting-review reveal" style={`--reveal-delay: ${(index + 1) * 55}ms`}>
          <blockquote>„{stimme.text}“</blockquote>
          <figcaption>
            <strong>{stimme.name}</strong>
            <span>{stimme.ort}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-block: clamp(4rem, 6vw, 5.75rem);
    color: var(--ink);
    background: var(--paper);
    border-block: 1px solid var(--line);
  }

  .testimonials-inner {
    display: grid;
    gap: clamp(2.4rem, 4.5vw, 3.75rem);
  }

  .proof-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .proof-head h2 {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(2rem, 3.2vw, 3rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -.022em;
  }

  .proof-score {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    justify-content: end;
    column-gap: .45rem;
    padding-bottom: .2rem;
  }

  .proof-score strong {
    font-family: var(--font-brand);
    font-size: clamp(2rem, 3vw, 2.65rem);
    font-weight: 600;
    line-height: .9;
    letter-spacing: -.025em;
  }

  .proof-score > span {
    color: var(--brass-deep);
    font-size: .95rem;
  }

  .proof-score small {
    grid-column: 1 / -1;
    margin-top: .55rem;
    color: var(--ink-muted);
    font-size: .66rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .proof-visual {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 25rem);
    align-items: center;
    min-height: clamp(29rem, 45vw, 38rem);
  }

  .proof-image {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 1;
    min-height: clamp(29rem, 45vw, 38rem);
    overflow: hidden;
    background: var(--sand-deep);
  }

  .proof-image :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
    filter: saturate(.99) contrast(1.01) brightness(1.025);
  }

  .proof-image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 66%, rgba(20,20,20,.24));
    content: '';
    pointer-events: none;
  }

  .proof-caption {
    position: absolute;
    z-index: 2;
    right: clamp(1.25rem, 2.2vw, 2rem);
    bottom: clamp(1.1rem, 2.2vw, 1.75rem);
    left: clamp(1.25rem, 2.2vw, 2rem);
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    color: #fff;
    text-shadow: 0 1px 14px rgba(0,0,0,.2);
  }

  .proof-caption span {
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .proof-caption strong {
    font-size: .8rem;
    font-weight: 600;
  }

  .featured-review {
    position: relative;
    z-index: 3;
    grid-column: 2;
    grid-row: 1;
    display: grid;
    align-content: center;
    gap: 1.5rem;
    min-height: clamp(22rem, 32vw, 29rem);
    margin: 0 clamp(1.25rem, 2.7vw, 2.5rem) 0 0;
    padding: clamp(2rem, 3.8vw, 3.4rem);
    color: var(--ink);
    background: rgba(253,252,249,.965);
    border: 1px solid rgba(255,255,255,.72);
    box-shadow: 0 1.5rem 4rem rgba(20,20,20,.14);
    backdrop-filter: blur(14px);
  }

  .review-label {
    width: fit-content;
    padding-top: .7rem;
    border-top: 1px solid var(--brass);
    color: var(--brass-deep);
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .featured-review blockquote {
    max-width: 22ch;
    margin: 0;
    font-family: var(--font-text);
    font-size: clamp(1.35rem, 1.9vw, 1.78rem);
    font-weight: 430;
    line-height: 1.46;
    letter-spacing: -.014em;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .4rem .65rem;
    color: var(--ink-soft);
    font-size: .78rem;
  }

  figcaption strong {
    color: var(--ink);
    font-weight: 600;
  }

  figcaption span::before {
    margin-right: .65rem;
    color: var(--brass);
    content: '·';
  }

  .reference-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .55rem;
    margin-top: .25rem;
    padding-bottom: .28rem;
    border-bottom: 1px solid rgba(28,29,31,.55);
    color: var(--ink);
    font-size: .86rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap var(--dur) var(--ease-move), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .review-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .supporting-review {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.25rem 2rem;
    margin: 0;
    padding-top: 1.55rem;
    border-top: 1px solid rgba(28,29,31,.17);
  }

  .supporting-review blockquote {
    max-width: 38ch;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-text);
    font-size: clamp(.98rem, 1.1vw, 1.08rem);
    font-weight: 430;
    line-height: 1.58;
    letter-spacing: -.005em;
  }

  .supporting-review figcaption {
    justify-content: end;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .reference-link:hover {
      gap: .8rem;
      color: var(--brass-deep);
      border-color: var(--brass-deep);
    }
  }

  @media (max-width: 64rem) {
    .featured-review {
      margin-right: 1.25rem;
    }

    .supporting-review {
      grid-template-columns: 1fr;
    }

    .supporting-review figcaption {
      justify-content: start;
    }
  }

  @media (max-width: 56rem) {
    .proof-head {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.4rem;
    }

    .proof-score {
      justify-content: start;
    }

    .proof-visual {
      display: grid;
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 0;
    }

    .proof-image,
    .featured-review {
      grid-column: 1;
      grid-row: auto;
    }

    .proof-image {
      min-height: clamp(20rem, 60vw, 28rem);
    }

    .featured-review {
      min-height: 0;
      margin: 0;
      padding: 2.1rem;
      border-top: 0;
      box-shadow: none;
      backdrop-filter: none;
    }

    .featured-review blockquote {
      max-width: 32ch;
    }
  }

  @media (max-width: 40rem) {
    .review-strip {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .proof-caption {
      display: grid;
      justify-content: start;
      gap: .3rem;
    }
  }

  @media (max-width: 36rem) {
    .testimonials {
      padding-block: 3.6rem;
    }

    .proof-head h2 {
      max-width: 18ch;
      font-size: clamp(1.95rem, 8.8vw, 2.65rem);
    }

    .featured-review {
      padding: 1.75rem 1.5rem;
    }

    .featured-review blockquote {
      font-size: clamp(1.2rem, 5.8vw, 1.5rem);
    }
  }
</style>
