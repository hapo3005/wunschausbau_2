---
const steps = [
  {
    title: 'Beratung & Aufmaß',
    text: 'Wir klären Wünsche und Bestand vor Ort, nehmen sauber Maß und besprechen Materialien, Möglichkeiten und sinnvolle Lösungen.'
  },
  {
    title: 'Planung & Abstimmung',
    text: 'Details, Materialwahl und Ablauf werden vor Beginn nachvollziehbar abgestimmt, damit Entscheidungen nicht erst auf der Baustelle entstehen.'
  },
  {
    title: 'Ausführung & Übergabe',
    text: 'Wir arbeiten präzise und ordentlich, halten Absprachen im Blick und übergeben das Ergebnis sauber und gemeinsam mit Ihnen.'
  }
];
---
<div class="process">
  {steps.map((step, index) => (
    <article class="reveal" style={`--reveal-delay: ${index * 55}ms`}>
      <h3>{step.title}</h3>
      <p>{step.text}</p>
    </article>
  ))}
</div>

<style>
  .process {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
  }

  article {
    min-width: 0;
    padding: clamp(2rem, 4vw, 3rem) clamp(2rem, 4vw, 3.25rem) 0 0;
  }

  article:not(:first-child) {
    padding-left: clamp(2rem, 4vw, 3.25rem);
    border-left: 1px solid var(--line);
  }

  h3 {
    margin-bottom: 1rem;
    font-size: clamp(1.5rem, 2vw, 1.85rem);
  }

  p {
    max-width: 25rem;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  @media (max-width: 56rem) {
    .process { grid-template-columns: 1fr; }

    article,
    article:not(:first-child) {
      padding: 1.9rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }

    p { max-width: 38rem; }
  }
</style>
