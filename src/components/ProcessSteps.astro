---
const steps = [
  { title: 'Beratung', text: 'Wir hören zu, verstehen Ihre Wünsche und beraten ehrlich zu Möglichkeiten, Materialien und Aufwand.' },
  { title: 'Planung', text: 'Wir nehmen Maß, stimmen Details ab und planen Ihr Projekt sauber, realistisch und nachvollziehbar.' },
  { title: 'Umsetzung', text: 'Wir setzen Ihr Projekt termintreu, ordentlich und mit hohem handwerklichem Anspruch um.' }
];
---
<div class="process">
  {steps.map((step, index) => (
    <article class="reveal" style={`--reveal-delay: ${index * 70}ms`}>
      <div class="step-copy">
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .process {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }

  article {
    position: relative;
    min-width: 0;
    min-height: clamp(14rem, 21vw, 18rem);
    padding: clamp(2rem, 4vw, 3.25rem) clamp(2rem, 4vw, 3.5rem) clamp(2.25rem, 4vw, 3.5rem) 0;
    border-right: 1px solid var(--line);
  }

  article:not(:first-child) { padding-left: clamp(2rem, 4vw, 3.5rem); }
  article:last-child { padding-right: 0; border-right: 0; }

  article::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: clamp(3rem, 5vw, 4.5rem);
    height: 2px;
    background: var(--brass);
    content: "";
  }

  article:not(:first-child)::before { left: clamp(2rem, 4vw, 3.5rem); }

  .step-copy {
    display: grid;
    max-width: 22rem;
    gap: 1rem;
  }

  h3 {
    font-size: clamp(1.7rem, 2.5vw, 2.15rem);
  }

  p {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  @media (max-width: 56rem) {
    .process {
      grid-template-columns: 1fr;
      border-bottom: 0;
    }

    article,
    article:not(:first-child),
    article:last-child {
      min-height: 0;
      padding: 2rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    article:not(:first-child)::before,
    article::before { left: 0; }

    .step-copy { max-width: 36rem; }
  }
</style>
