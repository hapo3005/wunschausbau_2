---
import settings from '../data/settings.json';
import { withBase } from '../lib/paths';
import { getLocalizedPath, sharedCopy, type Locale } from '../lib/i18n';

interface Props { lang?: Locale; }
const { lang = 'de' } = Astro.props;
const copy = sharedCopy[lang].mobile;
const isContactPage = Astro.url.pathname.includes('/kontakt') || Astro.url.pathname.includes('/en/contact');
const localizedContact = withBase(getLocalizedPath('/kontakt/', lang));
---
{!isContactPage && (
  <div
    class="mobile-cta"
    role="region"
    aria-label={copy.quickContact}
    aria-hidden="true"
    data-phone={`tel:${settings.telefonLink}`}
    data-contact={localizedContact}
    data-lang={lang}
    data-label-desktop={copy.desktopAppointment}
    data-label-mobile={copy.mobileAppointment}
    data-label-secondary={copy.secondaryAppointment}
    data-label-work={copy.work}
  >
    <a class="btn" href={`tel:${settings.telefonLink}`} aria-label={`${copy.call}: ${settings.telefon}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7.1 2.8 10 7.9 7.7 10a15.1 15.1 0 0 0 6.3 6.3l2.1-2.3 5.1 2.9-.7 3.3c-.2.8-.9 1.4-1.8 1.4A16.4 16.4 0 0 1 2.4 5.3c0-.9.6-1.6 1.4-1.8l3.3-.7Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
      </svg>
      <span>{copy.call}</span>
    </a>
    <a class="btn btn--ghost" href={settings.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={copy.whatsapp}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.8c2.16 0 4.19.84 5.72 2.37a8.06 8.06 0 0 1 2.37 5.72c0 4.47-3.64 8.11-8.11 8.11a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.12.82.83-3.04-.19-.31a8.05 8.05 0 0 1-1.24-4.3c0-4.47 3.64-8.11 8.11-8.11Zm-3.2 4.03c-.15 0-.4.06-.61.29-.21.23-.8.79-.8 1.92 0 1.13.82 2.22.94 2.38.11.15 1.6 2.55 3.95 3.48.55.24.98.38 1.32.49.55.18 1.06.15 1.46.09.44-.07 1.36-.56 1.55-1.09.19-.53.19-.99.14-1.09-.06-.09-.21-.15-.44-.26-.23-.11-1.36-.67-1.57-.75-.21-.08-.36-.11-.52.12-.15.23-.59.75-.72.9-.13.15-.27.17-.5.06-.23-.12-.97-.36-1.85-1.14-.68-.61-1.14-1.36-1.28-1.59-.13-.23-.01-.35.1-.47.1-.1.23-.27.34-.4.11-.13.15-.23.23-.38.08-.15.04-.29-.02-.4-.06-.12-.52-1.26-.72-1.72-.19-.45-.38-.39-.52-.4-.13-.01-.29-.01-.44-.01Z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>
)}

<style>
  .mobile-cta { display: none; }

  :global(.ks-hero .ks-button--phone) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .68rem;
  }

  :global(.ks-hero .ks-button--phone svg) {
    width: 1.08rem;
    height: 1.08rem;
    flex: 0 0 auto;
  }

  :global(.ks-hero .ks-button__label--mobile) { display: none; }

  @media (max-width: 56rem) {
    .mobile-cta {
      position: fixed;
      right: auto;
      bottom: max(.45rem, env(safe-area-inset-bottom));
      left: 50%;
      z-index: 90;
      display: grid;
      width: min(calc(100% - 1.4rem), 18.75rem);
      grid-template-columns: 1fr 1fr;
      gap: .24rem;
      padding: .24rem;
      background: #fdfcf9;
      border: 1px solid rgba(28,29,31,.13);
      border-radius: .42rem;
      box-shadow: 0 .45rem 1.35rem rgba(23,24,27,.11);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(-50%);
      transition: opacity 160ms ease, visibility 0s linear 160ms;
      contain: layout paint;
    }

    .mobile-cta.is-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }

    .mobile-cta .btn {
      min-height: 2.75rem;
      gap: .42rem;
      padding: .48rem .64rem;
      border-radius: .24rem;
      font-size: .82rem;
      font-weight: 650;
      box-shadow: none;
    }

    .mobile-cta .btn svg {
      width: .96rem;
      height: .96rem;
      flex: 0 0 auto;
    }

    :global(.ks-hero .ks-button--phone),
    :global(.ks-hero .ks-secondary-cta--button) {
      flex: 1 1 0;
      min-width: 0;
      min-height: 3.45rem;
      align-items: center;
      justify-content: center;
      gap: .46rem;
      padding: .76rem .5rem !important;
      color: var(--ink) !important;
      background: #f8f5ee !important;
      border: 1px solid #f8f5ee !important;
      font-size: clamp(.76rem, 3.15vw, .86rem);
      font-weight: 620;
      line-height: 1.2;
      text-decoration: none;
      white-space: nowrap;
      box-shadow: none;
    }

    :global(.ks-hero .ks-secondary-cta--button) {
      display: inline-flex;
      width: auto;
    }

    :global(.ks-hero .ks-secondary-cta--button svg) {
      width: 1.05rem;
      height: 1.05rem;
      flex: 0 0 auto;
    }

    :global(.ks-hero .ks-button__label--desktop) { display: none; }
    :global(.ks-hero .ks-button__label--mobile) { display: inline; }
  }

  @media (max-width: 22rem) {
    .mobile-cta { width: calc(100% - 1rem); }
    .mobile-cta .btn { padding-inline: .5rem; }
    .mobile-cta .btn span { font-size: .78rem; }

    :global(.ks-hero .ks-button--phone),
    :global(.ks-hero .ks-secondary-cta--button) {
      gap: .35rem;
      padding-inline: .35rem !important;
      font-size: .72rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-cta { transition: none; }
  }
</style>

<script>
  const dock = document.querySelector('.mobile-cta');

  if (dock) {
    const heroCta = document.querySelector('.ks-hero .ks-button');
    const heroSecondary = document.querySelector('.ks-hero .ks-textlink');
    const phoneHref = dock.getAttribute('data-phone');
    const contactHref = dock.getAttribute('data-contact');
    const labelDesktop = dock.getAttribute('data-label-desktop') || 'Book an appointment';
    const labelMobile = dock.getAttribute('data-label-mobile') || 'Call now';
    const labelSecondary = dock.getAttribute('data-label-secondary') || 'Book an appointment';
    const labelWork = dock.getAttribute('data-label-work') || 'View our work';
    const mobile = window.matchMedia('(max-width: 56rem)');
    const workHref = heroSecondary instanceof HTMLAnchorElement ? heroSecondary.href : null;

    if (heroCta instanceof HTMLAnchorElement && phoneHref) {
      heroCta.href = phoneHref;
      heroCta.classList.add('ks-button--phone');
      heroCta.setAttribute('aria-label', labelDesktop);
      heroCta.innerHTML = `
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M7.1 2.8 10 7.9 7.7 10a15.1 15.1 0 0 0 6.3 6.3l2.1-2.3 5.1 2.9-.7 3.3c-.2.8-.9 1.4-1.8 1.4A16.4 16.4 0 0 1 2.4 5.3c0-.9.6-1.6 1.4-1.8l3.3-.7Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
        </svg>
        <span class="ks-button__label--desktop">${labelDesktop}</span>
        <span class="ks-button__label--mobile">${labelMobile}</span>
      `;
    }

    const syncHeroSecondary = () => {
      if (!(heroSecondary instanceof HTMLAnchorElement)) return;

      if (mobile.matches) {
        if (contactHref) heroSecondary.href = contactHref;
        heroSecondary.classList.add('ks-secondary-cta--button');
        heroSecondary.setAttribute('aria-label', labelSecondary);
        heroSecondary.innerHTML = `
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7 3.5v3M17 3.5v3M4 9h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm2 8h3v3H8v-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.65"/>
          </svg>
          <span>${labelSecondary}</span>
        `;
      } else {
        if (workHref) heroSecondary.href = workHref;
        heroSecondary.classList.remove('ks-secondary-cta--button');
        heroSecondary.removeAttribute('aria-label');
        heroSecondary.innerHTML = `${labelWork} <span aria-hidden="true">→</span>`;
      }
    };

    const links = [...dock.querySelectorAll('a')];
    let blocked = false;
    let currentShow = null;
    let frame = 0;

    const setFocusable = (enabled) => {
      links.forEach((link) => {
        if (enabled) link.removeAttribute('tabindex');
        else link.setAttribute('tabindex', '-1');
      });
    };

    const applyState = () => {
      frame = 0;
      const navOpen = document.body.classList.contains('nav-open');
      const show = mobile.matches && window.scrollY > 320 && !blocked && !navOpen;

      if (show === currentShow) return;
      currentShow = show;
      dock.classList.toggle('is-visible', show);
      dock.setAttribute('aria-hidden', String(!show));
      setFocusable(show);
    };

    const scheduleUpdate = () => {
      if (frame) return;
      frame = requestAnimationFrame(applyState);
    };

    const blockers = document.querySelectorAll('.cta-section, .site-footer');
    if ('IntersectionObserver' in window && blockers.length) {
      const visible = new Set();
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        });
        blocked = visible.size > 0;
        scheduleUpdate();
      }, { threshold: 0.02 });
      blockers.forEach((target) => observer.observe(target));
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    mobile.addEventListener('change', () => {
      syncHeroSecondary();
      scheduleUpdate();
    });
    new MutationObserver(scheduleUpdate).observe(document.body, { attributes: true, attributeFilter: ['class'] });
    setFocusable(false);
    syncHeroSecondary();
    applyState();
  }
</script>
