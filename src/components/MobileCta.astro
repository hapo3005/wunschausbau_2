---
import settings from '../data/settings.json';
const isContactPage = Astro.url.pathname.includes('/kontakt');
---
{!isContactPage && (
  <div class="mobile-cta" role="region" aria-label="Schnellkontakt" aria-hidden="true">
    <a class="btn" href={`tel:${settings.telefonLink}`} aria-label={`Anrufen: ${settings.telefon}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7.1 2.8 10 7.9 7.7 10a15.1 15.1 0 0 0 6.3 6.3l2.1-2.3 5.1 2.9-.7 3.3c-.2.8-.9 1.4-1.8 1.4A16.4 16.4 0 0 1 2.4 5.3c0-.9.6-1.6 1.4-1.8l3.3-.7Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
      </svg>
      <span>Anrufen</span>
    </a>
    <a class="btn btn--ghost" href={settings.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp-Nachricht schreiben">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.004c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.8c2.16 0 4.19.84 5.72 2.37a8.06 8.06 0 0 1 2.37 5.72c0 4.47-3.64 8.11-8.11 8.11a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.12.82.83-3.04-.19-.31a8.05 8.05 0 0 1-1.24-4.3c0-4.47 3.64-8.11 8.11-8.11Zm-3.2 4.03c-.15 0-.4.06-.61.29-.21.23-.8.79-.8 1.92 0 1.13.82 2.22.94 2.38.11.15 1.6 2.55 3.95 3.48.55.24.98.38 1.32.49.55.18 1.06.15 1.46.09.44-.07 1.36-.56 1.55-1.09.19-.53.19-.99.14-1.09-.06-.09-.21-.15-.44-.26-.23-.11-1.36-.67-1.57-.75-.21-.08-.36-.11-.52.12-.15.23-.59.75-.72.9-.13.15-.27.17-.5.06-.23-.12-.97-.36-1.85-1.14-.68-.61-1.14-1.36-1.28-1.59-.13-.23-.01-.35.1-.47.1-.1.23-.27.34-.4.11-.13.15-.23.23-.38.08-.15.04-.29-.02-.4-.06-.12-.52-1.26-.72-1.72-.19-.45-.38-.39-.52-.4-.13-.01-.29-.01-.44-.01Z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>
)}

<style>
  .mobile-cta { display: none; }

  @media (max-width: 56rem) {
    .mobile-cta {
      position: fixed;
      right: max(.7rem, env(safe-area-inset-right));
      bottom: max(.55rem, env(safe-area-inset-bottom));
      left: max(.7rem, env(safe-area-inset-left));
      z-index: 90;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: .4rem;
      padding: .35rem;
      background: rgba(253, 252, 249, .94);
      border: 1px solid rgba(28,29,31,.14);
      box-shadow: 0 .65rem 2rem rgba(23,24,27,.14);
      backdrop-filter: blur(14px) saturate(125%);
      opacity: 0;
      pointer-events: none;
      transform: translateY(calc(100% + 1rem));
      transition: opacity 180ms ease, transform 240ms var(--ease-move);
    }

    .mobile-cta.is-visible {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .mobile-cta .btn {
      min-height: 3rem;
      gap: .48rem;
      padding: .62rem .75rem;
      font-size: .88rem;
      box-shadow: none;
    }

    .mobile-cta .btn svg {
      width: 1.05rem;
      height: 1.05rem;
      flex: 0 0 auto;
    }
  }

  @media (max-width: 22rem) {
    .mobile-cta .btn span { font-size: .8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-cta { transition: none; }
  }
</style>

<script>
  const dock = document.querySelector('.mobile-cta');

  if (dock) {
    const mobile = window.matchMedia('(max-width: 56rem)');
    const links = [...dock.querySelectorAll('a')];
    let blocked = false;

    const setFocusable = (enabled) => {
      links.forEach((link) => {
        if (enabled) link.removeAttribute('tabindex');
        else link.setAttribute('tabindex', '-1');
      });
    };

    const update = () => {
      const navOpen = document.body.classList.contains('nav-open');
      const show = mobile.matches && window.scrollY > 320 && !blocked && !navOpen;
      dock.classList.toggle('is-visible', show);
      dock.setAttribute('aria-hidden', String(!show));
      setFocusable(show);
    };

    const blockers = document.querySelectorAll('.cta-section, .site-footer');
    if ('IntersectionObserver' in window && blockers.length) {
      const visible = new Set();
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        });
        blocked = visible.size > 0;
        update();
      }, { threshold: 0.02 });
      blockers.forEach((target) => observer.observe(target));
    }

    window.addEventListener('scroll', update, { passive: true });
    mobile.addEventListener('change', update);
    new MutationObserver(update).observe(document.body, { attributes: true, attributeFilter: ['class'] });
    setFocusable(false);
    update();
  }
</script>
