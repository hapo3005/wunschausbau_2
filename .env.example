# Netlify / Anfrageformular
# Keine echten Zugangsdaten in Git committen.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example-user
SMTP_PASS=replace-me

# Zieladresse für neue Projektanfragen
MAIL_TO=kontakt@wunschausbau.de

# Absender muss zum verwendeten SMTP-Konto/Provider passen
MAIL_FROM="KS-Innenausbau <kontakt@wunschausbau.de>"
